module

public import Colib.Util.References
public import StacksFrontier.AlgebraicGeometry.Picard.DivisorsOnSmoothCurves
public import StacksFrontier.AlgebraicGeometry.Divisors.RegularImmersion.LocallyPrincipalFibre
public import StacksFrontier.AlgebraicGeometry.Divisors.ZeroSchemeProperties

/-!
# Finite zero schemes on smooth relative curves

On a smooth relative curve, a locally principal closed subscheme that is locally quasi-finite
is automatically a relative effective Cartier divisor. The fibres are discrete closed
subschemes of smooth curves over fields. Their supported stalk ideals are nonzero ideals in
discrete valuation rings, hence generated by nonzerodivisors. The native fibre criterion then
proves both regularity and flatness over the original base.

The base need not be reduced, noetherian or a field, and the fibres need not be integral or
connected. The zero scheme is the original scheme-theoretic one, with all multiplicities.
The fibre argument is adapted from the pinned Stacks implementation of Tag 0B9D in
`Picard/DivisorsOnSmoothCurves.lean`; local principality replaces its assumed flatness through
Tag 062Y.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Stacks.Divisors

universe u

namespace AlgebraicGeometry

/-- A locally quasi-finite closed subscheme of a smooth relative curve is Cartier on every
fibre. No relative flatness of the closed subscheme is assumed. -/
theorem isEffectiveCartierDivisor_comap_fiberι_of_locallyQuasiFinite
    {X S : Scheme.{u}} (f : X ⟶ S) [SmoothOfRelativeDimension 1 f]
    (I : X.IdealSheafData) [LocallyQuasiFinite (I.subschemeι ≫ f)] (t : S) :
    IsEffectiveCartierDivisor (I.comap (f.fiberι t)) := by
  have : Smooth f := SmoothOfRelativeDimension.smooth 1 f
  have hsmooth : SmoothOfRelativeDimension 1 (f.fiberToSpecResidueField t) :=
    (smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
      (IsPullback.of_hasPullback f (S.fromSpecResidueField t)) inferInstance
  have hsmooth' : Smooth (f.fiberToSpecResidueField t) :=
    SmoothOfRelativeDimension.smooth 1 (f.fiberToSpecResidueField t)
  have hft : LocallyOfFiniteType (f.fiberToSpecResidueField t) :=
    inferInstanceAs (LocallyOfFiniteType (pullback.snd f (S.fromSpecResidueField t)))
  have : IsLocallyNoetherian (f.fiber t) :=
    LocallyOfFiniteType.isLocallyNoetherian (f.fiberToSpecResidueField t)
  have hregular (x : f.fiber t) : IsRegularLocalRing ((f.fiber t).presheaf.stalk x) :=
    IsRegular.isRegularLocalRing_stalk
      (@isRegular_of_smooth_over_field (IsLocalRing.ResidueField (S.presheaf.stalk t))
        inferInstance (f.fiber t) (f.fiberToSpecResidueField t) hsmooth') x
  have : DiscreteTopology (I.comap (f.fiberι t)).subscheme :=
    Scheme.IdealSheafData.discreteTopology_subscheme_comap_fiberι f I t
  have hdim (x : f.fiber t) (hx : x ∈ (I.comap (f.fiberι t)).support) :
      ringKrullDim ((f.fiber t).presheaf.stalk x) = 1 := by
    have hstalk := @topologicalKrullDimAt_eq_ringKrullDim_stalk_of_closed_point
      (IsLocalRing.ResidueField (S.presheaf.stalk t)) inferInstance (f.fiber t)
      (f.fiberToSpecResidueField t) hft x
      (Scheme.IdealSheafData.isClosed_singleton_of_discreteTopology_subscheme
        (I.comap (f.fiberι t)) x hx)
    rw [@topologicalKrullDimAt_eq_one_of_smoothOfRelativeDimension_one
      (IsLocalRing.ResidueField (S.presheaf.stalk t)) inferInstance (f.fiber t)
      (f.fiberToSpecResidueField t) hsmooth x] at hstalk
    exact hstalk.symm
  refine isEffectiveCartierDivisor_of_stalk_regular_principal _ fun x hx => ?_
  have : IsRegularLocalRing ((f.fiber t).presheaf.stalk x) := hregular x
  exact IsRegularLocalRing.exists_isRegular_and_span_singleton_eq (hdim x hx) _
    (Scheme.IdealSheafData.stalk_ne_bot_of_discreteTopology_subscheme
      (I.comap (f.fiberι t)) x hx (hregular x) (hdim x hx))

/-- Local principality and quasi-finiteness on a smooth relative curve produce Cartier
regularity and relative flatness over an arbitrary base. -/
@[colib_tag "COL-1046", stacks 062Y
  "locally principal quasi-finite subschemes on smooth relative curves, via the fibre criterion"]
theorem isRelativeEffectiveCartierDivisor_of_isLocallyPrincipal_of_locallyQuasiFinite
    {X S : Scheme.{u}} (f : X ⟶ S) [SmoothOfRelativeDimension 1 f]
    (I : X.IdealSheafData) (hI : IsLocallyPrincipal I)
    [LocallyQuasiFinite (I.subschemeι ≫ f)] : IsRelativeEffectiveCartierDivisor f I := by
  have : Smooth f := SmoothOfRelativeDimension.smooth 1 f
  exact isRelativeEffectiveCartierDivisor_of_isLocallyPrincipal_of_fibres f I hI
    (isEffectiveCartierDivisor_comap_fiberι_of_locallyQuasiFinite f I)

/-- A section of an invertible module on a smooth relative curve with locally quasi-finite
whole zero scheme is a relative effective Cartier divisor. -/
theorem isRelativeEffectiveCartierDivisor_zeroScheme_of_locallyQuasiFinite
    {X S : Scheme.{u}} (f : X ⟶ S) [SmoothOfRelativeDimension 1 f] (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) [LocallyQuasiFinite ((zeroScheme X L s).subschemeι ≫ f)] :
    IsRelativeEffectiveCartierDivisor f (zeroScheme X L s) :=
  isRelativeEffectiveCartierDivisor_of_isLocallyPrincipal_of_locallyQuasiFinite f _
    (AlgebraicGeometry.isLocallyPrincipal_zeroScheme X L s)

/-- Finite whole zero schemes on smooth relative curves are finite locally free. Flatness
and finite presentation are conclusions, not hypotheses. -/
@[colib_tag "COL-1046", stacks 0B9D
  "finite zero schemes with flatness derived from local principality"]
theorem isFiniteLocallyFree_zeroScheme_of_isFinite
    {X S : Scheme.{u}} (f : X ⟶ S) [SmoothOfRelativeDimension 1 f] (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : Γ(L, ⊤)) [IsFinite ((zeroScheme X L s).subschemeι ≫ f)] :
    Stacks.Morphisms.IsFiniteLocallyFree ((zeroScheme X L s).subschemeι ≫ f) := by
  have h := isRelativeEffectiveCartierDivisor_zeroScheme_of_locallyQuasiFinite f L s
  obtain ⟨-, -, hflat, hfp⟩ :=
    (isRelativeEffectiveCartierDivisor_iff_locallyQuasiFinite_flat f _).mp h
  exact (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_locallyOfFinitePresentation
    _).mpr ⟨inferInstance, hflat, hfp⟩

end AlgebraicGeometry
