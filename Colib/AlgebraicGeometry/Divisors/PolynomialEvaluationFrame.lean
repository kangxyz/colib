module

public import Colib.AlgebraicGeometry.Divisors.PrincipalFrame
public import Colib.RingTheory.Polynomial.EvaluationKernelFrame
public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial

/-!
# The native divisor frame of the polynomial evaluation graph

This uses the actual kernel ideal of `Spec(evalRingHom a)` and the pinned native
divisor sheaf. Its canonical section has exactly the coordinate `X - C a` under
`ΓSpecIso`. No reducedness, field, or supplied line trivialization is assumed.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Polynomial Stacks.Divisors

universe u

namespace AlgebraicGeometry.Scheme.RelativeCurvePencil

variable (R : Type u) [CommRing R] (a : R)

/-- The literal spectral evaluation graph, retaining the entire coefficient scheme. -/
abbrev evaluationGraph : Spec (.of R) ⟶ Spec (.of R[X]) :=
  Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))

/-- The scheme-theoretic evaluation graph ideal, without radicalization. -/
def evaluationGraphIdeal : (Spec (.of R[X])).IdealSheafData :=
  (evaluationGraph R a).ker

/-- The chosen signed polynomial, read as an actual global regular function. -/
def evaluationGraphEquation : Γ(Spec (.of R[X]), ⊤) :=
  (Scheme.ΓSpecIso (.of R[X])).inv (X - C a)

/-- The global ideal of the spectral graph is generated by the original signed difference. -/
theorem evaluationGraphIdeal_top :
    (evaluationGraphIdeal R a).ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.span {evaluationGraphEquation R a} := by
  have he : (evaluationGraph R a).appTop =
      (Scheme.ΓSpecIso (.of R[X])).hom ≫
        CommRingCat.ofHom (Polynomial.evalRingHom a) ≫
          (Scheme.ΓSpecIso (.of R)).inv := by simp
  rw [evaluationGraphIdeal, Scheme.ker_of_isAffine]
  simp only [Scheme.IdealSheafData.ofIdealTop_ideal, homOfLE_refl,
    Opposite.op_id, Functor.map_id, CommRingCat.hom_id, Ideal.map_id]
  rw [he, CommRingCat.hom_comp, CommRingCat.hom_comp, ← RingHom.comap_ker,
    RingHom.ker_comp_of_injective _
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of R)).inv).injective,
    Polynomial.ker_evalRingHom]
  let e := (Scheme.ΓSpecIso (.of R[X])).symm.commRingCatIsoToRingEquiv
  change (Ideal.span {X - C a}).comap e.symm = Ideal.span {e (X - C a)}
  rw [← Ideal.map_comap_of_equiv e, Ideal.map_span, Set.image_singleton]

/-- Monicity makes the equation regular over arbitrary, possibly nonreduced, coefficients. -/
theorem evaluationGraphEquation_regular : IsRegular (evaluationGraphEquation R a) := by
  have hi := (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of R[X])).hom).injective
  have hv : (Scheme.ΓSpecIso (.of R[X])).hom (evaluationGraphEquation R a) = X - C a := by
    simp [evaluationGraphEquation]
  constructor
  · intro x y h
    apply hi
    apply (monic_X_sub_C a).isRegular.left
    simpa only [map_mul, hv] using congrArg (Scheme.ΓSpecIso (.of R[X])).hom h
  · intro x y h
    apply hi
    apply (monic_X_sub_C a).isRegular.right
    simpa only [map_mul, hv] using congrArg (Scheme.ΓSpecIso (.of R[X])).hom h

instance evaluationGraph_isClosedImmersion : IsClosedImmersion (evaluationGraph R a) :=
  IsClosedImmersion.spec_of_surjective _ (fun r => ⟨C r, by simp⟩)

/-- The actual spectral evaluation kernel is an effective Cartier divisor. -/
instance evaluationGraphIdeal_isEffectiveCartierDivisor :
    IsEffectiveCartierDivisor (evaluationGraphIdeal R a) := by
  apply isEffectiveCartierDivisor_of_forall_mem_support
  intro x _
  exact ⟨⟨⊤, isAffineOpen_top _⟩, evaluationGraphEquation R a, trivial,
    evaluationGraphIdeal_top R a, (evaluationGraphEquation_regular R a).mem_nonZeroDivisors⟩

/-- The specified whole-scheme frame of the native evaluation-graph divisor line. -/
def evaluationGraphDivisorFrame :
    divisorSheaf (evaluationGraphIdeal R a) ≅
      SheafOfModules.unit (Spec (.of R[X])).ringCatSheaf :=
  principalDivisorFrame (evaluationGraphIdeal R a) (evaluationGraphIdeal_top R a)
    (evaluationGraphEquation_regular R a).mem_nonZeroDivisors

/-- The canonical section has coordinate `X - C a`, including at its zeros. -/
@[simp]
theorem evaluationGraphDivisorFrame_coordinate :
    (evaluationGraphDivisorFrame R a).hom.app ⊤
      (divisorSheafGlobalSection (evaluationGraphIdeal R a)) = evaluationGraphEquation R a :=
  principalDivisorFrame_canonicalSection _ _ _

end AlgebraicGeometry.Scheme.RelativeCurvePencil
