module

public import Colib.AlgebraicGeometry.Correspondences.Exterior.MixedCoefficientCommonList
public import Colib.AlgebraicGeometry.Correspondences.Exterior.MixedCoefficientStalks

/-!
# The actual common regular family at a mixed incidence point

The constructed common family on the literal mixed coefficient scheme is
transported through the actual open coefficient chart. Its source is the
original middle self-product stalk. Its target is the original full
support-product stalk, and its scalar map is exactly the original middle
stalk map followed by `correspondenceIncidenceSupportStalkMap`.

The full diagonal ideal stalk, not its radical, is generated by this same
`Fin r` family. No matched-component, Tor-vanishing or regular-list provider
is assumed. At an unmatched component there is simply no incidence point.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace RingTheory.Sequence
open AlgebraicGeometry.Scheme

universe u

namespace Stacks.Chow

private theorem mixed_isRegular_map_isIso {A B : CommRingCat.{u}}
    (φ : A ⟶ B) [IsIso φ] {l : List A} (hl : IsRegular A l) :
    IsRegular B (l.map φ.hom) := by
  change IsRegular B (l.map (asIso φ).commRingCatIsoToRingEquiv)
  exact hl.map_ringEquiv (asIso φ).commRingCatIsoToRingEquiv

private theorem mixed_kernel_pointed_stalkMap {A B : Scheme.{u}}
    (i : A ⟶ B) [IsClosedImmersion i] (a : A) (b : B) (hb : b = i a) :
    RingHom.ker ((B.presheaf.stalkCongr (.of_eq hb)).hom ≫ i.stalkMap a).hom =
      IdealSheafData.stalk i.ker b := by
  subst b
  simpa only [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_refl,
    Category.id_comp] using ker_stalkMap_eq_idealStalk_ker i a

/-- The constructed mixed family at a separately specified original middle
point, retaining the point transport in its literal coefficient action. -/
theorem exists_nativeMixedCoefficient_common_regular_list_of_eq
    {S : Scheme.{u}} [IsLocallyNoetherian S] (X Y T U : SmoothSite S)
    (W : (pullback X.hom Y.hom).IdealSheafData) (ψ : T ⟶ U)
    (c : nativeMixedCoefficient X Y T U W)
    (o : pullback (C := Scheme)
      (SmoothSite.product X U).hom (SmoothSite.product X U).hom)
    (ho : o = nativeMixedCoefficientPair X Y T U W ψ c)
    (v : (SmoothSite.product X U).left)
    (hv : o = pullback.diagonal (SmoothSite.product X U).hom v) :
    ∃ (r : ℕ) (b : Fin r →
      (pullback (SmoothSite.product X U).hom (SmoothSite.product X U).hom).presheaf.stalk o),
      IsRegular
        ((pullback (SmoothSite.product X U).hom (SmoothSite.product X U).hom).presheaf.stalk o)
        (List.ofFn b) ∧
      IdealSheafData.stalk (pullback.diagonal (SmoothSite.product X U).hom).ker o =
        Ideal.span (Set.range b) ∧
      IsRegular ((nativeMixedCoefficient X Y T U W).presheaf.stalk c)
        (List.ofFn (fun i =>
          (((pullback (SmoothSite.product X U).hom (SmoothSite.product X U).hom).presheaf.stalkCongr
            (.of_eq ho)).hom ≫
              (nativeMixedCoefficientPair X Y T U W ψ).stalkMap c).hom (b i))) := by
  rcases ho with rfl
  obtain ⟨r, b, hb, hk, hc⟩ :=
    exists_nativeMixedCoefficient_common_regular_list X Y T U W ψ c v hv
  refine ⟨r, b, hb, ?_, ?_⟩
  · exact (mixed_kernel_pointed_stalkMap
      (pullback.diagonal (SmoothSite.product X U).hom) v _ hv).symm.trans hk.symm
  · simpa only [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_refl,
      Category.id_comp] using hc

variable {k : Type u} [Field k] (X Y T U : SmoothSite (Spec (.of k)))
  [GeometricallyIntegral U.hom] (ψ : T ⟶ U)
  (z : pullback (C := Scheme) X.hom Y.hom)
  (hz : IsFiniteCorrespondencePoint X.hom Y.hom z)
  (t : genericPoints (SmoothSite.product X T).left)

local notation3 (prettyPrint := false) "f" => (SmoothSite.product X T).hom
local notation3 (prettyPrint := false) "g" => (SmoothSite.product X U).hom
local notation3 (prettyPrint := false) "h" => (SmoothSite.product Y U).hom
local notation3 (prettyPrint := false) "a" => nativeParameterGraphPoint X T U ψ t
local notation3 (prettyPrint := false) "b" => nativeExteriorPoint X Y U z hz
local notation3 (prettyPrint := false) "q" => nativeMixedCoefficientChart X Y T U ψ z hz t

variable (x : nativeMixedGraphIncidence X Y T U ψ z hz t)

local notation3 (prettyPrint := false) "p" => correspondenceIncidenceAmbientInclusion f g h a b x
local notation3 (prettyPrint := false) "d" => correspondenceIncidenceToSupportProduct f g h a b x
local notation3 (prettyPrint := false) "R" =>
  (pullback g g).presheaf.stalk (correspondenceMiddlePair f g h p)
local notation3 (prettyPrint := false) "D" =>
  (correspondenceSupportProduct f g h a b).presheaf.stalk d
local notation3 (prettyPrint := false) "β" => ((correspondenceMiddlePair f g h).stalkMap p).hom
local notation3 (prettyPrint := false) "ρ" => correspondenceIncidenceSupportStalkMap f g h a b x

/-- One actual original-middle family is regular both in the middle stalk and
in the full support-product stalk under the original scalar path. -/
@[colib_ref "motivic_source_a6805c4"
  "Motivic/AlgebraicGeometry/Correspondences/Exterior/Simplex/GraphInterchangeStalks.lean:106-227"
  "adaptation" "Same native Fin r family on the original middle and full support-product \
    stalks, using the actual open coefficient chart and exact scalar-path identity"]
theorem exists_nativeMixedIncidence_common_regular_list :
    ∃ (r : ℕ) (s : Fin r → R), IsRegular R (List.ofFn s) ∧
      IdealSheafData.stalk (pullback.diagonal g).ker (correspondenceMiddlePair f g h p) =
        Ideal.span (Set.range s) ∧
      IsRegular D (List.ofFn (fun i => ρ (β (s i)))) := by
  let v := correspondenceTripleMiddle f g h (correspondenceIncidenceInclusion f g h a b x)
  have hv : pullback.diagonal g v = correspondenceMiddlePair f g h p := by
    simpa only [v, correspondenceIncidenceAmbientInclusion, Scheme.Hom.comp_apply] using
      congrArg (fun e => e (correspondenceIncidenceInclusion f g h a b x))
        (correspondenceTriple_isPullback f g h).w
  obtain ⟨r, s, hs, hk, hc⟩ :=
    exists_nativeMixedCoefficient_common_regular_list_of_eq X Y T U (integralComponentAt z) ψ
      (q d) (correspondenceMiddlePair f g h p)
      (nativeMixedCoefficient_middlePoint X Y T U ψ z hz t x) v hv.symm
  refine ⟨r, s, hs, hk, ?_⟩
  have hE := mixed_isRegular_map_isIso ((q).stalkMap d) hc
  have hregular : IsRegular D
      (List.ofFn (fun i => ((q).stalkMap d).hom
        ((nativeMixedCoefficientMiddleStalkMap X Y T U ψ z hz t x).hom (s i)))) := by
    simpa only [List.map_ofFn, Function.comp_def,
      nativeMixedCoefficientMiddleStalkMap] using hE
  have hfamily :
      (fun i => ((q).stalkMap d).hom
        ((nativeMixedCoefficientMiddleStalkMap X Y T U ψ z hz t x).hom (s i))) =
        (fun i => ρ (β (s i))) := by
    funext i
    exact DFunLike.congr_fun (nativeMixedCoefficientMiddleStalkMap_comp X Y T U ψ z hz t x) (s i)
  rwa [hfamily] at hregular

end Stacks.Chow
