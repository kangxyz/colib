module

public import Colib.FieldTheory.Separable.FiniteSubfields
public import Mathlib.AlgebraicGeometry.Group.Affine
public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import Mathlib.RingTheory.Etale.Field
public import Mathlib.CategoryTheory.Limits.Preserves.Over

/-!
# Actual base changes along finite subfields

The original subfields generated by finite subsets give a small cofiltered scheme diagram.
Its limit is the actual base change to the extension field, with the original pullback
projections. In a separable extension every stage field is finite étale over the given base.
The base field need not be infinite. This constructs a geometric diagram for descent, without
extending a presheaf or assuming that particular curve data has already descended.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry

variable (K L : Type u) [Field K] [Field L] [Algebra K L]

/-- The original intermediate fields viewed as schemes over the original base field. -/
def finsetSubfieldSpecDiagram : (Finset L)ᵒᵖ ⥤ Over (Spec (.of K)) :=
  (IntermediateField.finsetAdjoinAlgebraDiagram K L).op ⋙ algSpec (.of K)

/-- The cone whose vertex is the original extension-field spectrum. -/
def finsetSubfieldSpecCone : Cone (finsetSubfieldSpecDiagram K L) :=
  (algSpec (.of K)).mapCone (IntermediateField.finsetAdjoinAlgebraCocone K L).op

/-- The extension-field spectrum is the limit over the actual original inclusions. -/
def finsetSubfieldSpecConeIsLimit : IsLimit (finsetSubfieldSpecCone K L) := by
  let : PreservesLimitsOfSize.{u, u} (algSpec (.of K)) := preservesLimitsOfSize_algSpec
  exact isLimitOfPreserves (algSpec (.of K)) (IntermediateField.finsetAdjoinAlgebraIsColimit K L).op

/-- The actual pullbacks of a scheme along the original intermediate fields. -/
def finsetSubfieldBaseChangeDiagram {X : Scheme.{u}} (f : X ⟶ Spec (.of K)) :
    (Finset L)ᵒᵖ ⥤ Scheme.{u} :=
  finsetSubfieldSpecDiagram K L ⋙ Over.pullback f ⋙ Over.forget X

/-- The original base change to the extension field, with the original projection cone. -/
def finsetSubfieldBaseChangeCone {X : Scheme.{u}} (f : X ⟶ Spec (.of K)) :
    Cone (finsetSubfieldBaseChangeDiagram K L f) :=
  (Over.forget X).mapCone ((Over.pullback f).mapCone (finsetSubfieldSpecCone K L))

/-- The original field base change is the cofiltered limit of its actual intermediate models. -/
def finsetSubfieldBaseChangeConeIsLimit {X : Scheme.{u}} (f : X ⟶ Spec (.of K)) :
    IsLimit (finsetSubfieldBaseChangeCone K L f) :=
  isLimitOfPreserves (Over.forget X)
    (isLimitOfPreserves (Over.pullback f) (finsetSubfieldSpecConeIsLimit K L))

/-- The limit cone has exactly the original scheme pullback as its vertex. -/
theorem finsetSubfieldBaseChangeCone_pt {X : Scheme.{u}} (f : X ⟶ Spec (.of K)) :
    (finsetSubfieldBaseChangeCone K L f).pt =
      pullback (Spec.map (CommRingCat.ofHom (algebraMap K L))) f := rfl

/-- Every cone leg preserves the original projection to the scheme. -/
@[simp, reassoc]
theorem finsetSubfieldBaseChangeCone_π_snd {X : Scheme.{u}} (f : X ⟶ Spec (.of K))
    (s : Finset L) :
    (finsetSubfieldBaseChangeCone K L f).π.app (op s) ≫
        pullback.snd (Spec.map (CommRingCat.ofHom
          (algebraMap K (IntermediateField.adjoin K (s : Set L))))) f =
      pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K L))) f :=
  pullback.lift_snd _ _ _

/-- Every cone leg also preserves the actual finite-field inclusion. -/
@[simp, reassoc]
theorem finsetSubfieldBaseChangeCone_π_fst {X : Scheme.{u}} (f : X ⟶ Spec (.of K))
    (s : Finset L) :
    (finsetSubfieldBaseChangeCone K L f).π.app (op s) ≫
        pullback.fst (Spec.map (CommRingCat.ofHom
          (algebraMap K (IntermediateField.adjoin K (s : Set L))))) f =
      pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K L))) f ≫
        Spec.map (CommRingCat.ofHom (IntermediateField.adjoin K (s : Set L)).val.toRingHom) :=
  pullback.lift_fst _ _ _

/-- For a separable extension, each original stage field is finite over the original base. -/
theorem isFinite_finsetSubfieldSpec [Algebra.IsSeparable K L] (s : Finset L) :
    IsFinite (Spec.map (CommRingCat.ofHom
      (algebraMap K (IntermediateField.adjoin K (s : Set L))))) := by
  have := IntermediateField.finite_finsetAdjoinDiagram_obj K L s
  rw [IsFinite.SpecMap_iff]
  exact RingHom.finite_algebraMap.mpr inferInstance

/-- For a separable extension, each original stage field is étale over the original base. -/
theorem etale_finsetSubfieldSpec [Algebra.IsSeparable K L] (s : Finset L) :
    Etale (Spec.map (CommRingCat.ofHom
      (algebraMap K (IntermediateField.adjoin K (s : Set L))))) := by
  have := IntermediateField.finite_finsetAdjoinDiagram_obj K L s
  have := IntermediateField.isSeparable_finsetAdjoinDiagram_obj K L s
  have : Algebra.Etale K (IntermediateField.adjoin K (s : Set L)) :=
    ⟨Algebra.FormallyEtale.of_isSeparable _ _,
      Algebra.FinitePresentation.of_finiteType.mp inferInstance⟩
  apply (HasRingHomProperty.Spec_iff (P := @Etale)).mpr
  exact RingHom.etale_algebraMap.mpr inferInstance

/-- The intermediate-field model is an actual étale refinement of the original scheme. -/
theorem etale_finsetSubfieldBaseChange_snd [Algebra.IsSeparable K L]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of K)) (s : Finset L) :
    Etale (pullback.snd (Spec.map (CommRingCat.ofHom
      (algebraMap K (IntermediateField.adjoin K (s : Set L))))) f) := by
  have := etale_finsetSubfieldSpec K L s
  infer_instance

/-- The transition morphisms in the original base-change diagram are affine. -/
instance finsetSubfieldBaseChangeDiagram_map_isAffineHom {X : Scheme.{u}}
    (f : X ⟶ Spec (.of K)) {s t : (Finset L)ᵒᵖ} (g : s ⟶ t) :
    IsAffineHom ((finsetSubfieldBaseChangeDiagram K L f).map g) := by
  exact MorphismProperty.overPullbackMap (P := @IsAffineHom) f
    ((finsetSubfieldSpecDiagram K L).map g) (by
      change IsAffineHom (Spec.map _)
      infer_instance)

/-- The original models remain quasi-compact when the original scheme is quasi-compact. -/
instance finsetSubfieldBaseChangeDiagram_compactSpace {X : Scheme.{u}} [CompactSpace X]
    (f : X ⟶ Spec (.of K)) (s : (Finset L)ᵒᵖ) :
    CompactSpace ((finsetSubfieldBaseChangeDiagram K L f).obj s) := by
  change CompactSpace ↥(pullback (Spec.map (CommRingCat.ofHom
    (algebraMap K (IntermediateField.adjoin K (s.unop : Set L))))) f : Scheme.{u})
  exact QuasiCompact.compactSpace_of_compactSpace
    (pullback.snd (Spec.map (CommRingCat.ofHom
      (algebraMap K (IntermediateField.adjoin K (s.unop : Set L))))) f)

/-- The original models remain quasi-separated when the original scheme is quasi-separated. -/
instance finsetSubfieldBaseChangeDiagram_quasiSeparatedSpace {X : Scheme.{u}}
    [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of K)) (s : (Finset L)ᵒᵖ) :
    QuasiSeparatedSpace ((finsetSubfieldBaseChangeDiagram K L f).obj s) := by
  change QuasiSeparatedSpace ↥(pullback (Spec.map (CommRingCat.ofHom
    (algebraMap K (IntermediateField.adjoin K (s.unop : Set L))))) f : Scheme.{u})
  exact quasiSeparatedSpace_of_quasiSeparated
    (pullback.snd (Spec.map (CommRingCat.ofHom
      (algebraMap K (IntermediateField.adjoin K (s.unop : Set L))))) f)

end AlgebraicGeometry
