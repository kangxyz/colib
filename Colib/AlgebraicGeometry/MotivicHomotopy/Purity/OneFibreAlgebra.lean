/-!
# The equation of the fibre at one on deformation charts

On each affine chart of the extended-Rees deformation, evaluation at one
has kernel generated by the original parameter minus one. The proof uses
the existing localization of that chart in the Laurent polynomials:
modulo the parameter minus one the parameter is already invertible.

For the zero ideal, the original parameter gives a polynomial coordinate on every chart.
The zero section evaluates that coordinate at zero and cuts out the original zero scheme.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open Opposite Stacks.RelativeSpec

universe u

namespace Stacks.Deformation

-- Adapted from `Stacks.Deformation.laurent_ringHom_ext`, using unit cancellation.
private theorem laurentHom_ext {R S : Type*} [CommRing R] [CommRing S]
    {f g : LaurentPolynomial R →+* S}
    (hC : ∀ r, f (LaurentPolynomial.C r) = g (LaurentPolynomial.C r))
    (hT : f (LaurentPolynomial.T 1) = g (LaurentPolynomial.T 1)) : f = g := by
  have hTn (n : ℕ) : f (LaurentPolynomial.T n) = g (LaurentPolynomial.T n) := by
    have hn : (LaurentPolynomial.T (n : ℤ) : LaurentPolynomial R) =
        LaurentPolynomial.T 1 ^ n := by rw [LaurentPolynomial.T_pow, mul_one]
    rw [hn, map_pow, map_pow, hT]
  have hTz (n : ℤ) : f (LaurentPolynomial.T n) = g (LaurentPolynomial.T n) := by
    obtain ⟨m, rfl | rfl⟩ := Int.eq_nat_or_neg n
    · exact hTn m
    · have hm : (LaurentPolynomial.T (-(m : ℤ)) : LaurentPolynomial R) *
          LaurentPolynomial.T m = 1 := by
        rw [← LaurentPolynomial.T_add, neg_add_cancel, LaurentPolynomial.T_zero]
      have hf := congrArg f hm
      have hg := congrArg g hm
      rw [map_mul, map_one, hTn] at hf
      rw [map_mul, map_one] at hg
      exact ((LaurentPolynomial.isUnit_T (m : ℤ)).map g).mul_right_cancel
        (hf.trans hg.symm)
  apply RingHom.ext
  intro p
  induction p using LaurentPolynomial.induction_on' with
  | add p q hp hq => simp only [map_add, hp, hq]
  | C_mul_T n r => simp only [map_mul, hC, hTz]

private theorem ker_evalOne_of_laurentLocalization
    {A R : Type*} [CommRing A] [CommRing R] [Algebra A (LaurentPolynomial R)]
    (t : A) [IsLocalization.Away t (LaurentPolynomial R)] (c : R →+* A)
    (hc : ∀ r, algebraMap A (LaurentPolynomial R) (c r) = LaurentPolynomial.C r)
    (ht : algebraMap A (LaurentPolynomial R) t = LaurentPolynomial.T (-1)) :
    RingHom.ker ((LaurentPolynomial.eval₂ (RingHom.id R) (1 : Units R)).comp
      (algebraMap A (LaurentPolynomial R))) = Ideal.span {t - 1} := by
  let J : Ideal A := Ideal.span {t - 1}
  let q : A →+* A ⧸ J := Ideal.Quotient.mk J
  have hqt : q t = 1 :=
    (Ideal.Quotient.mk_eq_one_iff_sub_mem t).2 (Ideal.subset_span rfl)
  have hu : IsUnit (q t) := hqt.symm ▸ isUnit_one
  let l : LaurentPolynomial R →+* A ⧸ J := IsLocalization.Away.lift t hu
  have hl (a : A) : l (algebraMap A (LaurentPolynomial R) a) = q a :=
    IsLocalization.Away.lift_eq t hu a
  have hlC (r : R) : l (LaurentPolynomial.C r) = q (c r) := by
    rw [← hc]
    exact hl (c r)
  have hlTneg : l (LaurentPolynomial.T (-1)) = 1 := by
    rw [← ht, hl, hqt]
  have hlT : l (LaurentPolynomial.T 1) = 1 := by
    have he : (LaurentPolynomial.T 1 : LaurentPolynomial R) *
        LaurentPolynomial.T (-1) = 1 := by
      rw [← LaurentPolynomial.T_add, add_neg_cancel, LaurentPolynomial.T_zero]
    simpa only [map_mul, map_one, hlTneg, mul_one] using congrArg l he
  have hl' : l = (q.comp c).comp
      (LaurentPolynomial.eval₂ (RingHom.id R) (1 : Units R)) := by
    apply laurentHom_ext
    · intro r
      simpa only [RingHom.comp_apply, LaurentPolynomial.eval₂_C, RingHom.id_apply] using hlC r
    · simp only [RingHom.comp_apply, LaurentPolynomial.eval₂_T, one_zpow,
        Units.val_one, map_one, hlT]
  apply le_antisymm
  · intro a ha
    apply (Ideal.Quotient.eq_zero_iff_mem).1
    change q a = 0
    rw [← hl, hl']
    change q (c (((LaurentPolynomial.eval₂ (RingHom.id R) (1 : Units R)).comp
      (algebraMap A (LaurentPolynomial R))) a)) = 0
    rw [RingHom.mem_ker.mp ha, map_zero, map_zero]
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    apply RingHom.mem_ker.mpr
    simp only [RingHom.comp_apply, map_sub, map_one, ht,
      LaurentPolynomial.eval₂_T, one_zpow, Units.val_one, sub_self]

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- Evaluation at one on the ring of functions of a deformation chart. -/
def deformationChartEvalOne (W : X.affineOpens) :
    Γ(deformationSpace I, deformationSpaceToBase I ⁻¹ᵁ W.1) →+* Γ(X, W.1) :=
  (LaurentPolynomial.eval₂ (RingHom.id _) (1 : Units Γ(X, W.1))).comp (chartLaurent I W)

/-- Evaluation at one fixes functions pulled back from the ambient scheme. -/
@[simp]
theorem deformationChartEvalOne_toBase (W : X.affineOpens) (r : Γ(X, W.1)) :
    deformationChartEvalOne I W (((deformationSpaceToBase I).app W.1).hom r) = r := by
  simp only [deformationChartEvalOne, RingHom.comp_apply, chartLaurent_app,
    LaurentPolynomial.eval₂_C, RingHom.id_apply]

/-- The original parameter evaluates to one on every affine chart. -/
@[simp]
theorem deformationChartEvalOne_paramChartOf (W : X.affineOpens) :
    deformationChartEvalOne I W (paramChartOf I W.1) = 1 := by
  simp only [deformationChartEvalOne, RingHom.comp_apply, chartLaurent_paramChartOf,
    LaurentPolynomial.eval₂_T, one_zpow, Units.val_one]

/-- Evaluation of a homogeneous chart function forgets its degree. -/
theorem deformationChartEvalOne_chartIncl (W : X.affineOpens) (n : ℤ)
    (x : ((extReesGradedAlgebra I).piece n).val.obj (op W.1)) :
    deformationChartEvalOne I W (chartIncl I n W.1 x) = extReesAmbient I n W.1 x := by
  rw [deformationChartEvalOne, RingHom.comp_apply, ← chartRingHom_incl,
    chartLaurent_chartRingHom, extReesLaurent_incl]
  simp only [map_mul, LaurentPolynomial.eval₂_C, RingHom.id_apply,
    LaurentPolynomial.eval₂_T, one_zpow, Units.val_one, mul_one]

/-- The chart evaluation is the pullback on functions along the actual fibre-one section. -/
theorem deformationOneSection_appLE_eq_deformationChartEvalOne (W : X.affineOpens)
    (h : W.1 ≤ deformationOneSection I ⁻¹ᵁ (deformationSpaceToBase I ⁻¹ᵁ W.1)) :
    ((deformationOneSection I).appLE (deformationSpaceToBase I ⁻¹ᵁ W.1) W.1 h).hom =
      deformationChartEvalOne I W := by
  apply RingHom.ext
  intro y
  obtain ⟨x, rfl⟩ := (bijective_chartRingHom I W).2 y
  induction x using Stacks.GradedAlgebra.incl_induction with
  | zero => simp only [map_zero]
  | add x y hx hy => simp only [map_add, hx, hy]
  | incl n x =>
      rw [chartRingHom_incl, deformationOneSection_appLE_chartIncl,
        deformationChartEvalOne_chartIncl]

/-- The fibre-one equation in the original deformation chart is the parameter minus one. -/
theorem ker_deformationChartEvalOne (W : X.affineOpens) :
    RingHom.ker (deformationChartEvalOne I W) = Ideal.span {paramChartOf I W.1 - 1} := by
  let := (chartLaurent I W).toAlgebra
  have := isLocalization_chartLaurent I W
  exact ker_evalOne_of_laurentLocalization (paramChartOf I W.1)
    ((deformationSpaceToBase I).app W.1).hom (chartLaurent_app I W)
    (chartLaurent_paramChartOf I W)

/-- The ideal of the actual fibre-one section, on a deformation chart, is generated by
the original parameter minus one. -/
theorem ker_deformationOneSection_appLE (W : X.affineOpens)
    (h : W.1 ≤ deformationOneSection I ⁻¹ᵁ (deformationSpaceToBase I ⁻¹ᵁ W.1)) :
    RingHom.ker
      ((deformationOneSection I).appLE (deformationSpaceToBase I ⁻¹ᵁ W.1) W.1 h).hom =
        Ideal.span {paramChartOf I W.1 - 1} := by
  rw [deformationOneSection_appLE_eq_deformationChartEvalOne, ker_deformationChartEvalOne]

/-- The inverse image of a deformation chart under the one section is the original open. -/
@[simp]
theorem deformationOneSection_preimage_toBase (W : X.Opens) :
    deformationOneSection I ⁻¹ᵁ (deformationSpaceToBase I ⁻¹ᵁ W) = W := by
  rw [← Scheme.Hom.comp_preimage, deformationOneSection_toBase, Scheme.Hom.id_preimage]

private theorem ker_app_eq_ker_appLE {Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens)
    (V : X.Opens) (h : f ⁻¹ᵁ U = V) :
    RingHom.ker (f.app U).hom = RingHom.ker (f.appLE U V h.ge).hom := by
  let r := X.presheaf.map (homOfLE h.ge).op
  have : IsIso r := by
    have hr : homOfLE h.ge = eqToHom h.symm := Subsingleton.elim _ _
    dsimp [r]
    rw [hr]
    infer_instance
  exact (RingHom.ker_comp_of_injective (f.app U).hom
    (f := r.hom) (ConcreteCategory.bijective_of_isIso r).1).symm

/-- The defining ideal of the actual one section on an affine deformation chart. -/
theorem ker_deformationOneSection_ideal (W : X.affineOpens) :
    (deformationOneSection I).ker.ideal
      ⟨deformationSpaceToBase I ⁻¹ᵁ W.1,
        Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation I) W⟩ =
      Ideal.span {paramChartOf I W.1 - 1} := by
  have he := deformationOneSection_preimage_toBase I W.1
  rw [Scheme.Hom.ker_apply, ker_app_eq_ker_appLE _ _ _ he,
    ker_deformationOneSection_appLE]

/-- The closed subscheme where the original deformation parameter is one. -/
abbrev parameterOneIdeal : (deformationSpace I).IdealSheafData :=
  Stacks.Divisors.zeroScheme (deformationSpace I) (Scheme.unitModule (deformationSpace I))
    (Sub.sub (α := Γ(deformationSpace I, ⊤)) (paramGlobal I) 1)

private theorem parameterOneIdeal_ideal (W : X.affineOpens) :
    (parameterOneIdeal I).ideal
      ⟨deformationSpaceToBase I ⁻¹ᵁ W.1,
        Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation I) W⟩ =
      Ideal.span {paramChartOf I W.1 - 1} := by
  refine Stacks.Divisors.zeroScheme_ideal_of_trivialization (deformationSpace I)
    (Scheme.unitModule (deformationSpace I)) _ _ (LinearEquiv.refl _ _) _ ?_
  let f := (deformationSpace I).presheaf.map
    (homOfLE le_top : deformationSpaceToBase I ⁻¹ᵁ W.1 ⟶ ⊤).op
  exact (map_sub f.hom (paramGlobal I : Γ(deformationSpace I, ⊤))
    (1 : Γ(deformationSpace I, ⊤))).trans
    (congrArg₂ (· - ·) (paramGlobal_restrict I W.1) (map_one f.hom))

/-- The original fibre-one section cuts out precisely the parameter-one subscheme. -/
theorem ker_deformationOneSection :
    (deformationOneSection I).ker = parameterOneIdeal I := by
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top
    (fun W : X.affineOpens =>
      (⟨deformationSpaceToBase I ⁻¹ᵁ W.1,
        Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation I) W⟩ :
          (deformationSpace I).affineOpens)) ?_ fun W => ?_
  · rw [← Scheme.Hom.preimage_iSup, iSup_affineOpens_eq_top, Scheme.Hom.preimage_top]
  · exact (ker_deformationOneSection_ideal I W).trans (parameterOneIdeal_ideal I W).symm

/-- The parameter-one subscheme of the deformation is canonically the ambient scheme. -/
def parameterOneIsoBase : (parameterOneIdeal I).subscheme ≅ X :=
  have := IsClosedImmersion.isIso_lift (deformationOneSection I)
    (parameterOneIdeal I).subschemeι
      (by rw [Scheme.IdealSheafData.ker_subschemeι, ker_deformationOneSection])
  asIso (IsClosedImmersion.lift (deformationOneSection I) (parameterOneIdeal I).subschemeι
    (by rw [Scheme.IdealSheafData.ker_subschemeι, ker_deformationOneSection]))

/-- The canonical identification of the parameter-one fibre retains the actual closed section. -/
@[reassoc (attr := simp)]
theorem parameterOneIsoBase_hom_comp :
    (parameterOneIsoBase I).hom ≫ deformationOneSection I = (parameterOneIdeal I).subschemeι :=
  IsClosedImmersion.lift_fac _ _ _

/-- Every original deformation map preserves the parameter-one subscheme. -/
theorem comap_parameterOneIdeal {Y : Scheme.{u}} (g : Y ⟶ X) (J : Y.IdealSheafData)
    (hI : I.comap g ≤ J) :
    (parameterOneIdeal I).comap (deformationMap g I J hI) = parameterOneIdeal J := by
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top
    (fun P : Σ W : X.affineOpens, {W' : Y.affineOpens // W'.1 ≤ g ⁻¹ᵁ W.1} =>
      (⟨deformationSpaceToBase J ⁻¹ᵁ P.2.1.1,
        Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation J) P.2.1⟩ :
          (deformationSpace J).affineOpens)) ?_ fun P => ?_
  · refine eq_top_iff.2 fun x _ => ?_
    obtain ⟨W, hW⟩ := Stacks.Divisors.exists_affineOpens_mem (g (deformationSpaceToBase J x))
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVle⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open
      (show deformationSpaceToBase J x ∈ (g ⁻¹ᵁ W.1 : Y.Opens) from hW)
      (g ⁻¹ᵁ W.1).isOpen
    exact TopologicalSpace.Opens.mem_iSup.2 ⟨⟨W, ⟨⟨V, hV⟩, hVle⟩⟩, hxV⟩
  · obtain ⟨W, W', hW'⟩ := P
    have hle : deformationSpaceToBase J ⁻¹ᵁ W'.1 ≤
        deformationMap g I J hI ⁻¹ᵁ (deformationSpaceToBase I ⁻¹ᵁ W.1) := by
      rw [← Scheme.Hom.comp_preimage, deformationMap_toBase, Scheme.Hom.comp_preimage]
      exact Scheme.Hom.preimage_mono _ hW'
    refine (Stacks.IdealSheaf.ideal_comap_appLE _ _
      ⟨_, Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation I) W⟩
      _ hle).trans ?_
    refine (congrArg (Ideal.map _) (parameterOneIdeal_ideal I W)).trans ?_
    refine (Ideal.map_span _ _).trans ?_
    refine Eq.trans ?_ (parameterOneIdeal_ideal J W').symm
    refine congrArg Ideal.span (Set.image_singleton.trans ?_)
    congr 1
    let f := (deformationMap g I J hI).appLE (deformationSpaceToBase I ⁻¹ᵁ W.1)
      (deformationSpaceToBase J ⁻¹ᵁ W'.1) hle
    change f.hom (paramChartOf I W.1 - 1) = paramChartOf J W'.1 - 1
    exact (map_sub f.hom _ _).trans (congrArg₂ (· - ·)
      (deformationMap_appLE_paramChartOf g I J hI W W'.1 hW' hle) (map_one f.hom))

/-- The original deformation map carries the original one section to the one section. -/
@[reassoc]
theorem deformationOneSection_naturality {Y : Scheme.{u}} (g : Y ⟶ X)
    (J : Y.IdealSheafData) (hI : I.comap g ≤ J) :
    g ≫ deformationOneSection I = deformationOneSection J ≫ deformationMap g I J hI := by
  have hle : (deformationOneSection I).ker ≤
      (deformationOneSection J ≫ deformationMap g I J hI).ker := by
    rw [Scheme.Hom.ker_comp, ker_deformationOneSection, ker_deformationOneSection,
      Scheme.IdealSheafData.le_map_iff_comap_le, comap_parameterOneIdeal]
  let l := IsClosedImmersion.lift (deformationOneSection I)
    (deformationOneSection J ≫ deformationMap g I J hI) hle
  have hl : l ≫ deformationOneSection I =
      deformationOneSection J ≫ deformationMap g I J hI :=
    IsClosedImmersion.lift_fac _ _ _
  have hl' : l = g := by
    calc
      l = l ≫ (deformationOneSection I ≫ deformationSpaceToBase I) := by
        rw [deformationOneSection_toBase, Category.comp_id]
      _ = (deformationOneSection J ≫ deformationMap g I J hI) ≫
          deformationSpaceToBase I := by rw [← Category.assoc, hl]
      _ = g := by
        rw [Category.assoc, deformationMap_toBase, ← Category.assoc,
          deformationOneSection_toBase, Category.id_comp]
  rwa [hl'] at hl

/-- The original fibre-one square for a morphism of deformation spaces is cartesian. -/
theorem isPullback_deformationOneSection {Y : Scheme.{u}} (g : Y ⟶ X)
    (J : Y.IdealSheafData) (hI : I.comap g ≤ J) :
    IsPullback g (deformationOneSection J) (deformationOneSection I)
      (deformationMap g I J hI) :=
  (isPullback_of_isClosedImmersion (deformationOneSection J) (deformationOneSection I) g
    (deformationMap g I J hI) (deformationOneSection_naturality I g J hI).symm
    (by rw [ker_deformationOneSection, ker_deformationOneSection, comap_parameterOneIdeal])).flip

/-- A nonpositive homogeneous chart function is its ambient function times the
corresponding power of the original parameter. -/
theorem chartIncl_eq_base_mul_param_pow_of_nonpos (W : X.affineOpens) (n : ℤ) (hn : n ≤ 0)
    (x : ((extReesGradedAlgebra I).piece n).val.obj (op W.1)) :
    chartIncl I n W.1 x =
      ((deformationSpaceToBase I).app W.1).hom (extReesAmbient I n W.1 x) *
        paramChartOf I W.1 ^ (-n).toNat := by
  have hinj : Function.Injective (chartLaurent I W) :=
    (extReesLaurent_injective I W.1).comp
      (RingEquiv.ofBijective (chartRingHom I W.1) (bijective_chartRingHom I W)).symm.injective
  apply hinj
  rw [map_mul, map_pow, chartLaurent_app, chartLaurent_paramChartOf,
    ← chartRingHom_incl, chartLaurent_chartRingHom, extReesLaurent_incl, LaurentPolynomial.T_pow]
  congr 2
  omega

/-- The canonical polynomial map to a chart of the deformation of the zero ideal,
with the polynomial variable sent to the original deformation parameter. -/
def zeroIdealChartPolynomial (W : X.affineOpens) :
    Polynomial Γ(X, W.1) →+*
      Γ(deformationSpace (⊥ : X.IdealSheafData),
        deformationSpaceToBase (⊥ : X.IdealSheafData) ⁻¹ᵁ W.1) :=
  Polynomial.eval₂RingHom
    ((deformationSpaceToBase (⊥ : X.IdealSheafData)).app W.1).hom
    (paramChartOf (⊥ : X.IdealSheafData) W.1)

/-- In the Laurent realization, the zero-ideal polynomial chart is substitution `T ↦ T⁻¹`. -/
theorem chartLaurent_comp_zeroIdealChartPolynomial (W : X.affineOpens) :
    (chartLaurent (⊥ : X.IdealSheafData) W).comp (zeroIdealChartPolynomial W) =
      LaurentPolynomial.invert.toRingHom.comp Polynomial.toLaurent := by
  apply Polynomial.ringHom_ext
  · intro r
    simp [zeroIdealChartPolynomial, chartLaurent_app]
  · simp [zeroIdealChartPolynomial, chartLaurent_paramChartOf]

/-- The original parameter is algebraically independent on the zero-ideal deformation. -/
theorem zeroIdealChartPolynomial_injective (W : X.affineOpens) :
    Function.Injective (zeroIdealChartPolynomial W) := by
  have h : Function.Injective
      ((chartLaurent (⊥ : X.IdealSheafData) W).comp (zeroIdealChartPolynomial W)) := by
    rw [chartLaurent_comp_zeroIdealChartPolynomial]
    exact LaurentPolynomial.invert.injective.comp Polynomial.toLaurent_injective
  intro p q hpq
  apply h
  exact congrArg (chartLaurent (⊥ : X.IdealSheafData) W) hpq

/-- Every function on a zero-ideal deformation chart is a polynomial in its original parameter. -/
theorem zeroIdealChartPolynomial_surjective (W : X.affineOpens) :
    Function.Surjective (zeroIdealChartPolynomial W) := by
  intro y
  obtain ⟨x, rfl⟩ := (bijective_chartRingHom (⊥ : X.IdealSheafData) W).2 y
  induction x using Stacks.GradedAlgebra.incl_induction with
  | zero => exact ⟨0, by simp only [map_zero]⟩
  | add x y hx hy =>
      obtain ⟨p, hp⟩ := hx
      obtain ⟨q, hq⟩ := hy
      exact ⟨p + q, by simp only [map_add, hp, hq]⟩
  | incl n x =>
      rw [chartRingHom_incl]
      by_cases hn : n ≤ 0
      · refine ⟨Polynomial.C (extReesAmbient (⊥ : X.IdealSheafData) n W.1 x) *
          Polynomial.X ^ (-n).toNat, ?_⟩
        simpa [zeroIdealChartPolynomial] using
          (chartIncl_eq_base_mul_param_pow_of_nonpos (⊥ : X.IdealSheafData) W n hn x).symm
      · have hn' : n.toNat ≠ 0 := by omega
        have hm := Stacks.Blowup.reesPieceAmbient_mem_affine (⊥ : X.IdealSheafData)
          (n.toNat : ℤ) (Int.natCast_nonneg _) W x
        have h0 : extReesAmbient (⊥ : X.IdealSheafData) n W.1 x = 0 := by
          change extReesAmbient (⊥ : X.IdealSheafData) n W.1 x ∈
            (⊥ : Ideal Γ(X, W.1)) ^ (n.toNat : ℤ).toNat at hm
          simpa only [Int.toNat_natCast, Ideal.bot_pow hn', Ideal.mem_bot] using hm
        exact ⟨0, (map_zero _).trans
          (chartIncl_eq_zero_of_ambient (⊥ : X.IdealSheafData) W.1 n x h0).symm⟩

/-- The zero-ideal deformation chart is the polynomial ring in the original parameter. -/
def zeroIdealChartPolynomialEquiv (W : X.affineOpens) :
    Polynomial Γ(X, W.1) ≃+*
      Γ(deformationSpace (⊥ : X.IdealSheafData),
        deformationSpaceToBase (⊥ : X.IdealSheafData) ⁻¹ᵁ W.1) :=
  RingEquiv.ofBijective (zeroIdealChartPolynomial W)
    ⟨zeroIdealChartPolynomial_injective W, zeroIdealChartPolynomial_surjective W⟩

/-- The actual zero section is evaluation at zero in the original polynomial coordinate. -/
theorem deformationZeroSectionBot_appLE_comp_zeroIdealChartPolynomial (W : X.affineOpens)
    (h : W.1 ≤ deformationZeroSectionBot X ⁻¹ᵁ
      (deformationSpaceToBase (⊥ : X.IdealSheafData) ⁻¹ᵁ W.1)) :
    (((deformationZeroSectionBot X).appLE
      (deformationSpaceToBase (⊥ : X.IdealSheafData) ⁻¹ᵁ W.1) W.1 h).hom).comp
      (zeroIdealChartPolynomial W) = Polynomial.evalRingHom (0 : Γ(X, W.1)) := by
  apply Polynomial.ringHom_ext
  · intro r
    simp only [RingHom.comp_apply, zeroIdealChartPolynomial, Polynomial.coe_eval₂RingHom,
      Polynomial.eval₂_C,
      Polynomial.coe_evalRingHom, Polynomial.eval_C]
    rw [deformationSpaceToBase_app_eq_chartIncl]
    exact (deformationZeroSectionBot_appLE_chartIncl X W 0 _ h).trans
      ((extReesBotEvalZero_incl_zero X W.1 _).trans
        (extReesAmbient_extReesOfMem (⊥ : X.IdealSheafData) W 0 r _))
  · simp only [RingHom.comp_apply, zeroIdealChartPolynomial, Polynomial.coe_eval₂RingHom,
      Polynomial.eval₂_X,
      Polynomial.coe_evalRingHom, Polynomial.eval_X]
    exact deformationZeroSectionBot_appLE_paramChartOf X W h

/-- The ideal of the actual zero section on an affine deformation chart. -/
theorem ker_deformationZeroSectionBot_appLE (W : X.affineOpens)
    (h : W.1 ≤ deformationZeroSectionBot X ⁻¹ᵁ
      (deformationSpaceToBase (⊥ : X.IdealSheafData) ⁻¹ᵁ W.1)) :
    RingHom.ker ((deformationZeroSectionBot X).appLE
      (deformationSpaceToBase (⊥ : X.IdealSheafData) ⁻¹ᵁ W.1) W.1 h).hom =
      Ideal.span {paramChartOf (⊥ : X.IdealSheafData) W.1} := by
  let p := zeroIdealChartPolynomial W
  let f := ((deformationZeroSectionBot X).appLE
    (deformationSpaceToBase (⊥ : X.IdealSheafData) ⁻¹ᵁ W.1) W.1 h).hom
  have hp : Function.Surjective p := (zeroIdealChartPolynomialEquiv W).surjective
  have hf : f.comp p = Polynomial.evalRingHom (0 : Γ(X, W.1)) :=
    deformationZeroSectionBot_appLE_comp_zeroIdealChartPolynomial W h
  change RingHom.ker f = _
  rw [← Ideal.map_comap_of_surjective p hp (RingHom.ker f), RingHom.comap_ker, hf,
    Polynomial.ker_evalRingHom, map_zero, sub_zero, Ideal.map_span, Set.image_singleton]
  simp [p, zeroIdealChartPolynomial]

/-- The zero section cuts out the zero scheme of the original deformation parameter. -/
theorem ker_deformationZeroSectionBot (X : Scheme.{u}) :
    (deformationZeroSectionBot X).ker =
      Stacks.Divisors.zeroScheme (deformationSpace (⊥ : X.IdealSheafData))
        (Scheme.unitModule (deformationSpace (⊥ : X.IdealSheafData)))
        (paramGlobal (⊥ : X.IdealSheafData)) := by
  let J : X.IdealSheafData := ⊥
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top
    (fun W : X.affineOpens =>
      (⟨deformationSpaceToBase J ⁻¹ᵁ W.1,
        Stacks.RelativeSpec.isAffineOpen_toBase_preimage (extReesSituation J) W⟩ :
          (deformationSpace J).affineOpens)) ?_ fun W => ?_
  · rw [← Scheme.Hom.preimage_iSup, iSup_affineOpens_eq_top, Scheme.Hom.preimage_top]
  · have h : deformationZeroSectionBot X ⁻¹ᵁ
        (deformationSpaceToBase J ⁻¹ᵁ W.1) = W.1 := by
      rw [← Scheme.Hom.comp_preimage, deformationZeroSectionBot_toBase, Scheme.Hom.id_preimage]
    exact (Scheme.Hom.ker_apply (deformationZeroSectionBot X) _).trans
      ((ker_app_eq_ker_appLE _ _ _ h).trans ((ker_deformationZeroSectionBot_appLE W h.ge).trans
        (zeroScheme_paramGlobal_ideal J W).symm))

/-- The deformation of the zero ideal is an affine-space bundle of rank one,
using its original parameter as the coordinate on every chart. -/
theorem isAffineSpaceBundle_deformationSpaceToBase_bot (X : Scheme.{u}) :
    Stacks.Chow.IsAffineSpaceBundle
      (deformationSpaceToBase (⊥ : X.IdealSheafData)) 1 := by
  intro x
  obtain ⟨W, hxW⟩ := Stacks.Divisors.exists_affineOpens_mem x
  let A := extReesAlgebraSheaf (⊥ : X.IdealSheafData)
  have := isIso_universalAlgebraMap_app (extReesSituation (⊥ : X.IdealSheafData)) W
  let e := (asIso ((universalAlgebraMap (extReesSituation (⊥ : X.IdealSheafData))).right.app
    (op W.1))).commRingCatIsoToRingEquiv
  let d := MvPolynomial.uniqueAlgEquiv Γ(X, W.1) (Fin 1)
  let ψ : A.right.obj.obj (op W.1) ≃+* MvPolynomial (Fin 1) Γ(X, W.1) :=
    (e.trans (zeroIdealChartPolynomialEquiv W).symm).trans d.symm.toRingEquiv
  have hψ (r : Γ(X, W.1)) : ψ ((A.hom.hom.app (op W.1)).hom r) = MvPolynomial.C r := by
    have he : e ((A.hom.hom.app (op W.1)).hom r) =
        ((deformationSpaceToBase (⊥ : X.IdealSheafData)).app W.1).hom r :=
      (congrArg (fun q => q.hom r)
        (toBase_app (extReesSituation (⊥ : X.IdealSheafData)) W.1)).symm
    have hp : (zeroIdealChartPolynomialEquiv W) (Polynomial.C r) =
        ((deformationSpaceToBase (⊥ : X.IdealSheafData)).app W.1).hom r := by
      simp [zeroIdealChartPolynomialEquiv, zeroIdealChartPolynomial]
    change d.symm ((zeroIdealChartPolynomialEquiv W).symm
      (e ((A.hom.hom.app (op W.1)).hom r))) = MvPolynomial.C r
    rw [he, ← hp, RingEquiv.symm_apply_apply]
    exact d.symm.commutes r
  obtain ⟨eW, heW⟩ := Stacks.Chow.exists_iso_affineSpace_of_mvPolynomialSections A W 1 ψ hψ
  exact ⟨W.1, hxW, eW, heW⟩

/-- The projection of the zero-ideal deformation is smooth of relative dimension one. -/
theorem smoothOfRelativeDimension_deformationSpaceToBase_bot (X : Scheme.{u}) :
    SmoothOfRelativeDimension 1 (deformationSpaceToBase (⊥ : X.IdealSheafData)) :=
  Stacks.Chow.smoothOfRelativeDimension_of_isAffineSpaceBundle _ 1
    (isAffineSpaceBundle_deformationSpaceToBase_bot X)

section ClosedPair

open Stacks.Conormal

variable {Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

/-- The original ambient fibre-one map has the parameter-one ideal. -/
theorem ker_closedPairOneSection :
    (closedPairOneSection i).ker = parameterOneIdeal (coborderIdeal i) := by
  have := isIso_coborderRange_ι_of_isClosedImmersion i
  rw [closedPairOneSection, Scheme.Hom.ker_comp_of_isIso, ker_deformationOneSection]

/-- The one-section square of the actual closed support map preserves the closed centre. -/
theorem isPullback_closedPairOneSection_support :
    IsPullback i (deformationOneSection (⊥ : Z.IdealSheafData))
      (closedPairOneSection i) (deformationSupportMap i) := by
  have := isIso_coborderRange_ι_of_isClosedImmersion i
  have hw : i ≫ closedPairOneSection i =
      deformationOneSection (⊥ : Z.IdealSheafData) ≫ deformationSupportMap i := by
    refine (congrArg (· ≫ closedPairOneSection i) (Scheme.Hom.liftCoborder_ι i).symm).trans ?_
    rw [closedPairOneSection, Category.assoc, IsIso.hom_inv_id_assoc]
    exact deformationOneSection_naturality (coborderIdeal i) i.liftCoborder ⊥
      (coborderIdeal_comap_liftCoborder i).le
  exact (isPullback_of_isClosedImmersion (deformationOneSection (⊥ : Z.IdealSheafData))
    (closedPairOneSection i) i (deformationSupportMap i) hw.symm
    (by rw [ker_closedPairOneSection, ker_deformationOneSection]
        exact comap_parameterOneIdeal (coborderIdeal i) i.liftCoborder ⊥
          (coborderIdeal_comap_liftCoborder i).le)).flip

/-- For a closed pair the parameter-one subscheme is the original ambient scheme,
through the canonical identification of its coborder with the ambient scheme. -/
def closedPairParameterOneIsoAmbient : (parameterOneIdeal (coborderIdeal i)).subscheme ≅ X :=
  have := isIso_coborderRange_ι_of_isClosedImmersion i
  parameterOneIsoBase (coborderIdeal i) ≪≫ asIso i.coborderRange.ι

/-- The closed-pair fibre identification preserves the original fibre-one inclusion. -/
@[reassoc (attr := simp)]
theorem closedPairParameterOneIsoAmbient_hom_comp :
    (closedPairParameterOneIsoAmbient i).hom ≫ closedPairOneSection i =
      (parameterOneIdeal (coborderIdeal i)).subschemeι := by
  have := isIso_coborderRange_ι_of_isClosedImmersion i
  simp [closedPairParameterOneIsoAmbient, closedPairOneSection, Category.assoc]

end ClosedPair

end Stacks.Deformation

