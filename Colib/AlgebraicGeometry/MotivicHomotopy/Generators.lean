/-!
# Actual pointed Nisnevich and affine-line generating maps

The three families are the empty-descent map, the strict pointed pushout maps
of geometric Nisnevich squares, and the pointed representable affine-line
projections. The Nisnevich squares retain the existing closed-complement
isomorphism hypotheses. Their ordinary type-valued presheaf pushout maps
become isomorphisms after Nisnevich sheafification.

The families are native morphism properties generated by the displayed maps.
They are not asserted to be classes of homotopy equivalences, and this file
does not form or identify a motivic homotopy category.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry.Scheme AlgebraicGeometry.Scheme.SmoothSite
open CategoryTheory.PointedSimplicialPresheaf

universe u

namespace AlgebraicGeometry.MotivicHomotopy

variable (S : Scheme.{u})

/-- The existing finite disjoint union of the empty family is the actual empty
smooth scheme over the base. -/
abbrev emptySmoothScheme : SmoothSite S :=
  finiteCoproduct (S := S) (fun i : Fin 0 ↦ Fin.elim0 i)

@[simp]
theorem emptySmoothScheme_left : (emptySmoothScheme S).left = (∅ : Scheme.{u}) := rfl

@[simp]
theorem emptySmoothScheme_hom : (emptySmoothScheme S).hom = Scheme.emptyTo S := rfl

/-- The selected empty smooth scheme is initial, with the actual empty scheme maps. -/
def emptySmoothSchemeIsInitial : IsInitial (emptySmoothScheme S) :=
  IsInitial.ofUniqueHom
    (fun X ↦ homMk (Scheme.emptyTo X.left) (Scheme.empty_ext _ _))
    (fun _ _ ↦ MorphismProperty.Over.Hom.ext (Scheme.empty_ext _ _))

/-- Empty descent is imposed by the actual point-to-empty-representable map. -/
def emptyDescentMap : point (SmoothSite S) ⟶
    (PointedSimplicialPresheaf.yoneda (SmoothSite S)).obj (emptySmoothScheme S) :=
  fromPoint (SmoothSite S) _

/-- The underlying empty-descent map is exactly the freely adjoined point inclusion. -/
@[simp]
theorem emptyDescentMap_right : (emptyDescentMap S).right = coprod.inr := rfl

/-- The empty-descent family is separate from the distinguished-square family. -/
def emptyDescentMaps : MorphismProperty (PointedSimplicialPresheaf.{u} (SmoothSite S)) :=
  .single (emptyDescentMap S)

theorem emptyDescentMap_mem : emptyDescentMaps S (emptyDescentMap S) :=
  MorphismProperty.prop_single _

theorem emptyDescentMaps_iff {F G : PointedSimplicialPresheaf.{u} (SmoothSite S)}
    (f : F ⟶ G) : emptyDescentMaps S f ↔ Arrow.mk f = Arrow.mk (emptyDescentMap S) := by
  simp only [emptyDescentMaps, MorphismProperty.single, MorphismProperty.ofHoms_iff,
    exists_const]

variable {S}

/-- The geometric hypotheses of the existing smooth Nisnevich square provider.
The complement is supplied by an actual closed immersion with the indicated support. -/
def IsNisnevichDistinguishedSquare (sq : Square (SmoothSite S)) : Prop :=
  sq.IsPullback ∧ IsOpenImmersion sq.f₂₄.left ∧ Etale sq.f₃₄.left ∧
    ∃ (Z : Scheme.{u}) (z : Z ⟶ sq.X₄.left), IsClosedImmersion z ∧
      Set.range z = (Set.range sq.f₂₄.left)ᶜ ∧ IsIso (pullback.snd sq.f₃₄.left z)

/-- The generator index retains a native square and its actual geometric hypotheses. -/
abbrev NisnevichSquare (S : Scheme.{u}) :=
  {sq : Square (SmoothSite S) // IsNisnevichDistinguishedSquare sq}

/-- The existing geometric data give an index for the actual square-generator family. -/
def nisnevichSquareOfIsoComplement
    (sq : Square (SmoothSite S)) (hpb : sq.IsPullback)
    [IsOpenImmersion sq.f₂₄.left] [Etale sq.f₃₄.left]
    {Z : Scheme.{u}} (z : Z ⟶ sq.X₄.left) [IsClosedImmersion z]
    (hcomp : Set.range z = (Set.range sq.f₂₄.left)ᶜ)
    [IsIso (pullback.snd sq.f₃₄.left z)] : NisnevichSquare S :=
  ⟨sq, hpb, inferInstance, inferInstance, Z, z, inferInstance, hcomp, inferInstance⟩

variable (S)

/-- The Nisnevich-square map is the actual strict pointed Yoneda pushout map. -/
def nisnevichSquareMap (Q : NisnevichSquare S) :
    squarePushout (SmoothSite S) Q.val ⟶
      (PointedSimplicialPresheaf.yoneda (SmoothSite S)).obj Q.val.X₄ :=
  squarePushoutMap (SmoothSite S) Q.val

@[reassoc (attr := simp)]
theorem nisnevichSquareMap_inl (Q : NisnevichSquare S) :
    squarePushoutInl (SmoothSite S) Q.val ≫ nisnevichSquareMap S Q =
      (PointedSimplicialPresheaf.yoneda (SmoothSite S)).map Q.val.f₂₄ :=
  squarePushoutInl_map _ _

@[reassoc (attr := simp)]
theorem nisnevichSquareMap_inr (Q : NisnevichSquare S) :
    squarePushoutInr (SmoothSite S) Q.val ≫ nisnevichSquareMap S Q =
      (PointedSimplicialPresheaf.yoneda (SmoothSite S)).map Q.val.f₃₄ :=
  squarePushoutInr_map _ _

/-- The family consists exactly of the displayed geometric square maps. -/
def nisnevichSquareMaps : MorphismProperty (PointedSimplicialPresheaf.{u} (SmoothSite S)) :=
  .ofHoms (nisnevichSquareMap S)

theorem nisnevichSquareMap_mem (Q : NisnevichSquare S) :
    nisnevichSquareMaps S (nisnevichSquareMap S Q) :=
  MorphismProperty.ofHoms.mk Q

theorem nisnevichSquareMaps_iff {F G : PointedSimplicialPresheaf.{u} (SmoothSite S)}
    (f : F ⟶ G) : nisnevichSquareMaps S f ↔
      ∃ Q : NisnevichSquare S, Arrow.mk f = Arrow.mk (nisnevichSquareMap S Q) :=
  MorphismProperty.ofHoms_iff _ _

variable {S}

/-- Every supplied geometric Nisnevich square contributes its original strict map. -/
theorem squarePushoutMap_mem_nisnevichSquareMaps
    (sq : Square (SmoothSite S)) (hpb : sq.IsPullback)
    [IsOpenImmersion sq.f₂₄.left] [Etale sq.f₃₄.left]
    {Z : Scheme.{u}} (z : Z ⟶ sq.X₄.left) [IsClosedImmersion z]
    (hcomp : Set.range z = (Set.range sq.f₂₄.left)ᶜ)
    [IsIso (pullback.snd sq.f₃₄.left z)] :
    nisnevichSquareMaps S (squarePushoutMap (SmoothSite S) sq) :=
  nisnevichSquareMap_mem S (nisnevichSquareOfIsoComplement sq hpb z hcomp)

section OrdinarySheafification

variable [HasWeakSheafify (nisnevichTopology S) (Type u)]

/-- Ordinary sheafification takes each actual geometric square to a pushout.
This invokes the existing geometric theorem, not a new descent assumption. -/
theorem nisnevichSquare_isPushout_sheafification (Q : NisnevichSquare S) :
    (Q.val.map (CategoryTheory.yoneda ⋙
      presheafToSheaf (nisnevichTopology S) (Type u))).IsPushout := by
  obtain ⟨hpb, hi, hp, Z, z, hz, hcomp, he⟩ := Q.property
  let : IsOpenImmersion Q.val.f₂₄.left := hi
  let : Etale Q.val.f₃₄.left := hp
  let : IsClosedImmersion z := hz
  let : IsIso (pullback.snd Q.val.f₃₄.left z) := he
  exact (mayerVietorisSquareOfIsoComplement Q.val hpb z hcomp).isPushout

/-- The ordinary type-valued presheaf square map underlying the discrete construction. -/
def nisnevichPresheafSquareMap (Q : NisnevichSquare S) :
    pushout (CategoryTheory.yoneda.map Q.val.f₁₂) (CategoryTheory.yoneda.map Q.val.f₁₃) ⟶
      CategoryTheory.yoneda.obj Q.val.X₄ :=
  pushout.desc (CategoryTheory.yoneda.map Q.val.f₂₄)
    (CategoryTheory.yoneda.map Q.val.f₃₄)
    (by rw [← Functor.map_comp, ← Functor.map_comp, Q.val.fac])

/-- The actual ordinary square map becomes an isomorphism after Nisnevich sheafification.
This assertion concerns sheaves of types, not local homotopy equivalences. -/
theorem isIso_sheafify_nisnevichPresheafSquareMap (Q : NisnevichSquare S) :
    IsIso ((presheafToSheaf (nisnevichTopology S) (Type u)).map
      (nisnevichPresheafSquareMap Q)) := by
  let L := presheafToSheaf (nisnevichTopology S) (Type u)
  have hsource := (IsPushout.of_hasPushout (CategoryTheory.yoneda.map Q.val.f₁₂)
    (CategoryTheory.yoneda.map Q.val.f₁₃)).map L
  have htarget : IsPushout
      (L.map (CategoryTheory.yoneda.map Q.val.f₁₂))
      (L.map (CategoryTheory.yoneda.map Q.val.f₁₃))
      (L.map (CategoryTheory.yoneda.map Q.val.f₂₄))
      (L.map (CategoryTheory.yoneda.map Q.val.f₃₄)) :=
    nisnevichSquare_isPushout_sheafification Q
  let e := hsource.isoIsPushout _ _ htarget
  have he : L.map (nisnevichPresheafSquareMap Q) = e.hom := by
    apply hsource.hom_ext
    · calc
        L.map (pushout.inl _ _) ≫ L.map (nisnevichPresheafSquareMap Q) =
            L.map (CategoryTheory.yoneda.map Q.val.f₂₄) := by
          rw [← L.map_comp]
          exact congrArg L.map (pushout.inl_desc _ _ _)
        _ = L.map (pushout.inl _ _) ≫ e.hom :=
          (IsPushout.inl_isoIsPushout_hom _ _ hsource htarget).symm
    · calc
        L.map (pushout.inr _ _) ≫ L.map (nisnevichPresheafSquareMap Q) =
            L.map (CategoryTheory.yoneda.map Q.val.f₃₄) := by
          rw [← L.map_comp]
          exact congrArg L.map (pushout.inr_desc _ _ _)
        _ = L.map (pushout.inr _ _) ≫ e.hom :=
          (IsPushout.inr_isoIsPushout_hom _ _ hsource htarget).symm
  change IsIso (L.map (nisnevichPresheafSquareMap Q))
  rw [he]
  infer_instance

end OrdinarySheafification

variable (R : CommRingCat.{u})

/-- The affine-line family uses the owner's literal pointed relative projections. -/
def affineLineProjectionMaps :
    MorphismProperty (PointedSimplicialPresheaf.{u} (SmoothSite (Spec R))) :=
  .ofHoms (affineLineProjection R)

theorem affineLineProjection_mem (U : SmoothSite (Spec R)) :
    affineLineProjectionMaps R (affineLineProjection R U) :=
  MorphismProperty.ofHoms.mk U

theorem affineLineProjectionMaps_iff
    {F G : PointedSimplicialPresheaf.{u} (SmoothSite (Spec R))} (f : F ⟶ G) :
    affineLineProjectionMaps R f ↔ ∃ U : SmoothSite (Spec R),
      Arrow.mk f = Arrow.mk (affineLineProjection R U) :=
  MorphismProperty.ofHoms_iff _ _

/-- The raw geometric generators, before any homotopical closure or localization. -/
def motivicGeneratingMaps :
    MorphismProperty (PointedSimplicialPresheaf.{u} (SmoothSite (Spec R))) :=
  emptyDescentMaps (Spec R) ⊔ nisnevichSquareMaps (Spec R) ⊔ affineLineProjectionMaps R

theorem motivicGeneratingMaps_iff
    {F G : PointedSimplicialPresheaf.{u} (SmoothSite (Spec R))} (f : F ⟶ G) :
    motivicGeneratingMaps R f ↔
      (emptyDescentMaps (Spec R) f ∨ nisnevichSquareMaps (Spec R) f) ∨
        affineLineProjectionMaps R f := Iff.rfl

end AlgebraicGeometry.MotivicHomotopy

