module

public import Colib.AlgebraicGeometry.MotivicHomotopy.EffectiveMotives.Representable
public import Colib.AlgebraicGeometry.MotivicHomotopy.EffectiveMotives.Triangulated
public import Mathlib.CategoryTheory.Triangulated.Generators
import Colib.Util.References

/-!
# Effective geometric motives

Take the thick triangulated subcategory generated by the actual smooth motives in
the bounded-above Nisnevich category. In particular, its inclusion keeps the
original morphisms between singular representatives and their retracts.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry.Scheme

universe u w

namespace AlgebraicGeometry.MotivicHomotopy

variable (k : Type u) [Field k] [PerfectField k]
  [HasDerivedCategory.{w} (SheafWithTransfers.{u + 1} k)]
  [HasExt.{u + 1}
    (Sheaf (SmoothSite.nisnevichTopology (Spec (.of k))) AddCommGrpCat.{u + 1})]

/-- The objects obtained from smooth motives by the finite operations of a thick
triangulated subcategory. -/
def isEffectiveGeometric : ObjectProperty (EffectiveMotivesMinus k) :=
  (ObjectProperty.ofObj (effectiveMotive k).obj).triangEnvelope

instance : (ObjectProperty.ofObj (effectiveMotive k).obj).Nonempty :=
  ObjectProperty.nonempty_of_prop
    (ObjectProperty.ofObj_apply _ (Cor.mk (SmoothSite.base (Spec (.of k)))))

instance : (isEffectiveGeometric k).IsStableUnderRetracts := by
  unfold isEffectiveGeometric
  infer_instance

instance : (isEffectiveGeometric k).IsTriangulated := by
  unfold isEffectiveGeometric
  infer_instance

/-- Effective geometric motives as a full subcategory of the original effective motives. -/
@[colib_tag "COL-1223", colib_ref "Voevodsky2000TriangulatedMotives"
  "Definition 2.1.1 and Theorem 3.2.6"
  "adaptation" "The thick subcategory of the bounded-above effective realization"]
abbrev EffectiveGeometricMotives := (isEffectiveGeometric k).FullSubcategory

/-- The original inclusion of effective geometric motives. -/
abbrev effectiveGeometricMotivesInclusion : EffectiveGeometricMotives k ⥤ EffectiveMotivesMinus k :=
  (isEffectiveGeometric k).ι

/-- The actual singular motive of every smooth scheme is geometric. -/
theorem isEffectiveGeometric_effectiveMotive (X : Cor k) :
    isEffectiveGeometric k ((effectiveMotive k).obj X) :=
  (ObjectProperty.ofObj (effectiveMotive k).obj).le_triangEnvelope _
    (ObjectProperty.ofObj_apply _ X)

/-- The smooth motive functor with values in the effective geometric subcategory. -/
def effectiveGeometricMotive : Cor k ⥤ EffectiveGeometricMotives k :=
  (isEffectiveGeometric k).lift (effectiveMotive k) (isEffectiveGeometric_effectiveMotive k)

/-- A thick triangulated object property contains the effective geometric motives precisely
when it contains every smooth motive. -/
theorem isEffectiveGeometric_le_iff (Q : ObjectProperty (EffectiveMotivesMinus k))
    [Q.IsTriangulated] [Q.IsStableUnderRetracts] :
    isEffectiveGeometric k ≤ Q ↔ ∀ X : Cor k, Q ((effectiveMotive k).obj X) :=
  (ObjectProperty.ofObj (effectiveMotive k).obj).triangEnvelope_le_iff.trans
    (ObjectProperty.ofObj_le_iff _ _)

end AlgebraicGeometry.MotivicHomotopy
