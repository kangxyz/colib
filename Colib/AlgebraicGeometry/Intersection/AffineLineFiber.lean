module

public import Colib.AlgebraicGeometry.Morphisms.Flat.AffineLineComponents
public import Colib.AlgebraicGeometry.Morphisms.ClosedImmersion.IntersectionIdeal
public import StacksFrontier.AlgebraicGeometry.Chow.FibreCycles.CoefficientColength
public import StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.IdealSheafStalk
public import StacksFrontier.RingTheory.Length.RingEquiv
public import Mathlib.RingTheory.Polynomial.Ideal

/-!
# The literal affine-line endpoint cut in the original scheme stalk

The endpoint is `Spec.map (Polynomial.evalRingHom a)`. Its full inverse image
under the parameter morphism has ideal generated by the image of `X - C a`
in the actual structure-sheaf stalk. The quotient is identified by the actual
surjective fiber-inclusion stalk map, with its scalar equation retained.

Flatness of the whole parameter morphism proves that the equation is regular.
The same statement for every native integral component follows from the
one-dimensional Dedekind-base theorem; no flatness of a component over a
higher-dimensional source is inferred.

Adapted from motivic a6805c4a87cdfd7717dd7a94039246a167f15380,
RelativeCurve/Endpoints/FiniteFlatCurveSpecialization.lean, using the pinned
native ideal-sheaf stalk API instead of the source's separate ideal-stalk API.
No correspondence composition or global cycle identity is claimed here.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

open CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme.AffineLineFiber

open Stacks.Chow

variable {k : Type u} [Field k]

/-- The actual rational point of the polynomial affine line. -/
abbrev point (a : k) : Spec (.of k) ⟶ Spec (.of (Polynomial k)) :=
  Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))

instance point_isClosedImmersion (a : k) : IsClosedImmersion (point a) :=
  IsClosedImmersion.spec_of_surjective _ (Polynomial.eval_surjective a)

/-- The global ideal of the actual endpoint is exactly `(X - C a)`. -/
theorem point_ideal (a : k) :
    (point a).ker.ideal ⟨⊤, isAffineOpen_top _⟩ =
      (Ideal.span {Polynomial.X - Polynomial.C a}).map
        (Scheme.ΓSpecIso (.of (Polynomial k))).inv.hom := by
  rw [Scheme.Hom.ker_apply, ← Polynomial.ker_evalRingHom]
  change RingHom.ker (point a).appTop.hom = _
  rw [← RingHom.ker_equiv_comp _ (Scheme.ΓSpecIso (.of k)).commRingCatIsoToRingEquiv]
  change RingHom.ker ((Scheme.ΓSpecIso (.of k)).hom.hom.comp (point a).appTop.hom) = _
  rw [← CommRingCat.hom_comp, Scheme.ΓSpecIso_naturality]
  rw [CommRingCat.hom_comp, ← RingHom.comap_ker]
  exact (Ideal.map_symm
    (Scheme.ΓSpecIso (.of (Polynomial k))).commRingCatIsoToRingEquiv).symm

/-- The polynomial endpoint equation in the actual affine-line stalk. -/
def pointScalar (a : k) (x : Spec (.of (Polynomial k))) :
    (Spec (.of (Polynomial k))).presheaf.stalk x :=
  StructureSheaf.toStalk (Polynomial k) x (Polynomial.X - Polynomial.C a)

/-- The very same equation generates the stalk of the actual endpoint ideal. -/
theorem point_stalk (a : k) (x : Spec (.of (Polynomial k))) :
    IdealSheafData.stalk (point a).ker x = Ideal.span {pointScalar a x} := by
  rw [IdealSheafData.stalk_eq_map_germ (point a).ker x
    ⟨⊤, isAffineOpen_top _⟩ trivial, point_ideal, Ideal.map_map, Ideal.map_span]
  simp only [Set.image_singleton]
  rfl

/-- Localization preserves the nonzero polynomial equation as a nonzerodivisor. -/
theorem pointScalar_regular (a : k) (x : Spec (.of (Polynomial k))) :
    IsSMulRegular ((Spec (.of (Polynomial k))).presheaf.stalk x) (pointScalar a x) := by
  let : Algebra (Polynomial k) ((Spec (.of (Polynomial k))).presheaf.stalk x) :=
    (StructureSheaf.toStalk (Polynomial k) x).hom.toAlgebra
  have : IsLocalization.AtPrime ((Spec (.of (Polynomial k))).presheaf.stalk x)
      x.asIdeal :=
    inferInstanceAs (IsLocalization.AtPrime
      ((Spec.structureSheaf (Polynomial k)).presheaf.stalk x) x.asIdeal)
  have : Module.Flat (Polynomial k) ((Spec (.of (Polynomial k))).presheaf.stalk x) :=
    IsLocalization.flat _ x.asIdeal.primeCompl
  exact (IsSMulRegular.of_ne_zero (M := Polynomial k) (Polynomial.X_sub_C_ne_zero a)).of_flat

variable {D : Scheme.{u}} (f : D ⟶ Spec (.of (Polynomial k))) (a : k)

/-- The whole actual scheme-theoretic endpoint fiber, including its nilpotents. -/
abbrev fiber : Scheme.{u} := pullback (point a) f

/-- The actual inclusion of that whole fiber into the original family. -/
abbrev inclusion : fiber f a ⟶ D := pullback.snd (point a) f

/-- The image of the literal endpoint polynomial under the actual parameter stalk map. -/
def scalar (x : D) : D.presheaf.stalk x :=
  f.stalkMap x (pointScalar a (f x))

/-- The ideal sheaf of the whole endpoint fiber is the actual comap ideal. -/
theorem inclusion_ker : (inclusion f a).ker = (point a).ker.comap f := by
  have he : (pullbackSymmetry (point a) f).hom ≫ pullback.fst f (point a) =
      inclusion f a := by simp [inclusion]
  rw [← he, Scheme.Hom.ker_comp_of_isIso,
    Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]

/-- The original family stalk sees exactly the singleton cut, without a radical. -/
theorem inclusion_stalk (x : D) :
    IdealSheafData.stalk (inclusion f a).ker x = Ideal.span {scalar f a x} := by
  rw [inclusion_ker, IdealSheafData.stalk_comap, point_stalk, Ideal.map_span]
  simp only [Set.image_singleton]
  rfl

/-- At a fiber point the kernel of the actual stalk map is the singleton cut. -/
theorem inclusion_stalkMap_ker (x : fiber f a) :
    RingHom.ker ((inclusion f a).stalkMap x).hom =
      Ideal.span {scalar f a (inclusion f a x)} := by
  rw [ker_stalkMap_eq_idealStalk_ker, inclusion_stalk]

/-- The actual stalk-map quotient, with the original unreduced fiber local ring. -/
def stalkQuotientEquiv (x : fiber f a) :
    (D.presheaf.stalk (inclusion f a x) ⧸
      Ideal.span {scalar f a (inclusion f a x)}) ≃+*
        (fiber f a).presheaf.stalk x :=
  (Ideal.quotEquivOfEq (inclusion_stalkMap_ker f a x).symm).trans
    (RingHom.quotientKerEquivOfSurjective
      (SurjectiveOnStalks.stalkMap_surjective (inclusion f a) x))

/-- Every original scalar maps through the actual fiber-inclusion stalk map. -/
@[simp] theorem stalkQuotientEquiv_mk (x : fiber f a)
    (r : D.presheaf.stalk (inclusion f a x)) :
    stalkQuotientEquiv f a x (Ideal.Quotient.mk _ r) =
      (inclusion f a).stalkMap x r := by
  rfl

/-- The parameter equation is transported by the actual inclusion stalk map. -/
theorem scalar_comp {E : Scheme.{u}} (j : E ⟶ D) (x : E) :
    scalar (j ≫ f) a x = j.stalkMap x (scalar f a (j x)) := by
  simp only [scalar, Scheme.Hom.stalkMap_comp, ConcreteCategory.comp_apply,
    Scheme.Hom.comp_apply]

/-- The equation is preserved by an actual stalk map with an explicitly
specified image point. -/
theorem scalar_stalkMap_of_eq {E : Scheme.{u}} (j : E ⟶ D) (x : E)
    (t : D) (ht : t = j x) :
    (((D.presheaf.stalkCongr (.of_eq ht)).hom ≫ j.stalkMap x).hom)
      (scalar f a t) = scalar (j ≫ f) a x := by
  subst t
  simpa only [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_refl,
    Category.id_comp] using (scalar_comp f a j x).symm

/-- Flatness is used on the family parameter, never on the endpoint map. -/
theorem scalar_regular [Flat f] (x : D) :
    IsSMulRegular (D.presheaf.stalk x) (scalar f a x) := by
  let := (f.stalkMap x).hom.toAlgebra
  have : Module.Flat ((Spec (.of (Polynomial k))).presheaf.stalk (f x))
      (D.presheaf.stalk x) := Flat.stalkMap f x
  exact (pointScalar_regular a (f x)).of_flat

/-- The actual equation belongs to the maximal ideal at every point of the fiber. -/
theorem scalar_mem_maximalIdeal (x : fiber f a) :
    scalar f a (inclusion f a x) ∈
      IsLocalRing.maximalIdeal (D.presheaf.stalk (inclusion f a x)) := by
  have hle := IsLocalRing.le_maximalIdeal
    (RingHom.ker_ne_top ((inclusion f a).stalkMap x).hom)
  rw [inclusion_stalkMap_ker] at hle
  exact hle (Ideal.subset_span (Set.mem_singleton _))

/-- The full quotient length is the actual fiber length, before any truncation. -/
theorem length_stalk_quotient (x : fiber f a) :
    Module.length (D.presheaf.stalk (inclusion f a x))
      (D.presheaf.stalk (inclusion f a x) ⧸
        Ideal.span {scalar f a (inclusion f a x)}) =
      Module.length ((fiber f a).presheaf.stalk x) ((fiber f a).presheaf.stalk x) := by
  rw [Module.length_eq_of_surjective (R := D.presheaf.stalk (inclusion f a x) ⧸
    Ideal.span {scalar f a (inclusion f a x)}) Ideal.Quotient.mk_surjective]
  exact Module.length_eq_of_ringEquiv (stalkQuotientEquiv f a x)

/-- The literal equation is regular on every genuine reduced integral component. -/
theorem component_scalar_regular [Flat f] (z : genericPoints D)
    (x : (integralComponentAt z.val).subscheme) :
    IsSMulRegular ((integralComponentAt z.val).subscheme.presheaf.stalk x)
      (scalar ((integralComponentAt z.val).subschemeι ≫ f) a x) := by
  have := Scheme.Hom.flat_integralComponentAt_to_dedekind f z
  exact scalar_regular _ a x

end AlgebraicGeometry.Scheme.AffineLineFiber
