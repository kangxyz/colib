module

public import Colib.AlgebraicGeometry.Sites.Smooth.Nisnevich.Topology

/-!
# The étale topology on the smooth site

The objects and morphisms are those of the existing `Scheme.SmoothSite S`.
Covering families are jointly surjective families of étale scheme morphisms.
Their pullbacks use the existing cover-specific `SmoothSite.etalePullback`;
no arbitrary pullbacks in the smooth category are assumed.

Nisnevich covers are étale covers on this same category. The resulting
restriction from étale sheaves to Nisnevich sheaves retains the original
presheaf and its morphisms. This supplies the site and restriction map for
change of topology, not an exact inverse-image or a comparison with the full
small étale site of a scheme.

Adapted from `Motivic/Aglib/AlgebraicGeometry/Sites/Smooth/Etale/Topology.lean`
in the motivic source checkpoint of 2026-10-21.
The base is an arbitrary `Scheme.{u}`, and the coefficient category has
independent object and morphism universes. The current consumer is the
Nisnevich-to-étale change of topology on the existing smooth site.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u v w

namespace AlgebraicGeometry.Scheme.SmoothSite

/-- Actual étale covering families on the category of smooth schemes over `S`. -/
def etalePrecoverage (S : Scheme.{u}) : Precoverage (SmoothSite S) :=
  Scheme.etalePrecoverage.comap (forgetScheme S)

/-- The Grothendieck topology generated by actual smooth étale covering families. -/
def etaleTopology (S : Scheme.{u}) : GrothendieckTopology (SmoothSite S) :=
  (etalePrecoverage S).toGrothendieck

variable {S : Scheme.{u}}

/-- Membership is the ordinary big étale covering condition on the original scheme maps. -/
theorem mem_etalePrecoverage_iff {X : SmoothSite S} {R : Presieve X} :
    R ∈ etalePrecoverage S X ↔
      R.map (forgetScheme S) ∈ Scheme.etalePrecoverage X.left := Iff.rfl

/-- Smooth étale covering families are exactly the jointly surjective étale families. -/
@[colib_tag "COL-1028", stacks 0215
  "Etale covering families restricted to smooth separated finite-type schemes over a base"]
theorem ofArrows_mem_etalePrecoverage_iff {X : SmoothSite S} {ι : Type*}
    {Y : ι → SmoothSite S} (f : ∀ i, Y i ⟶ X) :
    Presieve.ofArrows Y f ∈ etalePrecoverage S X ↔
      (∀ i, Etale (f i).left) ∧
        ∀ x : X.left, ∃ (i : ι) (y : (Y i).left), (f i).left y = x := by
  rw [mem_etalePrecoverage_iff, Presieve.map_ofArrows]
  let E : MorphismProperty Scheme.{u} := @Etale
  exact (Scheme.ofArrows_mem_precoverage_iff E
    (f := fun i ↦ (f i).left)).trans and_comm

/-- Each arrow of a smooth étale covering family is étale. -/
theorem etale_of_mem_etalePrecoverage {X Y : SmoothSite S} {R : Presieve X}
    (hR : R ∈ etalePrecoverage S X) {f : Y ⟶ X} (hf : R f) : Etale f.left :=
  (mem_etalePrecoverage_iff.mp hR).2 (Presieve.map_map hf)

instance (S : Scheme.{u}) : (etalePrecoverage S).HasIsos := by
  let E : MorphismProperty Scheme.{u} := @Etale
  let : E.ContainsIdentities := Etale.instIsMultiplicativeScheme.toContainsIdentities
  let : E.IsStableUnderComposition :=
    Etale.instIsMultiplicativeScheme.toIsStableUnderComposition
  let : E.RespectsIso :=
    MorphismProperty.respectsIso_of_isStableUnderComposition (fun _ _ _f _ ↦ inferInstance)
  change ((Scheme.precoverage E).comap (forgetScheme S)).HasIsos
  infer_instance

instance (S : Scheme.{u}) : (etalePrecoverage S).IsStableUnderComposition := by
  let E : MorphismProperty Scheme.{u} := @Etale
  let : E.IsStableUnderComposition :=
    Etale.instIsMultiplicativeScheme.toIsStableUnderComposition
  change ((Scheme.precoverage E).comap (forgetScheme S)).IsStableUnderComposition
  infer_instance

instance (S : Scheme.{u}) : (etalePrecoverage S).HasPullbacks where
  hasPullbacks_of_mem {X Y} {R} f hR := ⟨fun {Y g} hg ↦ by
    have : Etale g.left := etale_of_mem_etalePrecoverage hR hg
    infer_instance⟩

instance (S : Scheme.{u}) : (etalePrecoverage S).IsStableUnderBaseChange where
  mem_coverings_of_isPullback {ι} {W} {V} f hf {Y} g {P} p₁ p₂ h := by
    let E : MorphismProperty Scheme.{u} := @Etale
    let : E.IsStableUnderBaseChange := Etale.etale_isStableUnderBaseChange
    let : Scheme.IsJointlySurjectivePreserving E := Scheme.isJointlySurjectivePreserving E
    rw [mem_etalePrecoverage_iff, Presieve.map_ofArrows]
    change Presieve.ofArrows (fun i ↦ (P i).left) (fun i ↦ (p₁ i).left) ∈
      Scheme.precoverage E Y.left
    apply Precoverage.mem_coverings_of_isPullback (fun i ↦ (f i).left)
      ((Scheme.ofArrows_mem_precoverage_iff E).mpr
        ⟨(ofArrows_mem_etalePrecoverage_iff f).mp hf |>.2,
          (ofArrows_mem_etalePrecoverage_iff f).mp hf |>.1⟩)
      g.left (fun i ↦ (p₁ i).left) (fun i ↦ (p₂ i).left)
    intro i
    have : Etale (f i).left := (ofArrows_mem_etalePrecoverage_iff f).mp hf |>.1 i
    exact ((forgetScheme S).map_isPullback (h i).flip).flip

instance (S : Scheme.{u}) : (etalePrecoverage S).PullbacksPreservedBy (forgetScheme S) where
  preservesPairwisePullbacks_of_mem {X} {R} hR := by
    refine ⟨?_⟩
    intro Y Z f g hf hg
    have := etale_of_mem_etalePrecoverage hR hf
    infer_instance

/-- Restriction of ordinary big étale sheaves to the same smooth schemes is continuous. -/
instance (S : Scheme.{u}) : (forgetScheme S).IsContinuous
    (etaleTopology S) Scheme.etaleTopology := by
  let E : MorphismProperty Scheme.{u} := @Etale
  let : E.IsStableUnderBaseChange := Etale.etale_isStableUnderBaseChange
  let : Scheme.IsJointlySurjectivePreserving E := Scheme.isJointlySurjectivePreserving E
  change (forgetScheme S).IsContinuous (etalePrecoverage S).toGrothendieck
    (Scheme.precoverage E).toGrothendieck
  exact Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy
    (forgetScheme S) (etalePrecoverage S) (Scheme.precoverage E) le_rfl

/-- Covering sieves contain an actual smooth étale covering family. -/
theorem mem_etaleTopology_iff {X : SmoothSite S} {R : Sieve X} :
    R ∈ etaleTopology S X ↔ ∃ Q ∈ etalePrecoverage S X, Q ≤ R :=
  Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition

/-- A Nisnevich covering family is an étale covering family, with its maps unchanged. -/
theorem nisnevichPrecoverage_le_etalePrecoverage (S : Scheme.{u}) :
    nisnevichPrecoverage S ≤ etalePrecoverage S := by
  intro X R hR
  exact mem_etalePrecoverage_iff.mpr
    (Nisnevich.precoverage_le_etalePrecoverage X.left
      (mem_nisnevichPrecoverage_iff.mp hR))

/-- The Nisnevich topology is coarser than the étale topology on the same smooth objects. -/
theorem nisnevichTopology_le_etaleTopology (S : Scheme.{u}) :
    nisnevichTopology S ≤ etaleTopology S :=
  Precoverage.toGrothendieck_mono (nisnevichPrecoverage_le_etalePrecoverage S)

/-- Every Nisnevich covering sieve is étale covering, without changing its arrows. -/
theorem mem_etaleTopology_of_mem_nisnevichTopology {X : SmoothSite S} {R : Sieve X}
    (hR : R ∈ nisnevichTopology S X) : R ∈ etaleTopology S X :=
  nisnevichTopology_le_etaleTopology S X hR

/-- Restriction along the topology refinement retains the original underlying presheaf. -/
def etaleToNisnevichSheaf (S : Scheme.{u}) (A : Type v) [Category.{w} A] :
    Sheaf (etaleTopology S) A ⥤ Sheaf (nisnevichTopology S) A :=
  ObjectProperty.ιOfLE (fun _ h ↦ h.of_le (nisnevichTopology_le_etaleTopology S))

@[simp]
theorem etaleToNisnevichSheaf_obj_obj (S : Scheme.{u}) (A : Type v) [Category.{w} A]
    (F : Sheaf (etaleTopology S) A) :
    ((etaleToNisnevichSheaf S A).obj F).obj = F.obj := rfl

@[simp]
theorem etaleToNisnevichSheaf_map_hom (S : Scheme.{u}) (A : Type v) [Category.{w} A]
    {F G : Sheaf (etaleTopology S) A} (f : F ⟶ G) :
    ((etaleToNisnevichSheaf S A).map f).hom = f.hom := rfl

instance (S : Scheme.{u}) (A : Type v) [Category.{w} A] :
    (etaleToNisnevichSheaf S A).Full := by
  unfold etaleToNisnevichSheaf
  infer_instance

instance (S : Scheme.{u}) (A : Type v) [Category.{w} A] :
    (etaleToNisnevichSheaf S A).Faithful := by
  unfold etaleToNisnevichSheaf
  infer_instance

/-- The underlying-presheaf comparison is the identity, not a replacement equivalence. -/
def etaleToNisnevichSheafCompSheafToPresheafIso (S : Scheme.{u}) (A : Type v)
    [Category.{w} A] :
    etaleToNisnevichSheaf S A ⋙ sheafToPresheaf (nisnevichTopology S) A ≅
      sheafToPresheaf (etaleTopology S) A := Iso.refl _

end AlgebraicGeometry.Scheme.SmoothSite
