module

public import Colib.AlgebraicGeometry.Sites.Smooth.Nisnevich.Topology

/-!
# The Zariski topology on the smooth site

The Zariski families are the jointly surjective families of open immersions
in the actual category of smooth separated finite-type schemes over the base.
The identity functor makes a Nisnevich sheaf into a Zariski sheaf.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u v w

namespace AlgebraicGeometry.Scheme.SmoothSite

/-- Pull back the Zariski covering families along the forgetful functor to schemes. -/
def zariskiPrecoverage (S : Scheme.{u}) : Precoverage (SmoothSite S) :=
  Scheme.zariskiPrecoverage.comap (forgetScheme S)

/-- The Grothendieck topology generated by the smooth Zariski families. -/
def zariskiTopology (S : Scheme.{u}) : GrothendieckTopology (SmoothSite S) :=
  (zariskiPrecoverage S).toGrothendieck

variable {S : Scheme.{u}}

/-- Membership in the smooth Zariski precoverage is the Zariski condition on the underlying maps. -/
theorem mem_zariskiPrecoverage_iff {X : SmoothSite S} {R : Presieve X} :
    R ∈ zariskiPrecoverage S X ↔
      R.map (forgetScheme S) ∈ Scheme.zariskiPrecoverage X.left := Iff.rfl

/-- A family is smooth Zariski covering exactly when it is jointly surjective
and consists of open immersions. -/
theorem ofArrows_mem_zariskiPrecoverage_iff {X : SmoothSite S} {ι : Type*}
    {Y : ι → SmoothSite S} (f : ∀ i, Y i ⟶ X) :
    Presieve.ofArrows Y f ∈ zariskiPrecoverage S X ↔
      (∀ x : X.left, ∃ i, x ∈ Set.range (f i).left) ∧ (∀ i, IsOpenImmersion (f i).left) := by
  rw [mem_zariskiPrecoverage_iff, Presieve.map_ofArrows]
  exact Scheme.ofArrows_mem_precoverage_iff _

/-- A smooth Zariski family is a smooth Nisnevich family with the same arrows. -/
theorem zariskiPrecoverage_le_nisnevichPrecoverage (S : Scheme.{u}) :
    zariskiPrecoverage S ≤ nisnevichPrecoverage S := by
  intro X R hR
  exact mem_nisnevichPrecoverage_iff.mpr
    (Nisnevich.zariskiPrecoverage_le_precoverage X.left
      (mem_zariskiPrecoverage_iff.mp hR))

/-- The Zariski topology is coarser than the Nisnevich topology on the smooth site. -/
theorem zariskiTopology_le_nisnevichTopology (S : Scheme.{u}) :
    zariskiTopology S ≤ nisnevichTopology S :=
  Precoverage.toGrothendieck_mono (zariskiPrecoverage_le_nisnevichPrecoverage S)

instance (S : Scheme.{u}) : (zariskiPrecoverage S).HasIsos := by
  unfold zariskiPrecoverage
  infer_instance

instance (S : Scheme.{u}) : (zariskiPrecoverage S).IsStableUnderComposition := by
  unfold zariskiPrecoverage
  infer_instance

instance (S : Scheme.{u}) : (zariskiPrecoverage S).HasPullbacks where
  hasPullbacks_of_mem f hR :=
    (nisnevichPrecoverage S).hasPullbacks_of_mem f
      (zariskiPrecoverage_le_nisnevichPrecoverage S _ hR)

set_option backward.isDefEq.respectTransparency false in
instance (S : Scheme.{u}) : (zariskiPrecoverage S).IsStableUnderBaseChange where
  mem_coverings_of_isPullback {ι} {W} {V} f hf {Y} g {P} p₁ p₂ h := by
    rw [mem_zariskiPrecoverage_iff, Presieve.map_ofArrows]
    have hf' := mem_zariskiPrecoverage_iff.mp hf
    rw [Presieve.map_ofArrows] at hf'
    apply Precoverage.mem_coverings_of_isPullback (fun i ↦ (f i).left) hf'
      g.left (fun i ↦ (p₁ i).left) (fun i ↦ (p₂ i).left)
    intro i
    have : IsOpenImmersion (f i).left := ((ofArrows_mem_zariskiPrecoverage_iff f).mp hf).2 i
    have : Etale (f i).left := inferInstance
    exact ((forgetScheme S).map_isPullback (h i).flip).flip

/-- Covering sieves contain an actual smooth Zariski family. -/
theorem mem_zariskiTopology_iff {X : SmoothSite S} {R : Sieve X} :
    R ∈ zariskiTopology S X ↔ ∃ Q ∈ zariskiPrecoverage S X, Q ≤ R :=
  Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition

instance (S : Scheme.{u}) :
    (𝟭 (SmoothSite S)).IsContinuous (zariskiTopology S) (nisnevichTopology S) where
  op_comp_isSheaf_of_types G :=
    (isSheaf_iff_isSheaf_of_type _ _).mp (G.property.of_le (zariskiTopology_le_nisnevichTopology S))

/-- Restrict Nisnevich sheaves to the Zariski topology on the same underlying category. -/
def nisnevichToZariskiSheaf (S : Scheme.{u}) (A : Type v) [Category.{w} A] :
    Sheaf (nisnevichTopology S) A ⥤ Sheaf (zariskiTopology S) A :=
  ObjectProperty.ιOfLE (fun _ h ↦ h.of_le (zariskiTopology_le_nisnevichTopology S))

@[simp]
theorem nisnevichToZariskiSheaf_obj_obj (S : Scheme.{u}) (A : Type v) [Category.{w} A]
    (F : Sheaf (nisnevichTopology S) A) :
    ((nisnevichToZariskiSheaf S A).obj F).obj = F.obj := rfl

@[simp]
theorem nisnevichToZariskiSheaf_map_hom (S : Scheme.{u}) (A : Type v) [Category.{w} A]
    {F G : Sheaf (nisnevichTopology S) A} (f : F ⟶ G) :
    ((nisnevichToZariskiSheaf S A).map f).hom = f.hom := rfl

instance (S : Scheme.{u}) (A : Type v) [Category.{w} A] :
    (nisnevichToZariskiSheaf S A).Full := by
  unfold nisnevichToZariskiSheaf
  infer_instance

instance (S : Scheme.{u}) (A : Type v) [Category.{w} A] :
    (nisnevichToZariskiSheaf S A).Faithful := by
  unfold nisnevichToZariskiSheaf
  infer_instance

end AlgebraicGeometry.Scheme.SmoothSite
