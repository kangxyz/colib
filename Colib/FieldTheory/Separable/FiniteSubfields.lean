module

public import Mathlib.FieldTheory.IsSepClosed
public import Mathlib.Algebra.Category.Ring.Colimits
public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.CategoryTheory.Limits.Preserves.Filtered
public import Mathlib.CategoryTheory.Limits.Types.Filtered
public import StacksFrontier.Algebra.Category.CommAlgCat.CoconeOfRingCocone

/-!
# The actual finite subfields of a separable extension

The intermediate fields generated by finite subsets form a small filtered diagram with the
original field inclusions as maps. Its colimit is the given extension field. For a separable
extension, every stage is finite and separable over the original base, including a finite base.

The colimit proof adapts the native `CommRingCat.finiteSubalgebrasIsColimit` proof from
`StacksFrontier/Algebra/Category/Ring/FiniteSubalgebras.lean`, replacing finitely generated
integer subalgebras by the actual intermediate fields generated over the given field.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace IntermediateField

variable (K L : Type u) [Field K] [Field L] [Algebra K L]

/-- The actual subfields generated by finite subsets, with their original inclusion maps. -/
def finsetAdjoinDiagram : Finset L ⥤ CommRingCat.{u} where
  obj s := .of (adjoin K (s : Set L))
  map h := CommRingCat.ofHom
    (inclusion (adjoin.mono K _ _ (Finset.coe_subset.mpr (leOfHom h)))).toRingHom

/-- The actual inclusion cocone has the given extension field as its vertex. -/
def finsetAdjoinCocone : Cocone (finsetAdjoinDiagram K L) where
  pt := .of L
  ι := { app := fun s ↦ CommRingCat.ofHom (adjoin K (s : Set L)).val.toRingHom }

/-- These actual finite-generated subfields exhaust the given extension, with no replacement
of its elements or field embeddings. -/
def finsetAdjoinIsColimit : IsColimit (finsetAdjoinCocone K L) := by
  classical
  let := reflectsColimit_of_reflectsIsomorphisms
    (finsetAdjoinDiagram K L) (forget CommRingCat)
  exact isColimitOfReflects (forget CommRingCat) (Types.FilteredColimit.isColimitOf' _ _
    (fun x ↦ ⟨{x}, ⟨x, subset_adjoin K _ (Finset.mem_singleton_self x)⟩, rfl⟩)
    fun i x y h ↦ ⟨i, 𝟙 i, congrArg _ (Subtype.ext h)⟩)

/-- A separable extension has finite stages in this exact diagram. -/
theorem finite_finsetAdjoinDiagram_obj [Algebra.IsSeparable K L] (s : Finset L) :
    Module.Finite K (adjoin K (s : Set L)) :=
  finiteDimensional_adjoin fun x _ ↦ Algebra.IsSeparable.isIntegral K x

/-- Every stage retains separability over the original base field. -/
theorem isSeparable_finsetAdjoinDiagram_obj [Algebra.IsSeparable K L] (s : Finset L) :
    Algebra.IsSeparable K (adjoin K (s : Set L)) :=
  inferInstance

/-- The cocone legs retain the original base-field scalar map exactly. -/
theorem finsetAdjoinCocone_app_comp_algebraMap (s : Finset L) :
    ((finsetAdjoinCocone K L).ι.app s).hom.comp
        (algebraMap K (adjoin K (s : Set L))) = algebraMap K L :=
  (adjoin K (s : Set L)).val.comp_algebraMap

/-- The same original subfields and inclusions, retaining their base-field algebra structures. -/
def finsetAdjoinAlgebraDiagram : Finset L ⥤ CommAlgCat.{u} K where
  obj s := .of K (adjoin K (s : Set L))
  map h := CommAlgCat.ofHom
    (inclusion (adjoin.mono K _ _ (Finset.coe_subset.mpr (leOfHom h))))

/-- The original inclusion cocone in algebras over the base field. -/
def finsetAdjoinAlgebraCocone : Cocone (finsetAdjoinAlgebraDiagram K L) where
  pt := .of K L
  ι := { app := fun s ↦ CommAlgCat.ofHom (adjoin K (s : Set L)).val }

/-- The same actual field is also the colimit in base-field algebras. -/
def finsetAdjoinAlgebraIsColimit : IsColimit (finsetAdjoinAlgebraCocone K L) := by
  let := reflectsColimit_of_reflectsIsomorphisms
    (finsetAdjoinAlgebraDiagram K L) (forget₂ (CommAlgCat.{u} K) CommRingCat.{u})
  exact isColimitOfReflects (forget₂ (CommAlgCat.{u} K) CommRingCat.{u})
    (finsetAdjoinIsColimit K L)

end IntermediateField
