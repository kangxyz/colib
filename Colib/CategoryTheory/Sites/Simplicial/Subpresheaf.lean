module

public import Mathlib.AlgebraicTopology.SimplicialSet.Basic
public import Mathlib.CategoryTheory.Functor.Currying
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Basic
public import Mathlib.CategoryTheory.Subfunctor.Image
public import StacksFrontier.CategoryTheory.Sites.UniverseBridge.FinsetGeneratedSubfunctor

/-!
# Simplicial subpresheaves

A simplicial subpresheaf is the native subfunctor of the uncurried
presheaf. Currying retains the original componentwise inclusion and
restriction maps. The same subfunctor lattice records unions and
pullbacks of subpresheaves.
-/

@[expose] public section

open CategoryTheory Opposite Stacks.Sites.UniverseBridge
universe w v u

namespace CategoryTheory.SimplicialSubpresheaf

variable {C : Type u} [Category.{v} C]

/-- The native subfunctor of the uncurried simplicial presheaf. -/
abbrev Subpresheaf (P : Cᵒᵖ ⥤ SSet.{w}) := Subfunctor (Functor.uncurry.obj P)

variable {P : Cᵒᵖ ⥤ SSet.{w}}

/-- Recover the simplicial presheaf with the restricted section sets. -/
abbrev toPresheaf (A : Subpresheaf P) : Cᵒᵖ ⥤ SSet.{w} :=
  Functor.curry.obj A.toFunctor

/-- The actual inclusion of the restricted sections. -/
def inclusion (A : Subpresheaf P) : toPresheaf A ⟶ P :=
  Functor.curry.map A.ι ≫ (Functor.currying.unitIso.app P).inv

@[simp]
theorem inclusion_app_app (A : Subpresheaf P) (U : Cᵒᵖ) (n : SimplexCategoryᵒᵖ)
    (s : A.obj (U, n)) :
    ((inclusion A).app U).app n s = s.val := rfl

instance inclusion_mono (A : Subpresheaf P) : Mono (inclusion A) := by
  let E : (Cᵒᵖ ⥤ SimplexCategoryᵒᵖ ⥤ Type w) ≌
      ((Cᵒᵖ × SimplexCategoryᵒᵖ) ⥤ Type w) := Functor.currying
  let : Mono (E.inverse.map A.ι) := E.inverse.map_mono A.ι
  change Mono (E.inverse.map A.ι ≫ (E.unitIso.app P).inv)
  infer_instance

/-- Containment induces the actual inclusion of simplicial subpresheaves. -/
def homOfLE {A B : Subpresheaf P} (h : A ≤ B) : toPresheaf A ⟶ toPresheaf B :=
  Functor.curry.map (Subfunctor.homOfLe h)

@[reassoc (attr := simp)]
theorem homOfLE_inclusion {A B : Subpresheaf P} (h : A ≤ B) :
    homOfLE h ≫ inclusion B = inclusion A := by
  unfold homOfLE inclusion
  rw [← Functor.map_comp_assoc, Subfunctor.homOfLe_ι]

/-- Factor an actual map through a subpresheaf containing its image. -/
def lift {Q : Cᵒᵖ ⥤ SSet.{w}} (f : Q ⟶ P) {A : Subpresheaf P}
    (h : Subfunctor.range (Functor.uncurry.map f) ≤ A) : Q ⟶ toPresheaf A :=
  (Functor.currying.unitIso.app Q).hom ≫
    Functor.curry.map (Subfunctor.lift (Functor.uncurry.map f) h)

@[reassoc (attr := simp)]
theorem lift_inclusion {Q : Cᵒᵖ ⥤ SSet.{w}} (f : Q ⟶ P) {A : Subpresheaf P}
    (h : Subfunctor.range (Functor.uncurry.map f) ≤ A) :
    lift f h ≫ inclusion A = f := by
  let e : (Cᵒᵖ ⥤ SimplexCategoryᵒᵖ ⥤ Type w) ≌
      ((Cᵒᵖ × SimplexCategoryᵒᵖ) ⥤ Type w) := Functor.currying
  change (e.unitIso.app Q).hom ≫
      e.inverse.map (Subfunctor.lift (e.functor.map f) h) ≫ e.inverse.map A.ι ≫
        (e.unitIso.app P).inv = f
  rw [← Functor.map_comp_assoc, Subfunctor.lift_ι]
  have he : f ≫ (e.unitIso.app P).hom =
      (e.unitIso.app Q).hom ≫ e.inverse.map (e.functor.map f) := e.unitIso.hom.naturality f
  rw [← Category.assoc, ← he, Category.assoc, Iso.hom_inv_id, Category.comp_id]

/-- The subpresheaf generated by all the simplices in one actual map to a
presheaf value. -/
abbrev generatedByMap {K : SSet.{w}} {U : Cᵒᵖ} (g : K ⟶ P.obj U) : Subpresheaf P :=
  ⨆ s : Σ n : SimplexCategoryᵒᵖ, K.obj n,
    ofSectionGen (P := Functor.uncurry.obj P) (X := (U, s.1)) (g.app s.1 s.2)

/-- The map of simplicial sets lands in the original section sets of the
generated subpresheaf. -/
def factorThroughGeneratedByMap {K : SSet.{w}} {U : Cᵒᵖ} (g : K ⟶ P.obj U) :
    K ⟶ (toPresheaf (generatedByMap g)).obj U where
  app n := ↾fun x => ⟨g.app n x, by
    have h : ofSectionGen (P := Functor.uncurry.obj P) (X := (U, n)) (g.app n x) ≤
        generatedByMap g :=
      le_iSup (fun s : Σ m : SimplexCategoryᵒᵖ, K.obj m =>
        ofSectionGen (P := Functor.uncurry.obj P) (X := (U, s.1)) (g.app s.1 s.2)) ⟨n, x⟩
    exact h (U, n)
      (mem_ofSectionGen_self (P := Functor.uncurry.obj P) (X := (U, n)) (g.app n x))⟩
  naturality n m h := by
    apply ConcreteCategory.hom_ext
    intro x
    apply Subtype.ext
    let a : (U, n) ⟶ (U, m) := (𝟙 U, h)
    change g.app m (K.map h x) = (Functor.uncurry.obj P).map a (g.app n x)
    have ha : (Functor.uncurry.obj P).map a = (P.obj U).map h := by
      change (P.map (𝟙 U)).app n ≫ (P.obj U).map h = (P.obj U).map h
      rw [P.map_id, NatTrans.id_app, Category.id_comp]
    rw [ha]
    simpa only [types_comp_apply] using ConcreteCategory.congr_hom (g.naturality h) x

@[reassoc (attr := simp)]
theorem factorThroughGeneratedByMap_inclusion {K : SSet.{w}} {U : Cᵒᵖ}
    (g : K ⟶ P.obj U) :
    factorThroughGeneratedByMap g ≫ (inclusion (generatedByMap g)).app U = g := by
  ext n x
  rfl

/-- The inverse image of a simplicial subpresheaf uses the original
section maps. -/
abbrev preimage {Q : Cᵒᵖ ⥤ SSet.{w}} (A : Subpresheaf P) (f : Q ⟶ P) : Subpresheaf Q :=
  A.preimage (Functor.uncurry.map f)

/-- The actual map from the inverse image to the subpresheaf. -/
def preimageMap {Q : Cᵒᵖ ⥤ SSet.{w}} (A : Subpresheaf P) (f : Q ⟶ P) :
    toPresheaf (preimage A f) ⟶ toPresheaf A :=
  lift (inclusion (preimage A f) ≫ f) (by
    rintro q _ ⟨s, rfl⟩
    exact s.property)

@[reassoc (attr := simp)]
theorem preimageMap_inclusion {Q : Cᵒᵖ ⥤ SSet.{w}} (A : Subpresheaf P) (f : Q ⟶ P) :
    preimageMap A f ≫ inclusion A = inclusion (preimage A f) ≫ f := lift_inclusion _ _

/-- The literal inverse image square of simplicial subpresheaves is Cartesian. -/
theorem preimage_isPullback {Q : Cᵒᵖ ⥤ SSet.{w}} (A : Subpresheaf P) (f : Q ⟶ P) :
    IsPullback (preimageMap A f) (inclusion (preimage A f)) (inclusion A) f := by
  refine IsPullback.mk' (preimageMap_inclusion A f)
    (fun _ _ _ _ e => (cancel_mono (inclusion (preimage A f))).1 e) ?_
  intro T a b h
  have hb : Subfunctor.range (Functor.uncurry.map b) ≤ preimage A f := by
    rintro ⟨U, n⟩ _ ⟨s, rfl⟩
    have he := ConcreteCategory.congr_hom (congr_app (congr_app h U) n) s
    change ((a.app U).app n s).val = (f.app U).app n ((b.app U).app n s) at he
    change (f.app U).app n ((b.app U).app n s) ∈ A.obj (U, n)
    rw [← he]
    exact ((a.app U).app n s).property
  refine ⟨lift b hb, ?_, lift_inclusion b hb⟩
  apply (cancel_mono (inclusion A)).1
  rw [Category.assoc, preimageMap_inclusion, ← Category.assoc, lift_inclusion, h]

end CategoryTheory.SimplicialSubpresheaf
