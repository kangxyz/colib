module

public import Colib.CategoryTheory.Sites.Simplicial.BoundedTrivialPreimage
public import Colib.CategoryTheory.Sites.Simplicial.ConservativeWeakEquivalence
import Colib.Topology.Realization.MorphismProperty

/-!
# A bounded weak intersection containing a given section

For an inclusion into an actual simplicial presheaf, start with the
subpresheaf generated by one chosen section and use bounded enlargement.
The resulting intersection with the original subpresheaf is weak on all
site fibers.
-/

@[expose] public noncomputable section

open CategoryTheory Opposite Stacks.Sites.UniverseBridge

universe v u

namespace CategoryTheory.SimplicialSubpresheaf

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {Q : Cᵒᵖ ⥤ SSet.{max u v}}

/-- One uncountable regular cardinal in the site universe bounds the
small point family, its fibers, and the original restriction arrows. -/
theorem exists_regular_cardinal_bounds
    {F : ObjectProperty (J.Point.{max u v})} [ObjectProperty.Small.{max u v} F] :
    ∃ (κ : Cardinal.{max u v}) (_ : Fact κ.IsRegular), Cardinal.aleph0 < κ ∧
      HasCardinalLT F.FullSubcategory κ ∧
      (∀ q : Cᵒᵖ × SimplexCategoryᵒᵖ,
        HasCardinalLT (Σ r : Cᵒᵖ × SimplexCategoryᵒᵖ, q ⟶ r) κ) ∧
      ∀ ψ : F.FullSubcategory, ∀ U : C, HasCardinalLT (ψ.obj.fiber.obj U) κ := by
  let T := ℕ ⊕ (Shrink.{max u v} F.FullSubcategory ⊕
    ((Σ q : Cᵒᵖ × SimplexCategoryᵒᵖ, Σ r : Cᵒᵖ × SimplexCategoryᵒᵖ, q ⟶ r) ⊕
      (Σ ψ : Shrink.{max u v} F.FullSubcategory, Σ U : C,
        ((equivShrink.{max u v} F.FullSubcategory).symm ψ).obj.fiber.obj U)))
  obtain ⟨κ, hκ, hT⟩ := HasCardinalLT.exists_regular_cardinal.{max u v} T
  refine ⟨κ, ⟨hκ⟩, ?_, ?_, ?_, ?_⟩
  · have hn : HasCardinalLT ℕ κ := hT.of_injective Sum.inl Sum.inl_injective
    simpa only [HasCardinalLT, Cardinal.mk_nat, Cardinal.lift_aleph0,
      Cardinal.lift_id'.{0, max u v}] using hn
  · exact hT.of_injective (fun ψ => Sum.inr (Sum.inl (equivShrink.{max u v} _ ψ)))
      (Sum.inr_injective.comp (Sum.inl_injective.comp (equivShrink.{max u v} _).injective))
  · intro q
    exact hT.of_injective (fun s => Sum.inr (Sum.inr (Sum.inl ⟨q, s⟩)))
      (Sum.inr_injective.comp (Sum.inr_injective.comp
        (Sum.inl_injective.comp sigma_mk_injective)))
  · intro ψ U
    let e := equivShrink.{max u v} F.FullSubcategory
    have h : HasCardinalLT ((e.symm (e ψ)).obj.fiber.obj U) κ :=
      hT.of_injective (fun s => Sum.inr (Sum.inr (Sum.inr ⟨e ψ, U, s⟩)))
        (Sum.inr_injective.comp (Sum.inr_injective.comp
          (Sum.inr_injective.comp (sigma_mk_injective.comp sigma_mk_injective))))
    simpa only [Equiv.symm_apply_apply] using h

private theorem preimage_inclusion_iso_inf (A D : Subpresheaf Q) :
    ∃ e : toPresheaf (preimage D (inclusion A)) ≅ toPresheaf (A ⊓ D),
      e.hom ≫ homOfLE (inf_le_right : A ⊓ D ≤ D) = preimageMap D (inclusion A) := by
  let a : toPresheaf (preimage D (inclusion A)) ⟶ Q :=
    inclusion (preimage D (inclusion A)) ≫ inclusion A
  let f : toPresheaf (preimage D (inclusion A)) ⟶ toPresheaf (A ⊓ D) := lift a (by
    rintro q _ ⟨s, rfl⟩
    exact ⟨s.val.property, s.property⟩)
  let g : toPresheaf (A ⊓ D) ⟶ toPresheaf (preimage D (inclusion A)) :=
    (preimage_isPullback D (inclusion A)).lift (homOfLE inf_le_right)
      (homOfLE inf_le_left) (by simp only [homOfLE_inclusion])
  have hg : g ≫ a = inclusion (A ⊓ D) := by
    dsimp only [a, g]
    rw [← Category.assoc, IsPullback.lift_snd, homOfLE_inclusion]
  have hf : f ≫ inclusion (A ⊓ D) = a := lift_inclusion _ _
  let : Mono a := inferInstanceAs (Mono (inclusion _ ≫ inclusion A))
  let e : toPresheaf (preimage D (inclusion A)) ≅ toPresheaf (A ⊓ D) := {
    hom := f
    inv := g
    hom_inv_id := (cancel_mono a).1 (by rw [Category.assoc, hg, hf, Category.id_comp])
    inv_hom_id := (cancel_mono (inclusion (A ⊓ D))).1
      (by rw [Category.assoc, hf, hg, Category.id_comp]) }
  refine ⟨e, (cancel_mono (inclusion D)).1 ?_⟩
  change (f ≫ homOfLE (inf_le_right : A ⊓ D ≤ D)) ≫ inclusion D = _
  rw [Category.assoc, homOfLE_inclusion, preimageMap_inclusion]
  exact hf

/-- Enlarge one specified section to a bounded subpresheaf whose
intersection with a given weak inclusion remains weak at every point. -/
theorem exists_bounded_weak_intersection
    {F : ObjectProperty (J.Point.{max u v})} [ObjectProperty.Small.{max u v} F]
    (hF : F.IsConservativeFamilyOfPoints) (A : Subpresheaf Q)
    (hA : ∀ Φ : J.Point.{max u v},
      SSet.IsRealizationWeakEquivalence (Φ.presheafFiber.map (inclusion A)))
    (κ : Cardinal.{max u v}) [Fact κ.IsRegular] (hκ : Cardinal.aleph0 < κ)
    (hFκ : HasCardinalLT F.FullSubcategory κ)
    (hC : ∀ q : Cᵒᵖ × SimplexCategoryᵒᵖ,
      HasCardinalLT (Σ r : Cᵒᵖ × SimplexCategoryᵒᵖ, q ⟶ r) κ)
    (hPoint : ∀ ψ : F.FullSubcategory, ∀ U : C, HasCardinalLT (ψ.obj.fiber.obj U) κ)
    {q : Cᵒᵖ × SimplexCategoryᵒᵖ} (s : (Functor.uncurry.obj Q).obj q) :
    ∃ D : Subpresheaf Q, s ∈ D.obj q ∧ HasBoundedSections D κ ∧
      ∀ Φ : J.Point.{max u v}, SSet.IsRealizationWeakEquivalence
        (Φ.presheafFiber.map (homOfLE (inf_le_right : A ⊓ D ≤ D))) := by
  let S : Subpresheaf Q := ofSectionGen s
  have hS : HasBoundedSections S κ := Subfunctor.hasCardinalLT_totalSections_ofSectionGen s κ (hC q)
  obtain ⟨D, hSD, hD, h⟩ := exists_bounded_trivial_preimage (inclusion A)
    (fun ψ : F.FullSubcategory => ψ.obj) S (fun ψ => hA ψ.obj) κ hκ hFκ hS hC hPoint
  refine ⟨D, hSD q (mem_ofSectionGen_self s), hD, ?_⟩
  have h' :=
    GrothendieckTopology.Point.isRealizationWeakEquivalence_presheafFiber_of_conservativeFamily
      (preimageMap D (inclusion A)) hF h
  obtain ⟨e, hw⟩ := preimage_inclusion_iso_inf A D
  intro Φ
  let E := Φ.presheafFiber (A := SSet.{max u v})
  let : IsIso (E.map e.hom) := inferInstance
  have hh : SSet.IsRealizationWeakEquivalence (E.map e.hom ≫
      E.map (homOfLE (inf_le_right : A ⊓ D ≤ D))) := by
    rw [← Functor.map_comp, hw]
    exact h' Φ
  exact hh.of_comp_left (SSet.IsRealizationWeakEquivalence.of_isIso _)

end CategoryTheory.SimplicialSubpresheaf
