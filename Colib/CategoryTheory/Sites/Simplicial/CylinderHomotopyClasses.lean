module

public import Colib.CategoryTheory.Sites.Simplicial.SmashHomotopy
public import Mathlib.Logic.Relation
import Mathlib.Data.Quot

/-!
# Homotopy classes for the pointed simplicial cylinder

The equivalence relation generated by the actual cylinder homotopies is
inverted by the stalkwise localization. The smash adjunction preserves
the relation and gives an equivalence on these classes.
-/

@[expose] public noncomputable section

open CategoryTheory

universe w v u

namespace CategoryTheory.PointedSimplicialPresheaf

variable {C : Type u} [Category.{v} C]

/-- The equivalence relation generated by elementary cylinder homotopies. -/
def cylinderHomotopySetoid (X Y : PointedSimplicialPresheaf.{w} C) : Setoid (X ⟶ Y) :=
  Relation.EqvGen.setoid CylinderHomotopic

/-- Pointed homotopy classes for the actual simplicial cylinder. -/
abbrev CylinderHomotopyClasses (X Y : PointedSimplicialPresheaf.{w} C) :=
  _root_.Quotient (cylinderHomotopySetoid X Y)

variable [LocallySmall.{w} C] (J : GrothendieckTopology C)

/-- The actual stalkwise localization identifies the endpoints of each
cylinder homotopy and hence maps out of the quotient by these homotopies. -/
def cylinderHomotopyClassToStalkwiseHom (X Y : PointedSimplicialPresheaf.{w} C) :
    CylinderHomotopyClasses X Y →
      ((toStalkwiseHomotopyCategory C J).obj X ⟶ (toStalkwiseHomotopyCategory C J).obj Y) :=
  _root_.Quotient.lift (fun f : X ⟶ Y ↦ (toStalkwiseHomotopyCategory C J).map f) (by
    intro f g h
    change Relation.EqvGen CylinderHomotopic f g at h
    induction h with
    | rel f g h =>
      obtain ⟨H, rfl, rfl⟩ := h
      exact toStalkwiseHomotopyCategory_map_of_simplicialCylinder C J H 0 1
    | refl => rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ih ih' => exact ih.trans ih')

private theorem eqvGen_preserved {α β : Type*} {r : α → α → Prop} {s : β → β → Prop}
    (f : α → β) (h : ∀ a b, r a b → s (f a) (f b)) {a b : α}
    (hab : Relation.EqvGen r a b) : Relation.EqvGen s (f a) (f b) := by
  induction hab with
  | rel a b hab => exact Relation.EqvGen.rel _ _ (h a b hab)
  | refl => exact Relation.EqvGen.refl _
  | symm _ _ _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans _ _ _ _ _ ih ih' => exact Relation.EqvGen.trans _ _ _ ih ih'

/-- Transposition through the actual smash adjunction gives an
equivalence on the classes of elementary cylinder homotopies. -/
@[no_expose]
def smashAdjunctionCylinderHomotopyEquiv
    (T : PointedSimplicialPresheaf.{w} C)
    {G : PointedSimplicialPresheaf.{w} C ⥤ PointedSimplicialPresheaf.{w} C}
    (adj : Under.smashRightFunctor T ⊣ G) (X Y : PointedSimplicialPresheaf.{w} C) :
    CylinderHomotopyClasses ((Under.smashRightFunctor T).obj X) Y ≃
      CylinderHomotopyClasses X (G.obj Y) := by
  let e := adj.homEquiv X Y
  have h : ∀ f g, CylinderHomotopic f g → CylinderHomotopic (e.symm f) (e.symm g) := by
    intro f g hfg
    apply (cylinderHomotopic_homEquiv_iff T adj (e.symm f) (e.symm g)).1
    change CylinderHomotopic (e (e.symm f)) (e (e.symm g))
    rw [e.apply_symm_apply, e.apply_symm_apply]
    exact hfg
  refine
    { toFun := _root_.Quotient.map e (fun {_ _} h ↦ eqvGen_preserved e
        (fun f g hf ↦ (cylinderHomotopic_homEquiv_iff T adj f g).2 hf) h)
      invFun := _root_.Quotient.map e.symm (fun {_ _} hfg ↦ eqvGen_preserved e.symm h hfg)
      left_inv := ?_
      right_inv := ?_ }
  · intro f
    refine _root_.Quotient.inductionOn f (fun g ↦ ?_)
    change _root_.Quotient.mk _ (e.symm (e g)) = _root_.Quotient.mk _ g
    exact congrArg (_root_.Quotient.mk _) (e.symm_apply_apply g)
  · intro f
    refine _root_.Quotient.inductionOn f (fun g ↦ ?_)
    change _root_.Quotient.mk _ (e (e.symm g)) = _root_.Quotient.mk _ g
    exact congrArg (_root_.Quotient.mk _) (e.apply_symm_apply g)

omit [LocallySmall.{w} C] in
/-- The equivalence transposes a strict representative using the original adjunction. -/
theorem smashAdjunctionCylinderHomotopyEquiv_mk
    (T : PointedSimplicialPresheaf.{w} C)
    {G : PointedSimplicialPresheaf.{w} C ⥤ PointedSimplicialPresheaf.{w} C}
    (adj : Under.smashRightFunctor T ⊣ G) {X Y : PointedSimplicialPresheaf.{w} C}
    (f : (Under.smashRightFunctor T).obj X ⟶ Y) :
    smashAdjunctionCylinderHomotopyEquiv T adj X Y (_root_.Quotient.mk _ f) =
      _root_.Quotient.mk _ (adj.homEquiv X Y f) := by
  unfold smashAdjunctionCylinderHomotopyEquiv
  rfl

end CategoryTheory.PointedSimplicialPresheaf
