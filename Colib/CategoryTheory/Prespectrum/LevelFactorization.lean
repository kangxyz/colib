module

public import Colib.CategoryTheory.Prespectrum.LevelLifting
public import Mathlib.CategoryTheory.SmallObject.Basic
public import Mathlib.AlgebraicTopology.ModelCategory.CategoryWithCofibrations
public import Mathlib.CategoryTheory.MorphismProperty.WeakFactorizationSystem

/-!
# Levelwise generated factorization of sequential prespectra

For a family of maps in the base category, the right class is given by the
corresponding levelwise right lifting property. If the free images of that
family admit the small object argument, they give a functorial factorization
and a weak factorization system. In particular the left class consists of
retracts of relative free-cell complexes. No model structure or smallness
hypothesis is asserted here.
-/

@[expose] public noncomputable section

open CategoryTheory.Limits

universe w v u

namespace CategoryTheory.SequentialPrespectrum

variable {C : Type u} [Category.{v} C] {S : C ⥤ C}
variable [HasInitial C] [PreservesColimit (Functor.empty.{0} C) S]

/-- A morphism property holds at every level of a prespectrum map. -/
def levelwise (P : MorphismProperty C) : MorphismProperty (SequentialPrespectrum S) :=
  fun _ _ f ↦ ∀ n, P (f.app n)

/-- The right class generated by all free images is the levelwise right class. -/
theorem freeAtMaps_rlp_eq_levelwise {ι : Type w} {A B : ι → C}
    (i : ∀ a, A a ⟶ B a) :
    (freeAtMaps (S := S) i).rlp = levelwise (MorphismProperty.ofHoms i).rlp := by
  ext X Y f
  exact freeAtMaps_rlp_iff i f

variable {ι : Type w} {A B : ι → C} (i : ∀ a, A a ⟶ B a)
variable [(freeAtMaps (S := S) i).HasSmallObjectArgument.{w}]

/-- Under the small object hypothesis, the levelwise right class admits a
functorial factorization with its left lifting class. -/
theorem levelwise_hasFunctorialFactorization :
    MorphismProperty.HasFunctorialFactorization
      (levelwise (S := S) (MorphismProperty.ofHoms i).rlp).llp
      (levelwise (S := S) (MorphismProperty.ofHoms i).rlp) := by
  rw [← freeAtMaps_rlp_eq_levelwise i]
  infer_instance

/-- The same factorization and lifting classes form a weak factorization system. -/
theorem levelwise_isWeakFactorizationSystem :
    MorphismProperty.IsWeakFactorizationSystem
      (levelwise (S := S) (MorphismProperty.ofHoms i).rlp).llp
      (levelwise (S := S) (MorphismProperty.ofHoms i).rlp) := by
  let P := levelwise (S := S) (MorphismProperty.ofHoms i).rlp
  have : MorphismProperty.HasFunctorialFactorization P.llp P :=
    levelwise_hasFunctorialFactorization i
  refine { rlp := ?_, llp := rfl, hasFactorization := inferInstance }
  rw [← freeAtMaps_rlp_eq_levelwise i, MorphismProperty.rlp_llp_rlp]

/-- The left class is precisely the retract closure of transfinite compositions
of pushouts of coproducts of the free generating maps. -/
theorem levelwise_llp_eq_retracts :
    (levelwise (S := S) (MorphismProperty.ofHoms i).rlp).llp =
      (MorphismProperty.transfiniteCompositions.{w}
        (MorphismProperty.coproducts.{w} (freeAtMaps (S := S) i)).pushouts).retracts := by
  rw [← freeAtMaps_rlp_eq_levelwise i]
  exact (freeAtMaps (S := S) i).llp_rlp_of_hasSmallObjectArgument

/-- If the given maps generate the base fibrations, the factorization has
levelwise fibrations as its right class. -/
theorem levelFibrations_hasFunctorialFactorization
    [HomotopicalAlgebra.CategoryWithFibrations C]
    (hi : (MorphismProperty.ofHoms i).rlp = HomotopicalAlgebra.fibrations C) :
    MorphismProperty.HasFunctorialFactorization
      (levelwise (S := S) (HomotopicalAlgebra.fibrations C)).llp
      (levelwise (S := S) (HomotopicalAlgebra.fibrations C)) := by
  rw [← hi]
  exact levelwise_hasFunctorialFactorization i

/-- If the given maps generate the base trivial fibrations, the projective
cofibration and levelwise trivial fibration classes admit functorial factorization. -/
theorem levelTrivialFibrations_hasFunctorialFactorization
    [HomotopicalAlgebra.CategoryWithFibrations C]
    [HomotopicalAlgebra.CategoryWithWeakEquivalences C]
    (hi : (MorphismProperty.ofHoms i).rlp = HomotopicalAlgebra.trivialFibrations C) :
    MorphismProperty.HasFunctorialFactorization
      (levelwise (S := S) (HomotopicalAlgebra.trivialFibrations C)).llp
      (levelwise (S := S) (HomotopicalAlgebra.trivialFibrations C)) := by
  rw [← hi]
  exact levelwise_hasFunctorialFactorization i

end CategoryTheory.SequentialPrespectrum
