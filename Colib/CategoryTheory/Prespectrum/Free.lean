module

public import Colib.CategoryTheory.Prespectrum.Suspension
public import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Terminal

/-!
# Free sequential prespectra in a specified degree

The left adjoint to evaluation is obtained by inserting initial levels
before the suspension prespectrum. The stable comparison moves the
suspended generator back by one degree.
-/

@[expose] public noncomputable section

open CategoryTheory.Limits

universe v u

namespace CategoryTheory.SequentialPrespectrum

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false

variable {C : Type u} [Category.{v} C] {S : C ⥤ C}

/-- Drop degree zero and keep the original remaining bonding maps. -/
@[simps]
def tail : SequentialPrespectrum S ⥤ SequentialPrespectrum S where
  obj X := ⟨fun n ↦ X.level (n + 1), fun n ↦ X.bonding (n + 1)⟩
  map f := ⟨fun n ↦ f.app (n + 1), fun n ↦ f.comm (n + 1)⟩

variable [HasInitial C]

/-- Insert one initial level before a prespectrum. -/
@[no_expose]
def prependInitial (S : C ⥤ C) [PreservesColimit (Functor.empty.{0} C) S] :
    SequentialPrespectrum S ⥤ SequentialPrespectrum S where
  obj X :=
    { level
        | 0 => ⊥_ C
        | n + 1 => X.level n
      bonding
        | 0 => (isColimitOfHasInitialOfPreservesColimit S).to (X.level 0)
        | n + 1 => X.bonding n }
  map f :=
    { app
        | 0 => 𝟙 _
        | n + 1 => f.app n
      comm
        | 0 => (isColimitOfHasInitialOfPreservesColimit S).hom_ext _ _
        | n + 1 => f.comm n }
  map_id X := Hom.ext (funext fun n ↦ by cases n <;> rfl)
  map_comp f g := Hom.ext (funext fun n ↦ by
    cases n with
    | zero => exact (Category.id_comp _).symm
    | succ n => rfl)

variable [PreservesColimit (Functor.empty.{0} C) S]

private def prependInitialHomEquiv (X Y : SequentialPrespectrum S) :
    ((prependInitial S).obj X ⟶ Y) ≃ (X ⟶ tail.obj Y) where
  toFun f := ⟨fun n ↦ f.app (n + 1), fun n ↦ f.comm (n + 1)⟩
  invFun f :=
    { app
        | 0 => initial.to _
        | n + 1 => f.app n
      comm
        | 0 => (isColimitOfHasInitialOfPreservesColimit S).hom_ext _ _
        | n + 1 => f.comm n }
  left_inv f := Hom.ext (funext fun n ↦ by
    cases n with
    | zero => exact initialIsInitial.hom_ext _ _
    | succ n => rfl)
  right_inv f := Hom.ext (funext fun _ ↦ rfl)

/-- Adding an initial level is left adjoint to dropping the first level. -/
@[no_expose]
def prependInitialAdjunction : prependInitial S ⊣ tail :=
  Adjunction.mkOfHomEquiv
    { homEquiv := prependInitialHomEquiv
      homEquiv_naturality_left_symm := fun f g ↦ Hom.ext (funext fun n ↦ by
        cases n with
        | zero => exact initialIsInitial.hom_ext _ _
        | succ n => rfl)
      homEquiv_naturality_right := fun _ _ ↦ Hom.ext (funext fun _ ↦ rfl) }

private theorem prependInitialAdjunction_homEquiv_app (X Y : SequentialPrespectrum S)
    (f : (prependInitial S).obj X ⟶ Y) (n : ℕ) :
    ((prependInitialAdjunction (S := S)).homEquiv X Y f).app n = f.app (n + 1) := by
  unfold prependInitialAdjunction
  rw [Adjunction.mkOfHomEquiv_homEquiv]
  rfl

/-- The free prespectrum generated by a given object in degree `n`. -/
@[no_expose]
def freeAt : ℕ → C ⥤ SequentialPrespectrum S
  | 0 => suspension S
  | n + 1 => freeAt n ⋙ prependInitial S

/-- The free prespectrum is left adjoint to evaluation at the given degree. -/
@[no_expose]
def freeAtAdjunction : ∀ n, (freeAt (S := S) n) ⊣ evaluation n
  | 0 => suspensionAdjunction S
  | n + 1 => (freeAtAdjunction n).comp (prependInitialAdjunction (S := S))

/-- The chosen free prespectrum retains the generator in its given degree. -/
theorem freeAt_level (n : ℕ) (X : C) : (((freeAt (S := S) n).obj X).level n) = X := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change (((freeAt (S := S) n).obj X).level n) = X
    exact ih

/-- The comparison from the level of the free prespectrum to its generator. -/
def freeAtLevelIso (n : ℕ) (X : C) : ((freeAt (S := S) n).obj X).level n ≅ X :=
  eqToIso (freeAt_level n X)

/-- The Hom correspondence uses the map in degree `n` and the actual
identification of that level with the generator. -/
theorem freeAtAdjunction_homEquiv_app (n : ℕ) (X : C) (Y : SequentialPrespectrum S)
    (f : (freeAt (S := S) n).obj X ⟶ Y) :
    (freeAtAdjunction (S := S) n).homEquiv X Y f =
      (freeAtLevelIso (S := S) n X).inv ≫ f.app n := by
  induction n generalizing Y with
  | zero =>
    change (suspensionAdjunction S).homEquiv X Y f = _
    rw [suspensionAdjunction_homEquiv]
    change f.app 0 = eqToHom ((freeAt_level (S := S) 0 X).symm) ≫ f.app 0
    exact ((congrArg (· ≫ f.app 0) (eqToHom_refl X _)).trans (Category.id_comp _)).symm
  | succ n ih =>
    let A := freeAtAdjunction (S := S) n
    let B := prependInitialAdjunction (S := S)
    let g := B.homEquiv ((freeAt (S := S) n).obj X) Y f
    change (A.comp B).homEquiv X Y f = _
    rw [Adjunction.comp_homEquiv]
    change A.homEquiv X (tail.obj Y) g = _
    rw [ih (tail.obj Y) g, prependInitialAdjunction_homEquiv_app]
    rfl

/-- The stable comparison of free prespectra is classified by the original
bonding map of the free prespectrum on the generator. -/
def freeAtSuccComparison (n : ℕ) (X : C) :
    (freeAt (S := S) (n + 1)).obj (S.obj X) ⟶
      (freeAt (S := S) n).obj X :=
  ((freeAtAdjunction (S := S) (n + 1)).homEquiv _ _).symm
    (S.map (freeAtLevelIso (S := S) n X).inv ≫ ((freeAt (S := S) n).obj X).bonding n)

/-- Precomposition by the stable comparison is the original bonding
map under the degreewise free adjunctions. -/
theorem freeAtAdjunction_homEquiv_comparison (n : ℕ) (X : C)
    (Y : SequentialPrespectrum S) (f : (freeAt (S := S) n).obj X ⟶ Y) :
    (freeAtAdjunction (S := S) (n + 1)).homEquiv (S.obj X) Y
        (freeAtSuccComparison (S := S) n X ≫ f) =
      S.map ((freeAtAdjunction (S := S) n).homEquiv X Y f) ≫ Y.bonding n := by
  rw [Adjunction.homEquiv_naturality_right]
  change ((freeAtAdjunction (S := S) (n + 1)).homEquiv _ _)
      (freeAtSuccComparison (S := S) n X) ≫ f.app (n + 1) = _
  unfold freeAtSuccComparison
  rw [Equiv.apply_symm_apply, Category.assoc, f.comm, freeAtAdjunction_homEquiv_app,
    Functor.map_comp, Category.assoc]

end CategoryTheory.SequentialPrespectrum
