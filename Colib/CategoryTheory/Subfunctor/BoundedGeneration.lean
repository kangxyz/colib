module

public import StacksFrontier.CategoryTheory.Sites.UniverseBridge.FinsetGeneratedSubfunctor
public import Mathlib.SetTheory.Cardinal.HasCardinalLT

/-!
# Cardinal bounds for subpresheaves generated by sections

The original restriction maps give a bound on the subpresheaf generated by
a bounded family of sections. This is the counting step in the bounded
cofibration argument of Jardine, *Simplicial presheaves*, Lemma 2.4,
pp. 65–66. https://doi.org/10.1016/0022-4049(87)90100-9
-/

@[expose] public section

open Stacks.Sites.UniverseBridge

universe t w v u

namespace CategoryTheory.Subfunctor

variable {C : Type u} [Category.{v} C] {F : C ⥤ Type w}

/-- The subpresheaf generated by one section has at most the prescribed
bound on its total space of sections. -/
theorem hasCardinalLT_totalSections_ofSectionGen {U : C} (x : F.obj U)
    (κ : Cardinal.{t})
    (h : HasCardinalLT (Σ V : C, U ⟶ V) κ) :
    HasCardinalLT (Σ V : C, (ofSectionGen x).obj V) κ := by
  refine h.of_surjective (fun ⟨V, f⟩ => ⟨V, ⟨F.map f x, ⟨f, rfl⟩⟩⟩) ?_
  rintro ⟨V, y, ⟨f, rfl⟩⟩
  exact ⟨⟨V, f⟩, rfl⟩

/-- A union of a bounded family of subpresheaves with bounded total
section spaces again has bounded total section space. -/
theorem hasCardinalLT_totalSections_iSup {I : Type*} (A : I → Subfunctor F)
    (κ : Cardinal.{t}) [Fact κ.IsRegular]
    (hI : HasCardinalLT I κ)
    (hA : ∀ i, HasCardinalLT (Σ V : C, (A i).obj V) κ) :
    HasCardinalLT (Σ V : C, (⨆ i, A i).obj V) κ := by
  have inclusion (i : I) (V : C) : (A i).obj V ⊆ (⨆ j, A j).obj V :=
    le_iSup A i V
  refine (hasCardinalLT_sigma (fun i => Σ V : C, (A i).obj V) κ hI hA).of_surjective
    (fun ⟨i, V, y⟩ => ⟨V, ⟨y.val, inclusion i V y.property⟩⟩) ?_
  rintro ⟨V, y, hy⟩
  rw [iSup_obj, Set.mem_iUnion] at hy
  obtain ⟨i, hi⟩ := hy
  exact ⟨⟨i, V, y, hi⟩, rfl⟩

/-- Boundedly many sections generate a subpresheaf with bounded total
section space when the original restriction arrows have the same bound. -/
theorem hasCardinalLT_totalSections_generated {I : Type*} {U : I → C}
    (x : ∀ i, F.obj (U i)) (κ : Cardinal.{t}) [Fact κ.IsRegular]
    (hI : HasCardinalLT I κ)
    (hC : ∀ i, HasCardinalLT (Σ V : C, U i ⟶ V) κ) :
    HasCardinalLT (Σ V : C, (⨆ i, ofSectionGen (x i)).obj V) κ :=
  hasCardinalLT_totalSections_iSup _ κ hI (fun i =>
    hasCardinalLT_totalSections_ofSectionGen (x i) κ (hC i))

end CategoryTheory.Subfunctor
