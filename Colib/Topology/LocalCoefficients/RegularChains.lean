module

public import Colib.Topology.LocalCoefficients.Regular
public import Colib.Topology.LocalCoefficients.Functoriality
public import Colib.Topology.LocalCoefficients.IntegralChains

/-!
# The actual bases of regular and integral singular chains

The coproduct defining regular local-coefficient chains is the free integral
module on pairs consisting of a singular simplex and a path class to its
first vertex. Ordinary integral chains have one generator per simplex.
The integral coefficient module is explicitly lifted to the space universe.
-/

@[expose] public section

noncomputable section

open CategoryTheory Limits Convexity Opposite
open scoped Simplicial

universe u

namespace FundamentalGroupoid.LocalCoefficients

variable {X : Type u} [TopologicalSpace X]

/-- A simplex together with a basis path of its actual regular coefficient fiber. -/
abbrev RegularSimplex (b : X) (n : SimplexCategory) :=
  Σ σ : SingularSimplex X n,
    Path.Homotopic.Quotient b (σ (StdSimplex.single 0))

/-- The regular generator determined by a simplex, path class, and integer. -/
def regularChainGenerator (b : X) {n : SimplexCategory}
    (s : RegularSimplex b n) (z : ℤ) : chainModule (regular b) n :=
  chainInclusion (regular b) s.1 (regularSingle b s.2 z)

/-- Flatten the actual coproduct of free regular fibers. -/
def regularBasisHom (b : X) (n : SimplexCategory) :
    chainModule (regular b) n ⟶ ModuleCat.of ℤ (RegularSimplex b n →₀ ℤ) :=
  Sigma.desc fun σ ↦ ModuleCat.ofHom
    (Finsupp.lmapDomain ℤ ℤ (fun q ↦ (⟨σ, q⟩ : RegularSimplex b n)))

/-- Insert a finitely supported combination into the actual coproduct. -/
def regularBasisInv (b : X) (n : SimplexCategory) :
    ModuleCat.of ℤ (RegularSimplex b n →₀ ℤ) ⟶ chainModule (regular b) n :=
  ModuleCat.ofHom (Finsupp.lsum ℕ fun s ↦
    (chainInclusion (regular b) s.1).hom.comp (Finsupp.lsingle s.2))

@[simp]
theorem regularBasisHom_generator (b : X) {n : SimplexCategory}
    (s : RegularSimplex b n) (z : ℤ) :
    regularBasisHom b n (regularChainGenerator b s z) = Finsupp.single s z := by
  rcases s with ⟨σ, q⟩
  change (chainInclusion (regular b) σ ≫ regularBasisHom b n) (Finsupp.single q z) = _
  rw [show chainInclusion (regular b) σ ≫ regularBasisHom b n =
    ModuleCat.ofHom (Finsupp.lmapDomain ℤ ℤ
      (fun q ↦ (⟨σ, q⟩ : RegularSimplex b n))) from Sigma.ι_comp_desc _ _]
  exact Finsupp.mapDomain_single

@[simp]
theorem regularBasisInv_single (b : X) {n : SimplexCategory}
    (s : RegularSimplex b n) (z : ℤ) :
    regularBasisInv b n (Finsupp.single s z) = regularChainGenerator b s z := by
  exact Finsupp.lsum_single (S := ℕ) (σ := RingHom.id ℤ)
    (fun t : RegularSimplex b n ↦
      (chainInclusion (regular b) t.1).hom.comp (Finsupp.lsingle t.2)) s z

/-- Actual regular chains are freely generated by the displayed path-class pairs. -/
def regularBasisIso (b : X) (n : SimplexCategory) :
    chainModule (regular b) n ≅ ModuleCat.of ℤ (RegularSimplex b n →₀ ℤ) where
  hom := regularBasisHom b n
  inv := regularBasisInv b n
  hom_inv_id := by
    apply Sigma.hom_ext
    intro σ
    apply ModuleCat.hom_ext
    apply Finsupp.lhom_ext
    intro q z
    change regularBasisInv b n (regularBasisHom b n
      (regularChainGenerator b ⟨σ, q⟩ z)) = regularChainGenerator b ⟨σ, q⟩ z
    rw [regularBasisHom_generator, regularBasisInv_single]
  inv_hom_id := by
    apply ModuleCat.hom_ext
    apply Finsupp.lhom_ext
    intro s z
    change regularBasisHom b n (regularBasisInv b n (Finsupp.single s z)) = _
    rw [regularBasisInv_single, regularBasisHom_generator]
    rfl

/-- Restriction of a regular basis simplex includes the genuine first-vertex transport. -/
def restrictRegularSimplex (b : X) {m n : SimplexCategory}
    (s : RegularSimplex b n) (α : m ⟶ n) : RegularSimplex b m :=
  ⟨restrictSimplex s.1 α,
    s.2.trans (.mk ((PathConnectedSpace.somePath (StdSimplex.single 0)
      ((StdSimplex.single 0).map α)).map s.1.continuous))⟩

/-- Every simplicial operator acts on regular chains by the stated path-class transport. -/
@[simp]
theorem chainMap_regularGenerator (b : X) {m n : SimplexCategory}
    (s : RegularSimplex b n) (α : m ⟶ n) (z : ℤ) :
    chainMap (regular b) α (regularChainGenerator b s z) =
      regularChainGenerator b (restrictRegularSimplex b s α) z := by
  change (chainInclusion (regular b) s.1 ≫ chainMap (regular b) α)
    (regularSingle b s.2 z) = _
  rw [chainInclusion_chainMap]
  change chainInclusion (regular b) (restrictSimplex s.1 α)
    (transport (regular b) ((PathConnectedSpace.somePath (StdSimplex.single 0)
      ((StdSimplex.single 0).map α)).map s.1.continuous) (regularSingle b s.2 z)) = _
  rw [regular_transport_single]
  rfl

