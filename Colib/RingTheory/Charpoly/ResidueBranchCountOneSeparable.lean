module

public import Colib.RingTheory.Charpoly.DVRBranchCountSeparable
public import StacksFrontier.RingTheory.DiscreteValuationRing.RamificationIndex
public import Mathlib.FieldTheory.Minpoly.Field
public import Mathlib.Algebra.Order.BigOperators.Group.Finset

/-!
# Actual residue branches when the original ramification exponent is one

The existing integral characteristic-polynomial branch count and positivity force every
upper ramification exponent and remaining residue-generator degree to be one. The literal
minimal polynomials of the actual reduced images are distinct and cover all monic
irreducible coefficient factors exactly once. In particular, no weighted norm tower law
is needed to replace these actual residue fields by their generated subfields.

All S-to-U maps are supplied actual ring maps, and their integral tensor coordinates are
checked explicitly. No branch count, factor bijection, or residual power-basis hypothesis
on U is assumed. The original residue power basis and separability of the actual source residue
extension are retained explicitly; no residue characteristic restriction is used.
The proof is adapted from `Colib.RingTheory.Charpoly.ResidueBranchCountOne`.
-/

@[expose] public noncomputable section

open Polynomial IsLocalRing
open scoped TensorProduct BigOperators

namespace Algebra

variable (R F S E T L : Type*)
  [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Field F]
  [CommRing S] [IsDomain S] [IsDiscreteValuationRing S] [Field E]
  [Algebra R F] [IsFractionRing R F] [Algebra R S] [Algebra F E]
  [Algebra R E] [Algebra S E] [IsScalarTower R F E] [IsScalarTower R S E]
  [IsIntegralClosure S R E] [FiniteDimensional F E]
  [Module.IsTorsionFree R S] [Module.Finite R S] [IsLocalHom (algebraMap R S)]
  [CommRing T] [IsDomain T] [IsDiscreteValuationRing T] [Field L]
  [Algebra R T] [IsLocalHom (algebraMap R T)] [Algebra T L]
  [IsFractionRing T L] [Algebra F L] [Algebra R L]
  [IsScalarTower R T L] [IsScalarTower R F L]
  {ι : Type*} [Finite ι] (D U : ι → Type*)
  [∀ i, Field (D i)] [∀ i, CommRing (U i)] [∀ i, IsDomain (U i)]
  [∀ i, IsDiscreteValuationRing (U i)]
  [∀ i, Algebra L (D i)] [∀ i, Algebra T (U i)]
  [∀ i, Algebra T (D i)] [∀ i, Algebra (U i) (D i)]
  [∀ i, IsScalarTower T L (D i)] [∀ i, IsScalarTower T (U i) (D i)]
  [∀ i, IsIntegralClosure (U i) T (D i)] [∀ i, FiniteDimensional L (D i)]
  [∀ i, Module.IsTorsionFree T (U i)] [∀ i, Module.Finite T (U i)]
  [∀ i, IsLocalHom (algebraMap T (U i))]
  [∀ i, Algebra R (U i)] [∀ i, Algebra S (U i)]
  [∀ i, IsScalarTower R S (U i)] [∀ i, IsScalarTower R T (U i)]
  [∀ i, IsLocalHom (algebraMap S (U i))]
  [Algebra.IsSeparable (ResidueField R) (ResidueField S)]


/-- With original ramification one, the actual reduced integral generators yield all
residue factors exactly once. Each upper branch has ramification one and relative residue
degree one over the subfield generated by that actual residue element. -/
theorem residue_branches_of_ramification_eq_one_of_separable
    (ε : (L ⊗[F] E) ≃ₐ[L] (∀ i, D i)) (b : S)
    (hc : ∀ i, algebraMap (U i) (D i) (algebraMap S (U i) b) =
      ε (1 ⊗ₜ[F] (algebraMap S E b)) i)
    {π : R} {ϖ : S} (hπ : Irreducible π) (hϖ : Irreducible ϖ)
    (u : Sˣ) (he : algebraMap R S π = (u : S) * ϖ ^ 1)
    (B : PowerBasis (ResidueField R) (ResidueField S)) (hB : B.gen = residue S b)
    {τ : T} (hτ : Irreducible τ) (ω : ∀ i, U i)
    (hω : ∀ i, Irreducible (ω i)) (v : ∀ i, (U i)ˣ) (d : ι → ℕ)
    (hd : ∀ i, algebraMap T (U i) τ = (v i : U i) * ω i ^ d i) :
    (∀ i, d i = 1 ∧ Module.finrank
      (IntermediateField.adjoin (ResidueField T)
        {residue (U i) (algebraMap S (U i) b)}) (ResidueField (U i)) = 1) ∧
    Function.Injective (fun i =>
      minpoly (ResidueField T) (residue (U i) (algebraMap S (U i) b))) ∧
    (∀ q : (ResidueField T)[X], q.Monic → Irreducible q →
      q ∣ (minpoly (ResidueField R) (residue S b)).map
        (algebraMap (ResidueField R) (ResidueField T)) →
      ∃! i, minpoly (ResidueField T) (residue (U i) (algebraMap S (U i) b)) = q) := by
  classical
  let : Fintype ι := Fintype.ofFinite ι
  let : ∀ i, IsLocalHom (algebraMap R (U i)) := fun i => by
    rw [IsScalarTower.algebraMap_eq R S (U i)]
    infer_instance
  let β := fun i => residue (U i) (algebraMap S (U i) b)
  let p := fun i => minpoly (ResidueField T) (β i)
  let P := (minpoly (ResidueField R) (residue S b)).map
    (algebraMap (ResidueField R) (ResidueField T))
  let f := fun i => Module.finrank
    (IntermediateField.adjoin (ResidueField T) {β i}) (ResidueField (U i))
  have hp (i : ι) : (p i).Monic ∧ Irreducible (p i) :=
    ⟨minpoly.monic (Algebra.IsIntegral.isIntegral (R := ResidueField T) (β i)),
      minpoly.irreducible (Algebra.IsIntegral.isIntegral (R := ResidueField T) (β i))⟩
  have hpdvd (i : ι) : p i ∣ P := by
    simpa only [p, P, β, ResidueField.algebraMap_residue] using
      minpoly.dvd_map_of_isScalarTower' (ResidueField R)
        (ResidueField T) (ResidueField (U i)) (residue S b)
  have hdpos (i : ι) : 0 < d i := by
    have hidx := Stacks.DiscreteValuationRing.Ramification.addVal_algebraMap_eq_ramificationIdx
      T (U i) τ hτ
    rw [hd i, IsDiscreteValuationRing.addVal_def' (v i) (hω i) (d i)] at hidx
    have heq : d i = Stacks.DiscreteValuationRing.Ramification.ramificationIdx T (U i) := by
      exact_mod_cast hidx
    rw [heq]
    exact Stacks.DiscreteValuationRing.Ramification.one_le_ramificationIdx T (U i)
  have hfpos (i : ι) : 0 < f i := Module.finrank_pos
  have hcount (q : (ResidueField T)[X]) (hq : q.Monic)
      (hqirr : Irreducible q) (hqdvd : q ∣ P) :
      (∑ i, if p i = q then d i * f i else 0) = 1 :=
    sum_residue_branch_degrees_eq_ramification_of_separable R F S E T L D U ε b
      (fun i => algebraMap S (U i) b) hc hπ hϖ u 1 he B hB hτ ω hω v d hd
      q hq hqirr hqdvd
  have hw (i : ι) : d i * f i = 1 := by
    have hle := Finset.single_le_sum
      (f := fun j => if p j = p i then d j * f j else 0)
      (fun j (_ : j ∈ Finset.univ) => Nat.zero_le _) (Finset.mem_univ i)
    rw [ite_eq_left rfl, hcount (p i) (hp i).1 (hp i).2 (hpdvd i)] at hle
    exact Nat.le_antisymm hle (Nat.mul_pos (hdpos i) (hfpos i))
  have hinj : Function.Injective p := by
    intro i j hij
    by_contra hne
    have hle := Finset.add_le_sum
      (f := fun k => if p k = p i then d k * f k else 0)
      (fun k (_ : k ∈ Finset.univ) => Nat.zero_le _)
      (Finset.mem_univ i) (Finset.mem_univ j) hne
    rw [ite_eq_left rfl, ite_eq_left hij.symm, hw i, hw j,
      hcount (p i) (hp i).1 (hp i).2 (hpdvd i)] at hle
    exact (by decide : ¬ (1 + 1 ≤ (1 : ℕ))) hle
  refine ⟨fun i => ⟨Nat.eq_one_of_mul_eq_one_right (hw i),
    Nat.eq_one_of_mul_eq_one_left (hw i)⟩, hinj, ?_⟩
  intro q hq hqirr hqdvd
  have hex : ∃ i, p i = q := by
    by_contra hn
    have hnone : ∀ i, p i ≠ q := fun i hi => hn ⟨i, hi⟩
    have h := hcount q hq hqirr hqdvd
    simp only [ite_eq_right (hnone _), Finset.sum_const_zero] at h
    exact Nat.zero_ne_one h
  obtain ⟨i, hi⟩ := hex
  exact ⟨i, hi, fun j hj => hinj (hj.trans hi.symm)⟩

end Algebra

end
