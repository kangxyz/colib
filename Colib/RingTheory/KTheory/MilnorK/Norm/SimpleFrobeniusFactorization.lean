/-!
# Simple Milnor norms under power substitution

The degree-`p` morphism of projective lines in characteristic `p` gives the
norm square at every finite place and at infinity. Taking a native
single-residue lift gives the factorization through the field generated by
the `p`-th power of the original generator.
-/

@[expose] public noncomputable section

open Polynomial IsLocalRing IsDedekindDomain _root_.AdicCompletion _root_.AlgebraicGeometry

universe u

namespace Stacks.Chow

open MonicIrreducibleOfDegree

attribute [local instance] Ideal.Quotient.field Classical.decEq
  isDiscreteValuationRing_localizationAtPrime_polynomial

variable {k : Type u} [Field k] {p : ℕ} {d e : ℕ}

local notation "I" φ => Ideal.span {poly φ}
local notation "Q" φ => Polynomial k ⧸ I φ

private theorem comap_expand_eq
    (φ : MonicIrreducibleOfDegree k d) (ψ : MonicIrreducibleOfDegree k e)
    (h : poly ψ ∣ expand k p (poly φ)) :
    (I ψ).comap (expand k p).toRingHom = I φ := by
  exact ((inferInstance : (I φ).IsMaximal).eq_of_le
    (Ideal.IsPrime.ne_top (inferInstance : ((I ψ).comap (expand k p).toRingHom).IsPrime))
    (by
      rw [Ideal.span_singleton_le_iff_mem]
      exact Ideal.mem_span_singleton.mpr h)).symm

/-- The literal residue map induced by parameter substitution on the two polynomial quotients. -/
def frobeniusParameterResidueMap
    (φ : MonicIrreducibleOfDegree k d) (ψ : MonicIrreducibleOfDegree k e)
    (h : poly ψ ∣ expand k p (poly φ)) : (Q φ) →ₐ[k] (Q ψ) :=
  Ideal.quotientMapₐ (I ψ) (expand k p) (by
    rw [Ideal.span_singleton_le_iff_mem]
    exact Ideal.mem_span_singleton.mpr h)

/-- The lower parameter enters the upper residue field as the `p`-th power of its root. -/
theorem frobeniusParameterResidueMap_root
    (φ : MonicIrreducibleOfDegree k d) (ψ : MonicIrreducibleOfDegree k e)
    (h : poly ψ ∣ expand k p (poly φ)) :
    frobeniusParameterResidueMap φ ψ h (AdjoinRoot.root (poly φ)) =
      (AdjoinRoot.root (poly ψ)) ^ p := by
  change Ideal.Quotient.mk (I ψ) (expand k p X) = (Ideal.Quotient.mk (I ψ) X) ^ p
  rw [expand_X, map_pow]

/-- The actual extension of polynomial residues is finite. -/
theorem finite_frobeniusParameterResidueMap
    (φ : MonicIrreducibleOfDegree k d) (ψ : MonicIrreducibleOfDegree k e)
    (h : poly ψ ∣ expand k p (poly φ)) :
    letI := (frobeniusParameterResidueMap φ ψ h).toRingHom.toAlgebra
    FiniteDimensional (Q φ) (Q ψ) := by
  let := (frobeniusParameterResidueMap φ ψ h).toRingHom.toAlgebra
  let : IsScalarTower k (Q φ) (Q ψ) :=
    IsScalarTower.of_algebraMap_eq fun a => ((frobeniusParameterResidueMap φ ψ h).commutes a).symm
  let : Module.Finite k (Q ψ) := (monic ψ).finite_adjoinRoot
  exact Module.Finite.of_restrictScalars_finite k (Q φ) (Q ψ)

private theorem exists_dvd_expand (hp : p.Prime) (φ : MonicIrreducibleOfDegree k d) :
    ∃ (e : ℕ) (ψ : MonicIrreducibleOfDegree k e), poly ψ ∣ expand k p (poly φ) := by
  have hdeg : 0 < (expand k p (poly φ)).natDegree := by
    rw [natDegree_expand]
    exact Nat.mul_pos (irreducible φ).natDegree_pos hp.pos
  obtain ⟨f, hf, hdiv⟩ := WfDvdMonoid.exists_irreducible_factor
    (fun h => hdeg.ne' (Polynomial.natDegree_eq_zero_of_isUnit h))
    ((expand_ne_zero (R := k) hp.pos).mpr (ne_zero φ))
  let ψ : MonicIrreducibleOfDegree k (normalize f).natDegree :=
    ⟨normalize f, monic_normalize hf.ne_zero,
      (normalize_associated f).irreducible_iff.mpr hf, rfl⟩
  exact ⟨_, ψ, normalize_dvd_iff.mpr hdiv⟩

private theorem monicIrreducibleResidue_eq_transport
    (φ : MonicIrreducibleOfDegree k d) (n : ℕ) (x : MilnorKTheory (RatFunc k) (n + 1)) :
    monicIrreducibleResidue φ (x : MilnorKRing (RatFunc k)) =
      (milnorKTransport (quotientRingEquivResidueField (I φ)).symm.toRingHom n
        (affineLineResidue (I φ) n x) : MilnorKRing (Q φ)) := by
  rw [affineLineResidue, dvrMilnorTameSymbol'_eq_of_ramified_identity
    (irreducible_algebraMap_self (p := poly φ))]
  rfl

private def parameterNorm (hp : p.Prime) (n : ℕ) :
    MilnorKTheory (RatFunc k) n →+ MilnorKTheory (RatFunc k) n :=
  @milnorKNorm (RatFunc k) (RatFunc k) _ _
    (RatFunc.frobeniusParameterAlgebra k p hp.pos)
    (RatFunc.finite_frobeniusParameterAlgebra k p hp.pos) n

variable [ExpChar k p]

private theorem monicIrreducibleResidue_parameterNorm
    (hp : p.Prime) (φ : MonicIrreducibleOfDegree k d) (ψ : MonicIrreducibleOfDegree k e)
    (h : poly ψ ∣ expand k p (poly φ))
    (n : ℕ) (x : MilnorKTheory (RatFunc k) (n + 1)) :
    letI := (frobeniusParameterResidueMap φ ψ h).toRingHom.toAlgebra
    letI := finite_frobeniusParameterResidueMap φ ψ h
    monicIrreducibleResidue φ (parameterNorm hp (n + 1) x : MilnorKRing (RatFunc k)) =
      milnorKNormRing (Q φ) (Q ψ) (monicIrreducibleResidue ψ (x : MilnorKRing (RatFunc k))) := by
  let A := Polynomial k
  let E := RatFunc k
  let a : Algebra A E := inferInstanceAs (Algebra k[X] (RatFunc k))
  let pAlg : Algebra A A := Polynomial.frobeniusParameterAlgebra k p
  let fAlg : Algebra E E := RatFunc.frobeniusParameterAlgebra k p hp.pos
  let : Module A A := pAlg.toModule
  let : Module E E := fAlg.toModule
  let : Module.Finite A A := Polynomial.finite_frobeniusParameterAlgebra k p hp.pos
  let : Module.IsTorsionFree A A :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr (expand_injective (R := k) hp.pos)
  let : FiniteDimensional E E := RatFunc.finite_frobeniusParameterAlgebra k p hp.pos
  let : IsPurelyInseparable E E := RatFunc.isPurelyInseparable_frobeniusParameterAlgebra k p hp.pos
  let crossMap : A →+* E :=
    (@algebraMap A E _ _ a).comp (expand k p).toRingHom
  let hAS := @IsScalarTower.of_algebraMap_eq' A A E _ _ _ pAlg a crossMap.toAlgebra rfl
  let hAF := @IsScalarTower.of_algebraMap_eq' A E E _ _ _ a fAlg crossMap.toAlgebra
    (RingHom.ext fun f => (RatFunc.frobeniusParameter_algebraMap k p hp.pos f).symm)
  let P : HeightOneSpectrum A := ⟨I φ, inferInstance, ne_bot_of_isMaximal_polynomial _⟩
  have hunder : (I ψ).under A = I φ := comap_expand_eq φ ψ h
  have hq : (I ψ) ∈ P.asIdeal.primesOver A := ⟨inferInstance, ⟨hunder.symm⟩⟩
  let q : IdealBranch (P.asIdeal.map (algebraMap A A)) :=
    ⟨I ψ, Multiset.mem_toFinset.mpr
      ((Ideal.mem_primesOver_iff_mem_normalizedFactors A P.ne_bot).mp hq)⟩
  let R := Localization.AtPrime (I φ)
  let S := Localization.AtPrime (I ψ)
  let := Localization.basePrimeLocalAlgebra (I φ) (I ψ) hunder
  let := Localization.basePrimeLocal_isLocalHom (I φ) (I ψ) hunder
  let := Localization.basePrimeLocal_residueFinite (I φ) (I ψ) hunder
  let := (frobeniusParameterResidueMap φ ψ h).toRingHom.toAlgebra
  let := finite_frobeniusParameterResidueMap φ ψ h
  have hdegree : Module.finrank E E = p := RatFunc.finrank_frobeniusParameterAlgebra k p hp.pos
  have H := @purePrimeResidue_atPrime A A E E _ _ _ _ pAlg _ _ _ a _ a _ crossMap.toAlgebra hAS
    fAlg hAF _ _ P _ _ _ q _ _ _ (hdegree.symm ▸ hp)
  let : IsPurelyInseparable (ResidueField R) (ResidueField S) := H.1
  have hdiv : Module.finrank (ResidueField R) (ResidueField S) ∣ p := hdegree ▸ H.2.1
  let σ : (Q φ) ≃+* ResidueField R := quotientRingEquivResidueField (I φ)
  let τ : (Q ψ) ≃+* ResidueField S := quotientRingEquivResidueField (I ψ)
  have hcomp : (algebraMap (ResidueField R) (ResidueField S)).comp σ.toRingHom =
      τ.toRingHom.comp (algebraMap (Q φ) (Q ψ)) := by
    apply Ideal.Quotient.ringHom_ext
    apply RingHom.ext
    intro f
    change algebraMap (ResidueField R) (ResidueField S) (σ (Ideal.Quotient.mk (I φ) f)) =
      τ (frobeniusParameterResidueMap φ ψ h (Ideal.Quotient.mk (I φ) f))
    rw [← residue_algebraMap_eq_quotientRingEquivResidueField,
      ResidueField.algebraMap_residue]
    have hlocal := Localization.localRingHom_to_map (I φ) (I ψ) (expand k p).toRingHom
      (comap_expand_eq φ ψ h).symm f
    exact (congrArg (residue S) hlocal).trans
      (residue_algebraMap_eq_quotientRingEquivResidueField (I ψ) (expand k p f))
  have hcoeff : τ.symm.toRingHom.comp (algebraMap (ResidueField R) (ResidueField S)) =
      (algebraMap (Q φ) (Q ψ)).comp σ.symm.toRingHom := by
    apply RingHom.ext
    intro z
    obtain ⟨b, rfl⟩ := σ.surjective z
    change τ.symm (algebraMap (ResidueField R) (ResidueField S) (σ b)) =
      algebraMap (Q φ) (Q ψ) (σ.symm (σ b))
    change τ.symm (((algebraMap (ResidueField R) (ResidueField S)).comp σ.toRingHom) b) = _
    rw [RingHom.congr_fun hcomp b]
    change τ.symm (τ (algebraMap (Q φ) (Q ψ) b)) = _
    rw [τ.symm_apply_apply, σ.symm_apply_apply]
  have hr : affineLineResidue (I φ) n (parameterNorm hp (n + 1) x) =
      milnorKNorm (ResidueField R) (ResidueField S) n (affineLineResidue (I ψ) n x) :=
    H.2.2 n x
  rw [monicIrreducibleResidue_eq_transport, monicIrreducibleResidue_eq_transport, hr]
  simpa only [coe_milnorKNorm] using congrArg (fun z : MilnorKTheory (Q φ) n =>
    (z : MilnorKRing (Q φ)))
    (milnorKNorm_map_ringEquiv_of_isPurelyInseparable_of_dvd_prime hp hdiv σ.symm τ.symm
      hcoeff n (affineLineResidue (I ψ) n x))

omit [ExpChar k p] in
private theorem chartInversion_comp_frobeniusParameter (hp : p.Prime) :
    (projectiveLineChartInversion k).toRingHom.comp
      (RatFunc.frobeniusParameter k p hp.pos).toRingHom =
    (RatFunc.frobeniusParameter k p hp.pos).toRingHom.comp
      (projectiveLineChartInversion k).toRingHom := by
  apply IsLocalization.ringHom_ext (nonZeroDivisors k[X])
  refine Polynomial.ringHom_ext (fun c => ?_) ?_
  · have hinvC : projectiveLineChartInversion k (RatFunc.C c) = RatFunc.C c := by
      simpa only [RatFunc.algebraMap_C] using projectiveLineChartInversion_C k c
    change projectiveLineChartInversion k (RatFunc.frobeniusParameter k p hp.pos (RatFunc.C c)) =
      RatFunc.frobeniusParameter k p hp.pos (projectiveLineChartInversion k (RatFunc.C c))
    simp only [RatFunc.frobeniusParameter_C, hinvC]
  · have hinvX : projectiveLineChartInversion k (RatFunc.X : RatFunc k) = RatFunc.X⁻¹ := by
      simpa only [RatFunc.algebraMap_X] using projectiveLineChartInversion_X k
    change projectiveLineChartInversion k
      (RatFunc.frobeniusParameter k p hp.pos RatFunc.X) =
      RatFunc.frobeniusParameter k p hp.pos (projectiveLineChartInversion k RatFunc.X)
    rw [RatFunc.frobeniusParameter_X, map_pow, hinvX, map_inv₀, RatFunc.frobeniusParameter_X,
      inv_pow]

private abbrev originPoint (k : Type u) [Field k] : MonicIrreducibleOfDegree k 1 :=
  ⟨X, monic_X, irreducible_X, natDegree_X⟩

omit [ExpChar k p] in
private theorem origin_dvd_expand (hp : p.Prime) :
    poly (originPoint k) ∣ expand k p (poly (originPoint k)) := by
  change (X : k[X]) ∣ expand k p X
  rw [expand_X]
  exact dvd_pow_self _ hp.ne_zero

private theorem infinityResidueRing_eq_origin (y : MilnorKRing (RatFunc k)) :
    infinityResidueRing k y =
      milnorKRingMap ((residueFieldAtOriginEquiv k).symm.toRingHom.comp
        (quotientRingEquivResidueField (I (originPoint k))).toRingHom)
      (monicIrreducibleResidue (originPoint k)
        (milnorKRingMap (projectiveLineChartInversion k).toRingHom y)) := by
  let σ := (residueFieldAtOriginEquiv k).symm.toRingHom
  let ε := quotientRingEquivResidueField (Ideal.span {(X : k[X])})
  have hcomp : (σ.comp ε.toRingHom).comp ε.symm.toRingHom = σ := by
    apply RingHom.ext
    intro a
    change σ (ε (ε.symm a)) = σ a
    exact congrArg σ (ε.apply_symm_apply a)
  rw [infinityResidueRing_apply, monicIrreducibleResidue_apply, milnorKRingMap_comp_apply]
  change milnorKRingMap σ _ = milnorKRingMap ((σ.comp ε.toRingHom).comp ε.symm.toRingHom) _
  rw [hcomp]
  rfl

private theorem infinityResidueRing_parameterNorm
    (hp : p.Prime) (n : ℕ) (x : MilnorKTheory (RatFunc k) (n + 1)) :
    infinityResidueRing k (parameterNorm hp (n + 1) x : MilnorKRing (RatFunc k)) =
      infinityResidueRing k (x : MilnorKRing (RatFunc k)) := by
  let J := projectiveLineChartInversion k
  let := RatFunc.frobeniusParameterAlgebra k p hp.pos
  let : Module (RatFunc k) (RatFunc k) := (RatFunc.frobeniusParameterAlgebra k p hp.pos).toModule
  let := RatFunc.finite_frobeniusParameterAlgebra k p hp.pos
  let := RatFunc.isPurelyInseparable_frobeniusParameterAlgebra k p hp.pos
  have hdegree : Nat.Prime (Module.finrank (RatFunc k) (RatFunc k)) :=
    (RatFunc.finrank_frobeniusParameterAlgebra k p hp.pos).symm ▸ hp
  have hJ := milnorKNorm_map_ringEquiv_of_prime_of_isPurelyInseparable
    hdegree J J (chartInversion_comp_frobeniusParameter hp) (n + 1) x
  have hJ' := congrArg (fun z : MilnorKTheory (RatFunc k) (n + 1) =>
    (z : MilnorKRing (RatFunc k))) hJ
  simp only [milnorKTransport_coe] at hJ'
  change milnorKRingMap J.toRingHom (parameterNorm hp (n + 1) x : MilnorKRing (RatFunc k)) =
    (parameterNorm hp (n + 1) (milnorKTransport J.toRingHom (n + 1) x) : MilnorKRing (RatFunc k))
    at hJ'
  rw [infinityResidueRing_eq_origin, infinityResidueRing_eq_origin, hJ']
  let ψ := originPoint k
  let h := origin_dvd_expand (k := k) hp
  let := (frobeniusParameterResidueMap ψ ψ h).toRingHom.toAlgebra
  let := finite_frobeniusParameterResidueMap ψ ψ h
  have hId : (frobeniusParameterResidueMap ψ ψ h).toRingHom = RingHom.id (Q ψ) := by
    apply Ideal.Quotient.ringHom_ext
    refine Polynomial.ringHom_ext (fun c => ?_) ?_
    · change Ideal.Quotient.mk (I ψ) (expand k p (C c)) = Ideal.Quotient.mk (I ψ) (C c)
      rw [expand_C]
    · have hz : Ideal.Quotient.mk (I ψ) (X : k[X]) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      change Ideal.Quotient.mk (I ψ) (expand k p X) = Ideal.Quotient.mk (I ψ) X
      rw [expand_X, map_pow, hz, zero_pow hp.ne_zero]
  have hbij : Function.Bijective (algebraMap (Q ψ) (Q ψ)) :=
    show Function.Bijective (frobeniusParameterResidueMap ψ ψ h).toRingHom by
      rw [hId]
      exact Function.bijective_id
  have hmap : algebraMap (Q ψ) (Q ψ) = RingHom.id (Q ψ) := hId
  have hdeg := Algebra.finrank_eq_one_iff_bijective_algebraMap.mpr hbij
  have hnorm (z : MilnorKRing (Q ψ)) : milnorKNormRing (Q ψ) (Q ψ) z = z := by
    simpa only [hmap, milnorKRingMap_id_apply, hdeg, Nat.cast_one, one_zsmul] using
      milnorKNormRing_milnorKRingMap (K := Q ψ) (L := Q ψ) z
  have hr := monicIrreducibleResidue_parameterNorm hp ψ ψ h n
    (milnorKTransport J.toRingHom (n + 1) x)
  simp only [milnorKTransport_coe] at hr
  let evalOrigin : (Q ψ) →+* k := (residueFieldAtOriginEquiv k).symm.toRingHom.comp
    (quotientRingEquivResidueField (Ideal.span {(X : k[X])})).toRingHom
  exact congrArg (milnorKRingMap evalOrigin) (hr.trans (hnorm _))

private theorem simpleMilnorNorm_eq_frobeniusParameter_homogeneous
    (hp : p.Prime) (φ : MonicIrreducibleOfDegree k d) (ψ : MonicIrreducibleOfDegree k e)
    (h : poly ψ ∣ expand k p (poly φ)) (n : ℕ) (z : MilnorKTheory (Q ψ) n) :
    letI := (frobeniusParameterResidueMap φ ψ h).toRingHom.toAlgebra
    letI := finite_frobeniusParameterResidueMap φ ψ h
    simpleMilnorNorm ψ (z : MilnorKRing (Q ψ)) =
      simpleMilnorNorm φ (milnorKNormRing (Q φ) (Q ψ) (z : MilnorKRing (Q ψ))) := by
  let := (frobeniusParameterResidueMap φ ψ h).toRingHom.toAlgebra
  let := finite_frobeniusParameterResidueMap φ ψ h
  obtain ⟨x, hxdeg, hx⟩ := exists_isSingleResidueLift' ψ z.property
  let y : MilnorKTheory (RatFunc k) (n + 1) := ⟨x, hxdeg⟩
  have hy : IsSingleResidueLift φ (milnorKNormRing (Q φ) (Q ψ) (z : MilnorKRing (Q ψ)))
      (parameterNorm hp (n + 1) y : MilnorKRing (RatFunc k)) := by
    constructor
    · rw [monicIrreducibleResidue_parameterNorm hp φ ψ h n y]
      exact congrArg (milnorKNormRing (Q φ) (Q ψ)) hx.1
    · intro d' φ' hne
      obtain ⟨e', ψ', h'⟩ := exists_dvd_expand hp φ'
      have hne' : poly ψ' ≠ poly ψ := by
        intro heq
        have hc := comap_expand_eq φ' ψ' h'
        rw [heq] at hc
        exact hne (eq_of_monic_of_associated (monic φ') (monic φ)
          (Ideal.span_singleton_eq_span_singleton.mp
            (hc.symm.trans (comap_expand_eq φ ψ h))))
      let := (frobeniusParameterResidueMap φ' ψ' h').toRingHom.toAlgebra
      let := finite_frobeniusParameterResidueMap φ' ψ' h'
      rw [monicIrreducibleResidue_parameterNorm hp φ' ψ' h' n y]
      exact (congrArg (milnorKNormRing (Q φ') (Q ψ')) (hx.2 _ ψ' hne')).trans (map_zero _)
  rw [simpleMilnorNorm_eq hx, simpleMilnorNorm_eq hy, infinityResidueRing_parameterNorm hp n y]

/-- The native simple norm factors through the literal residue field of the
`p`-th power of the original root and the chosen relative norm. -/
theorem simpleMilnorNorm_eq_frobeniusParameter
    (hp : p.Prime) (φ : MonicIrreducibleOfDegree k d) (ψ : MonicIrreducibleOfDegree k e)
    (h : poly ψ ∣ expand k p (poly φ)) (z : MilnorKRing (Q ψ)) :
    letI := (frobeniusParameterResidueMap φ ψ h).toRingHom.toAlgebra
    letI := finite_frobeniusParameterResidueMap φ ψ h
    simpleMilnorNorm ψ z = simpleMilnorNorm φ (milnorKNormRing (Q φ) (Q ψ) z) := by
  let := (frobeniusParameterResidueMap φ ψ h).toRingHom.toAlgebra
  let := finite_frobeniusParameterResidueMap φ ψ h
  let f := simpleMilnorNorm ψ
  let g := (simpleMilnorNorm φ).comp (milnorKNormRing (Q φ) (Q ψ))
  exact mem_of_forall_milnorKSymbolProd_mem (H := f.eqLocus g)
    (fun l => simpleMilnorNorm_eq_frobeniusParameter_homogeneous hp φ ψ h l.length
      ⟨milnorKSymbolProd _ l, milnorKSymbolProd_mem_milnorKGrading l⟩) z

end Stacks.Chow

end
