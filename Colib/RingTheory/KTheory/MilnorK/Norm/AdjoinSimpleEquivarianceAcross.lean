module

public import Colib.RingTheory.KTheory.MilnorK.Norm.SimpleEquivarianceAcross
public import StacksFrontier.AlgebraicGeometry.Chow.MilnorNorm.FieldNorm

/-!
# Simple adjoining and the Milnor norm under field equivalences

A commuting pair of field equivalences carries the actual adjoining field to the
field generated by the image of its generator. The induced equivalence uses the
coefficient map on the two minimal-polynomial quotients in the native simple norms.
-/

@[expose] public noncomputable section

open Polynomial IntermediateField

universe u v

namespace Stacks.Chow

open MonicIrreducibleOfDegree
attribute [local instance] Ideal.Quotient.field

private theorem simpleMilnorNorm_map_of_poly_eq_map_across'
    {k : Type u} {k' : Type v} [Field k] [Field k']
    (σ : k ≃+* k') {d e : ℕ}
    (p : MonicIrreducibleOfDegree k d) (q : MonicIrreducibleOfDegree k' e)
    (hq : poly q = (poly p).map σ.toRingHom)
    (x : MilnorKRing (k[X] ⧸ Ideal.span {poly p})) :
    milnorKRingMapLift σ.toRingHom (simpleMilnorNorm p x) =
      simpleMilnorNorm q (milnorKRingMapLift
        (AdjoinRoot.map σ.toRingHom (poly p) (poly q) (hq ▸ dvd_rfl)) x) := by
  have hdegree : e = d := by
    rw [← natDegree_eq q, hq, Polynomial.natDegree_map, natDegree_eq p]
  subst e
  exact simpleMilnorNorm_map_of_poly_eq_map_across σ p q hq x

/-- The actual equivalence of the two adjoining fields commutes with their bottom and top
inclusions and with the native simple-adjoining norms. -/
theorem exists_adjoinSimple_ringEquiv_across
    {k L : Type u} {k' L' : Type v} [Field k] [Field L] [Field k'] [Field L']
    [Algebra k L] [Algebra k' L'] [Algebra.IsIntegral k L]
    (σ : k ≃+* k') (τ : L ≃+* L')
    (hστ : τ.toRingHom.comp (algebraMap k L) = (algebraMap k' L').comp σ.toRingHom)
    {a : L} (ha : IsIntegral k a) (ha' : IsIntegral k' (τ a)) :
    ∃ e : k⟮a⟯ ≃+* k'⟮τ a⟯,
      e.toRingHom.comp (algebraMap k k⟮a⟯) = (algebraMap k' k'⟮τ a⟯).comp σ.toRingHom ∧
      τ.toRingHom.comp (algebraMap k⟮a⟯ L) = (algebraMap k'⟮τ a⟯ L').comp e.toRingHom ∧
      ∀ z : MilnorKRing k⟮a⟯,
        milnorKRingMapLift σ.toRingHom (milnorKNormAdjoinSimple k ha z) =
          milnorKNormAdjoinSimple k' ha' (milnorKRingMapLift e.toRingHom z) := by
  let p := minpolyOfDegree k ha
  let q := minpolyOfDegree k' ha'
  have hq : poly q = (poly p).map σ.toRingHom :=
    (minpoly.map_eq_of_equiv_equiv (f := σ) (g := τ) hστ.symm a).symm
  let c : AdjoinRoot (poly p) ≃+* AdjoinRoot (poly q) :=
    AdjoinRoot.mapRingEquiv σ (poly p) (poly q) (by
      change Associated ((poly p).map σ.toRingHom) (poly q)
      rw [← hq])
  have hc : c.toRingHom =
      AdjoinRoot.map σ.toRingHom (poly p) (poly q) (hq ▸ dvd_rfl) := rfl
  have hc_of (t : k) : c (AdjoinRoot.of (poly p) t) = AdjoinRoot.of (poly q) (σ t) := by
    change c.toRingHom _ = _
    rw [hc, AdjoinRoot.map_of]
    rfl
  have hc_root : c (AdjoinRoot.root (poly p)) = AdjoinRoot.root (poly q) := by
    change c.toRingHom _ = _
    rw [hc, AdjoinRoot.map_root]
  let eP : k⟮a⟯ ≃ₐ[k] AdjoinRoot (poly p) := adjoinSimpleEquivQuot k ha
  let eQ : k'⟮τ a⟯ ≃ₐ[k'] AdjoinRoot (poly q) := adjoinSimpleEquivQuot k' ha'
  let e := (eP.toRingEquiv.trans c).trans eQ.symm.toRingEquiv
  refine ⟨e, ?_, ?_, ?_⟩
  · apply RingHom.ext
    intro t
    change eQ.symm (c (eP (algebraMap k k⟮a⟯ t))) = algebraMap k' k'⟮τ a⟯ (σ t)
    rw [eP.commutes]
    change eQ.symm (c (AdjoinRoot.of (poly p) t)) = _
    rw [hc_of]
    exact eQ.symm.commutes (σ t)
  · have htop : (τ.toRingHom.comp (algebraMap k⟮a⟯ L)).comp eP.symm.toRingHom =
        ((algebraMap k'⟮τ a⟯ L').comp eQ.symm.toRingHom).comp c.toRingHom := by
      apply AdjoinRoot.ringHom_ext
      · apply RingHom.ext
        intro t
        change τ (algebraMap k⟮a⟯ L (eP.symm (AdjoinRoot.of (poly p) t))) =
          algebraMap k'⟮τ a⟯ L' (eQ.symm (c (AdjoinRoot.of (poly p) t)))
        rw [show eP.symm (AdjoinRoot.of (poly p) t) = algebraMap k k⟮a⟯ t
          from eP.symm.commutes t, hc_of]
        rw [show eQ.symm (AdjoinRoot.of (poly q) (σ t)) = algebraMap k' k'⟮τ a⟯ (σ t)
          from eQ.symm.commutes (σ t)]
        exact DFunLike.congr_fun hστ t
      · change τ (algebraMap k⟮a⟯ L (eP.symm (AdjoinRoot.root (poly p)))) =
          algebraMap k'⟮τ a⟯ L' (eQ.symm (c (AdjoinRoot.root (poly p))))
        have hP : eP.symm (AdjoinRoot.root (poly p)) = AdjoinSimple.gen k a :=
          adjoinRootEquivAdjoin_apply_root k ha
        have hQ : eQ.symm (AdjoinRoot.root (poly q)) = AdjoinSimple.gen k' (τ a) :=
          adjoinRootEquivAdjoin_apply_root k' ha'
        rw [hc_root, hP, hQ]
        rfl
    apply RingHom.ext
    intro x
    have hx := DFunLike.congr_fun htop (eP x)
    change τ (algebraMap k⟮a⟯ L (eP.symm (eP x))) =
      algebraMap k'⟮τ a⟯ L' (eQ.symm (c (eP x))) at hx
    rw [eP.symm_apply_apply] at hx
    exact hx
  · intro z
    let fP : k⟮a⟯ →+* (k[X] ⧸ Ideal.span {poly p}) :=
      (adjoinSimpleEquivQuot k ha).toRingHom
    let fQ : k'⟮τ a⟯ →+* (k'[X] ⧸ Ideal.span {poly q}) :=
      (adjoinSimpleEquivQuot k' ha').toRingHom
    let φ : (k[X] ⧸ Ideal.span {poly p}) →+* (k'[X] ⧸ Ideal.span {poly q}) :=
      AdjoinRoot.map σ.toRingHom (poly p) (poly q) (hq ▸ dvd_rfl)
    change milnorKRingMapLift σ.toRingHom (simpleMilnorNorm p (milnorKRingMap fP z)) =
      simpleMilnorNorm q (milnorKRingMap fQ (milnorKRingMapLift e.toRingHom z))
    have hnorm := simpleMilnorNorm_map_of_poly_eq_map_across' σ p q hq
      (milnorKRingMap fP z)
    refine hnorm.trans (congrArg (simpleMilnorNorm q) ?_)
    change milnorKRingMapLift φ (milnorKRingMap fP z) =
      milnorKRingMap fQ (milnorKRingMapLift e.toRingHom z)
    have he : φ.comp fP = fQ.comp e.toRingHom := by
      apply RingHom.ext
      intro x
      change c (eP x) = eQ (eQ.symm (c (eP x)))
      rw [eQ.apply_symm_apply]
    calc
      _ = milnorKRingMapLift (φ.comp fP) z := by
        simpa only [milnorKRingMapLift_eq fP] using milnorKRingMapLift_comp_apply fP φ z
      _ = milnorKRingMapLift (fQ.comp e.toRingHom) z := by rw [he]
      _ = _ := by
        simpa only [milnorKRingMapLift_eq fQ] using
          (milnorKRingMapLift_comp_apply e.toRingHom fQ z).symm

end Stacks.Chow
