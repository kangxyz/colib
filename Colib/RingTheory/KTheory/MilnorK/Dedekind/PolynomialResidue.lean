module

public import Colib.RingTheory.KTheory.MilnorK.Dedekind.ResidueSupport
public import Colib.RingTheory.KTheory.MilnorK.RationalFunctionExactness

/-!
# Native polynomial places as actual Dedekind residues

Adapted from Aglib `Dedekind/PolynomialResidue.lean`, revision
`4f65be4eafa8964bd1f7a83682e99aa8165bd418`, lines 25–92. The polynomial
index is the existing native `MonicIrreduciblePoint`, not a new point model.
The scalar equality below identifies the literal maps to the original RatFunc.
Uniformizer independence identifies the canonical and polynomial tame symbols.
-/

@[expose] public noncomputable section

namespace Stacks.Chow.PolynomialDedekindResidue

open Polynomial IsDedekindDomain MonicIrreducibleOfDegree

attribute [local instance] Ideal.Quotient.field
  isDiscreteValuationRing_localizationAtPrime_polynomial

variable {k : Type*} [Field k]

/-- The actual nonzero prime ideal generated by the native monic irreducible point. -/
abbrev point (p : MonicIrreduciblePoint k) : HeightOneSpectrum k[X] :=
  ⟨Ideal.span {poly p.2}, inferInstance,
    ne_bot_of_isMaximal_polynomial (Ideal.span {poly p.2})⟩

@[simp] theorem point_asIdeal (p : MonicIrreduciblePoint k) :
    (point p).asIdeal = Ideal.span {poly p.2} := rfl

/-- The unique monic generator, packaged in the existing native polynomial index. -/
def polynomial (q : HeightOneSpectrum k[X]) : MonicIrreduciblePoint k := by
  classical
  let g := Submodule.IsPrincipal.generator q.asIdeal
  have hg : Prime g := Submodule.IsPrincipal.prime_generator_of_isPrime q.asIdeal q.ne_bot
  exact ⟨(normalize g).natDegree, normalize g, Polynomial.monic_normalize hg.ne_zero,
    (normalize_associated g).irreducible_iff.mpr hg.irreducible, rfl⟩

@[simp] theorem point_polynomial (q : HeightOneSpectrum k[X]) :
    point (polynomial q) = q := by
  classical
  apply HeightOneSpectrum.ext
  change Ideal.span {normalize (Submodule.IsPrincipal.generator q.asIdeal)} = q.asIdeal
  rw [Ideal.span_singleton_eq_span_singleton.mpr (normalize_associated _),
    Ideal.span_singleton_generator]

@[simp] theorem polynomial_point (p : MonicIrreduciblePoint k) :
    polynomial (point p) = p := by
  apply MonicIrreduciblePoint.ext_poly
  apply Polynomial.eq_of_monic_of_associated (monic (polynomial (point p)).2) (monic p.2)
  apply Ideal.span_singleton_eq_span_singleton.mp
  exact congrArg HeightOneSpectrum.asIdeal (point_polynomial (point p))

/-- Literal reindexing of the existing polynomial points by height-one prime ideals. -/
def pointEquiv : MonicIrreduciblePoint k ≃ HeightOneSpectrum k[X] where
  toFun := point
  invFun := polynomial
  left_inv := polynomial_point
  right_inv := point_polynomial

/-- Both constructions use the same canonical map into the original rational field. -/
theorem fractionAlgebra_eq (p : MonicIrreduciblePoint k) :
    DedekindResidue.fractionAlgebra k[X] (RatFunc k) (point p) =
      algebraLocalizationAtPrimeRatFunc (Ideal.span {poly p.2}) := by
  apply Algebra.algebra_ext
  have h :
      @algebraMap (Localization.AtPrime (Ideal.span {poly p.2})) (RatFunc k) _ _
          (DedekindResidue.fractionAlgebra k[X] (RatFunc k) (point p)) =
      @algebraMap (Localization.AtPrime (Ideal.span {poly p.2})) (RatFunc k) _ _
          (algebraLocalizationAtPrimeRatFunc (Ideal.span {poly p.2})) := by
    apply IsLocalization.ringHom_ext (Ideal.span {poly p.2}).primeCompl
    apply RingHom.ext
    intro a
    exact (DedekindResidue.fractionAlgebra_algebraMap k[X] (RatFunc k) (point p) a).trans
      (IsScalarTower.algebraMap_apply k[X]
        (Localization.AtPrime (Ideal.span {poly p.2})) (RatFunc k) a)
  exact RingHom.congr_fun h

/-- The canonical Dedekind residue is the native affine-line residue on the unchanged field. -/
theorem totalResidue_point_eq_affineLineResidue (p : MonicIrreduciblePoint k) (n : ℕ)
    (x : MilnorKTheory (RatFunc k) (n + 1)) :
    DedekindResidue.totalResidue k[X] (RatFunc k) n x (point p) =
      affineLineResidue (Ideal.span {poly p.2}) n x := by
  rw [DedekindResidue.totalResidue_apply]
  unfold affineLineResidue
  congr 2
  · exact fractionAlgebra_eq p
  · apply proof_irrel_heq

/-- The actual Dedekind residue, in the canonical quotient coordinates, is the
existing native total polynomial residue at that same point. -/
theorem totalResidue_point (p : MonicIrreduciblePoint k) (n : ℕ)
    (x : MilnorKTheory (RatFunc k) (n + 1)) :
    milnorKTransport (quotientRingEquivResidueField (Ideal.span {poly p.2})).symm.toRingHom n
      (DedekindResidue.totalResidue k[X] (RatFunc k) n x (point p)) =
        milnorKTotalResidue k n x p := by
  rw [totalResidue_point_eq_affineLineResidue]
  unfold affineLineResidue
  rw [dvrMilnorTameSymbol'_eq_of_ramified_identity
    (irreducible_algebraMap_self (p := poly p.2))]
  apply Subtype.ext
  rw [milnorKTransport_coe, coe_milnorKTotalResidue_apply]
  rfl

end Stacks.Chow.PolynomialDedekindResidue
