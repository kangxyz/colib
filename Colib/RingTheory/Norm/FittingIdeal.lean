module

public import Mathlib.RingTheory.Norm.Basic
public import StacksFrontier.RingTheory.Fitting.SquareMatrixDeterminant

/-!
# Norms of principal quotients of finite free algebras

Multiplication by the chosen element presents the actual principal quotient.
Its zeroth Fitting ideal is the determinant ideal. A target-linear comparison
of the principal quotients consequently identifies their determinant ideals.

Adapted from `Motivic/Aglib/RingTheory/Norm/FiniteFree/Fitting.lean` at
a6805c4a87cdfd7717dd7a94039246a167f15380.
-/

@[expose] public noncomputable section

open scoped Matrix
open Module

universe u v

namespace Algebra

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
  [Module.Finite R S] [Module.Free R S]

/-- The zeroth Fitting ideal of the principal quotient is generated by the norm. -/
theorem fittingIdeal_zero_quotient_span_eq_norm (g : S) :
    fittingIdeal (R := R) (M := S ⧸ Ideal.span {g}) 0 = Ideal.span {norm R g} := by
  nontriviality R
  let b := Module.finBasis R S
  let q : S →ₗ[R] S ⧸ Ideal.span {g} :=
    (Ideal.Quotient.mkₐ R (Ideal.span {g})).toLinearMap
  let f := q.comp b.equivFun.symm.toLinearMap
  have hf : Function.Surjective f :=
    Ideal.Quotient.mk_surjective.comp b.equivFun.symm.surjective
  let A := Algebra.leftMulMatrix b g
  have hmul (y : S) : A *ᵥ b.equivFun y = b.equivFun (g * y) := by
    simpa only [A, Basis.equivFun_apply] using Algebra.leftMulMatrix_mulVec_repr b g y
  have hA : Submodule.span R (Set.range fun j i ↦ A i j) = LinearMap.ker f := by
    change Submodule.span R (Set.range A.col) = LinearMap.ker f
    rw [← Matrix.range_mulVecLin]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      change q (b.equivFun.symm (A *ᵥ y)) = 0
      have hy : b.equivFun.symm (A *ᵥ y) = g * b.equivFun.symm y := by
        apply b.equivFun.injective
        rw [b.equivFun.apply_symm_apply]
        simpa only [b.equivFun.apply_symm_apply] using hmul (b.equivFun.symm y)
      rw [hy]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.mem_span_singleton.mpr ⟨b.equivFun.symm y, rfl⟩)
    · intro hx
      have hx' : b.equivFun.symm x ∈ Ideal.span {g} :=
        Ideal.Quotient.eq_zero_iff_mem.mp hx
      obtain ⟨y, hy⟩ := Ideal.mem_span_singleton.mp hx'
      refine ⟨b.equivFun y, ?_⟩
      change A *ᵥ b.equivFun y = x
      rw [hmul, ← hy]
      exact b.equivFun.apply_symm_apply x
  let e := (Submodule.quotEquivOfEq _ _ hA).trans (f.quotKerEquivOfSurjective hf)
  change fittingIdeal (R := R) (M := S ⧸ Ideal.span {g}) ((0 : ℕ) : ℤ) = _
  rw [fittingIdeal_eq_minorIdeal_of_presentation A 0 e, Nat.sub_zero,
    Stacks.Fitting.minorIdeal_self_eq_span_det, ← Algebra.norm_eq_matrix_det b]

/-- An actual comparison of principal quotients computes the source norm ideal. -/
theorem span_norm_eq_of_quotient_linearEquiv (g : S) (a : R)
    (e : (S ⧸ Ideal.span {g}) ≃ₗ[R] (R ⧸ Ideal.span {a})) :
    Ideal.span {norm R g} = Ideal.span {a} := by
  rw [← fittingIdeal_zero_quotient_span_eq_norm]
  change fittingIdeal (R := R) (M := S ⧸ Ideal.span {g}) ((0 : ℕ) : ℤ) = _
  rw [fittingIdeal_eq_of_linearEquiv e 0]
  exact (fittingIdeal_quotient_and_prod (Ideal.span {a}) ⊥).1

end Algebra
