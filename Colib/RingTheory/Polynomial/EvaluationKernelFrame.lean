module

public import Mathlib.RingTheory.Polynomial.Ideal

/-!
# The specified frame of the polynomial evaluation kernel

The frame is multiplication by `X - C a`, with this sign. Monicity makes it an
isomorphism over an arbitrary commutative ring, including a nonreduced ring. This
is the ring-level frame used by the marked graph ideal, before sheafification.

Adapted from `Motivic/Aglib/AlgebraicGeometry/EffectiveCartierDivisor/
CoordinateGraphIdeal.lean:29-49` at
`a6805c4a87cdfd7717dd7a94039246a167f15380`.
-/

@[expose] public noncomputable section

namespace Polynomial

universe u v

variable (R : Type u) [CommRing R] (a : R)

/-- Multiplication by the literal coordinate difference, landing in the actual kernel. -/
def evaluationKernelMap : R[X] →ₗ[R[X]] RingHom.ker (evalRingHom a) where
  toFun p := ⟨p * (X - C a), by simp [RingHom.mem_ker]⟩
  map_add' p q := by ext; simp [add_mul]
  map_smul' p q := by ext; simp [mul_assoc]

/-- The evaluation kernel is freely generated by `X - C a`, without reducedness. -/
def evaluationKernelFrame : R[X] ≃ₗ[R[X]] RingHom.ker (evalRingHom a) :=
  LinearEquiv.ofBijective (evaluationKernelMap R a) ⟨by
    intro p q h
    exact (monic_X_sub_C a).isRegular.right (congrArg Subtype.val h), by
    intro p
    have hp : (p : R[X]) ∈ Ideal.span {X - C a} := by
      simpa only [ker_evalRingHom] using p.property
    obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp hp
    exact ⟨q, Subtype.ext hq⟩⟩

@[simp]
theorem evaluationKernelFrame_apply (p : R[X]) :
    (evaluationKernelFrame R a p : R[X]) = p * (X - C a) := rfl

theorem evaluationKernelFrame_one :
    (evaluationKernelFrame R a 1 : R[X]) = X - C a := by
  simp

/-- The canonical inclusion has the specified difference as its frame coordinate. -/
theorem evaluationKernelFrame_inclusion :
    (RingHom.ker (evalRingHom a)).subtype.comp (evaluationKernelFrame R a).toLinearMap =
      LinearMap.mulRight R[X] (X - C a) := by
  ext p
  rfl

variable {B : Type v} [CommRing B]

/-- Coefficient change preserves the literal generator, including its sign. -/
theorem map_evaluationKernelFrame (f : R →+* B) (p : R[X]) :
    Polynomial.map f (evaluationKernelFrame R a p : R[X]) =
      (evaluationKernelFrame B (f a) (Polynomial.map f p) : B[X]) := by
  simp

end Polynomial
