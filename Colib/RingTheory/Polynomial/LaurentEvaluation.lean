module

public import Mathlib.Algebra.Polynomial.Laurent
public import Mathlib.Algebra.Regular.SMul
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Polynomial.Ideal

/-!
# Evaluation at a unit in the Laurent polynomial ring

The graph of a unit is the literal quotient of the Laurent line by the
coordinate minus that unit. The coordinate difference is regular over
an arbitrary coefficient ring by monicity before localization.
-/

@[expose] public noncomputable section

universe u

namespace LaurentPolynomial

variable {R : Type u} [CommRing R]

/-- Evaluation at a unit fixes the coefficients and is surjective. -/
theorem eval₂_id_surjective (u : Rˣ) : Function.Surjective (eval₂ (RingHom.id R) u) :=
  fun a => ⟨C a, by simp⟩

/-- The evaluation kernel is generated by the actual coordinate difference. -/
theorem ker_eval₂_id (u : Rˣ) :
    RingHom.ker (eval₂ (RingHom.id R) u) = Ideal.span {T 1 - C (u : R)} := by
  apply le_antisymm
  · intro a ha
    obtain ⟨n, q, hq⟩ := a.exists_T_pow
    have hq₀ : Polynomial.evalRingHom (u : R) q = 0 := by
      change Polynomial.eval₂ (RingHom.id R) (u : R) q = 0
      rw [← eval₂_toLaurent, hq, map_mul, RingHom.mem_ker.mp ha, zero_mul]
    have hmem : q ∈ Ideal.span {Polynomial.X - Polynomial.C (u : R)} := by
      rw [← Polynomial.ker_evalRingHom]
      exact RingHom.mem_ker.mpr hq₀
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hmem
    apply (Ideal.unit_mul_mem_iff_mem (Ideal.span {T 1 - C (u : R)}) (isUnit_T n)).mp
    rw [mul_comm, ← hq, ← hb, map_mul, map_sub, Polynomial.toLaurent_X, Polynomial.toLaurent_C]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))
  · apply Ideal.span_le.mpr
    rintro a (rfl : a = T 1 - C (u : R))
    simp [RingHom.mem_ker]

/-- The graph quotient is the original coefficient ring, via evaluation. -/
def quotientSpanTSubCRingEquiv (u : Rˣ) :
    (LaurentPolynomial R ⧸ Ideal.span {T 1 - C (u : R)}) ≃+* R :=
  (Ideal.quotEquivOfEq (ker_eval₂_id u).symm).trans
    (RingHom.quotientKerEquivOfSurjective (eval₂_id_surjective u))

/-- The graph quotient acts by the original evaluation on Laurent polynomials. -/
@[simp]
theorem quotientSpanTSubCRingEquiv_mk (u : Rˣ) (p : LaurentPolynomial R) :
    quotientSpanTSubCRingEquiv u (Ideal.Quotient.mk _ p) = eval₂ (RingHom.id R) u p :=
  rfl

/-- The literal coordinate difference is regular, including over a
nonreduced coefficient ring. -/
theorem isSMulRegular_T_sub_C (r : R) :
    IsSMulRegular (LaurentPolynomial R) (T 1 - C r) := by
  intro x y hxy
  change (T 1 - C r) * x = (T 1 - C r) * y at hxy
  have hzero : (T 1 - C r) * (x - y) = 0 := by rw [mul_sub, hxy, sub_self]
  obtain ⟨n, q, hq⟩ := (x - y).exists_T_pow
  have hp : Polynomial.toLaurent ((Polynomial.X - Polynomial.C r) * q) = 0 := by
    rw [map_mul, map_sub, Polynomial.toLaurent_X, Polynomial.toLaurent_C,
      hq, ← mul_assoc, hzero, zero_mul]
  have hqzero : q = 0 :=
    (Polynomial.monic_X_sub_C r).isRegular.left (by
      change (Polynomial.X - Polynomial.C r) * q = (Polynomial.X - Polynomial.C r) * 0
      rw [mul_zero]
      exact Polynomial.toLaurent_injective (hp.trans (map_zero _).symm))
  apply sub_eq_zero.mp
  apply (IsUnit.mul_left_inj (isUnit_T n)).mp
  rw [← hq, hqzero, map_zero, zero_mul]

end LaurentPolynomial
