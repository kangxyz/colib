module

import Colib.CategoryTheory.Sites.AbelianCechDescent
import Colib.AlgebraicGeometry.Sites.Smooth.Nisnevich.Topology
import Mathlib.Algebra.Category.Grp.FilteredColimits
import Mathlib.CategoryTheory.Sites.LeftExact

/-!
# Correcting lifts on a smooth Nisnevich covering family

These examples use actual sections of ordinary abelian sheaves. The cover is a
native covering sieve generated by the displayed family, and only its pairwise
pullbacks are assumed. The correction theorem needs no exactness assumption:
the displayed short complex supplies the zero composite, and the displayed
coboundary supplies compatibility after correction.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry
open AlgebraicGeometry.Scheme AlgebraicGeometry.Scheme.SmoothSite

universe u

variable {S : Scheme.{u}}

example (E : ShortComplex (Sheaf (nisnevichTopology S) AddCommGrpCat.{u + 1}))
    (hE : E.ShortExact) (X : SmoothSite S) (x : E.X₂.obj.obj (op X))
    (hx : E.g.hom.app (op X) x = 0) :
    ∃! a : E.X₁.obj.obj (op X), E.f.hom.app (op X) a = x :=
  Sheaf.existsUnique_section_preimage (nisnevichTopology S) hE X x hx

example (E : ShortComplex (Sheaf (nisnevichTopology S) AddCommGrpCat.{u + 1}))
    {X : SmoothSite S} {ι : Type*} {U : ι → SmoothSite S} (p : ∀ i, U i ⟶ X)
    (hp : Sieve.ofArrows U p ∈ nisnevichTopology S X)
    [(Presieve.ofArrows U p).HasPairwisePullbacks]
    (s : E.X₃.obj.obj (op X)) (l : ∀ i, E.X₂.obj.obj (op (U i)))
    (hl : ∀ i, E.g.hom.app (op (U i)) (l i) = E.X₃.obj.map (p i).op s)
    (a : ∀ i, E.X₁.obj.obj (op (U i)))
    (ha : ∀ i j,
      E.X₂.obj.map (pullback.fst (p i) (p j)).op (l i) -
        E.X₂.obj.map (pullback.snd (p i) (p j)).op (l j) =
      E.f.hom.app (op (pullback (p i) (p j)))
        (E.X₁.obj.map (pullback.fst (p i) (p j)).op (a i) -
          E.X₁.obj.map (pullback.snd (p i) (p j)).op (a j))) :
    ∃ t : E.X₂.obj.obj (op X), E.g.hom.app (op X) t = s :=
  Sheaf.exists_section_lift_of_coboundary (nisnevichTopology S) E p hp s l hl a ha
