import Colib.AlgebraicGeometry.Correspondences.Principal.GraphEndpointParameter
import Colib.AlgebraicGeometry.Correspondences.Principal.BoundaryParameterCuts

/-! # Literal endpoint equations and original principal-image nonvanishing -/

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry.PrincipalFamilyUnitOpen

universe u

variable {k : Type u} [Field k] {X : Scheme.{u}} (p : X ⟶ Spec (.of k))

/-- The only flatness used for original polynomial parameters is structural. -/
example : Flat
    (pullback.snd p (Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))) :=
  inferInstance

/-- Zero uses the actual original parameter in the literal endpoint stalk map. -/
example (x : X) : RingHom.ker ((endpoint p 0).stalkMap x).hom =
    Ideal.span {((parameterSpace p).presheaf.germ ⊤ (endpoint p 0 x)
      (by trivial) (parameter p))} := by
  simpa only [endpointEquation_zero] using endpoint_stalkMap_ker_eq_parameter p 0 x

/-- One retains the full ideal generated by the original parameter minus one. -/
example (x : X) : RingHom.ker ((endpoint p 1).stalkMap x).hom =
    Ideal.span {((parameterSpace p).presheaf.germ ⊤ (endpoint p 1 x)
      (by trivial) (parameter p - 1))} := by
  simpa only [endpointEquation_one] using endpoint_stalkMap_ker_eq_parameter p 1 x

