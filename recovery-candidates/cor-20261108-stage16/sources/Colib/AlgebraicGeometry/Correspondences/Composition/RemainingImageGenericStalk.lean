module

public import Colib.AlgebraicGeometry.Correspondences.Composition.RemainingImage
public import StacksFrontier.AlgebraicGeometry.Chow.FibreCycles.CoefficientColength
public import StacksFrontier.AlgebraicGeometry.Chow.FlatPullback.Support
public import StacksFrontier.RingTheory.HilbertSamuel.Defs
public import Colib.Algebra.Category.ModuleCat.ChangeOfRings.Quotient

/-!
# Finite colength on the full intermediate image

The actual image exterior is not reduced, and its remaining incidence is the
actual diagonal pullback. At every generic point of that incidence, the kernel
in the image-exterior local ring is an ideal of definition. Native Cartesian
stalk-kernel base change identifies it with the image of the original middle
self-product diagonal ideal. Thus the original remaining list, rather than a
substituted finite-colength hypothesis, supplies the local-image input for
finite-pushforward Koszul Euler.

No flatness of the finite original-to-image map is used or asserted. In
particular this file does not treat a single source stalk as a finite algebra
over an image stalk: a finite-fibre Euler sum must retain the whole semilocal
finite base change and every original point above the image label.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Chow

variable {S X Y Z W : Scheme.{u}}
  (f : X ⟶ S) (g : Y ⟶ S) (h : Z ⟶ S) (i : W ⟶ S)
  (z : pullback (C := Scheme) f g) (w : pullback (C := Scheme) g h)
  (v : pullback (C := Scheme) h i)

/-- The original middle pair on the full intermediate-image exterior. -/
abbrev correspondenceLeftImageMiddlePair :
    correspondenceLeftIntermediateImageProduct f g h i z w v ⟶ pullback h h :=
  pullback.map _ _ h h (correspondenceIntermediateImageTarget f g h z w)
    ((integralComponentAt v).subschemeι ≫ pullback.fst h i) (𝟙 S) (by simp) (by simp)

/-- The remaining incidence of the full image is the original middle-diagonal pullback. -/
theorem correspondenceLeftImageMiddlePair_isPullback :
    IsPullback (correspondenceLeftImageIncidenceInclusion f g h i z w v)
      (pullback.fst (correspondenceIntermediateImageTarget f g h z w)
        ((integralComponentAt v).subschemeι ≫ pullback.fst h i) ≫
          correspondenceIntermediateImageTarget f g h z w)
      (correspondenceLeftImageMiddlePair f g h i z w v) (pullback.diagonal h) :=
  (pullback_map_diagonal_isPullback (correspondenceIntermediateImageTarget f g h z w)
    ((integralComponentAt v).subschemeι ≫ pullback.fst h i) h).flip

/-- The full image-exterior local ring at a remaining-incidence point. -/
abbrev correspondenceRemainingImageStalk (x : correspondenceLeftImageIncidence f g h i z w v) :=
  (correspondenceLeftIntermediateImageProduct f g h i z w v).presheaf.stalk
    (correspondenceLeftImageIncidenceInclusion f g h i z w v x)

/-- The original middle self-product stalk maps to the actual full image-exterior stalk. -/
abbrev correspondenceRemainingImageMiddleStalkMap
    (x : correspondenceLeftImageIncidence f g h i z w v) :
    (pullback h h).presheaf.stalk (correspondenceLeftImageMiddlePair f g h i z w v
      (correspondenceLeftImageIncidenceInclusion f g h i z w v x)) →+*
        correspondenceRemainingImageStalk f g h i z w v x :=
  ((correspondenceLeftImageMiddlePair f g h i z w v).stalkMap
    (correspondenceLeftImageIncidenceInclusion f g h i z w v x)).hom

/-- The kernel in the full image-exterior stalk is an ideal of definition
at each actual generic remaining-image incidence label. -/
theorem isIdealOfDefinition_correspondenceRemainingImageStalkKernel [IsSeparated h]
    [IsLocallyNoetherian (correspondenceLeftIntermediateImageProduct f g h i z w v)]
    (x : genericPoints (correspondenceLeftImageIncidence f g h i z w v)) :
    IsIdealOfDefinition (RingHom.ker
      ((correspondenceLeftImageIncidenceInclusion f g h i z w v).stalkMap x.1).hom) := by
  let := LocallyOfFiniteType.isLocallyNoetherian
    (correspondenceLeftImageIncidenceInclusion f g h i z w v)
  let := generic_stalk_artinian x
  change Ideal.radical (RingHom.ker
    ((correspondenceLeftImageIncidenceInclusion f g h i z w v).stalkMap x.1).hom) = _
  rw [RingHom.ker_eq_comap_bot, ← Ideal.comap_radical,
    ← IsArtinianRing.jacobson_eq_radical,
    IsLocalRing.jacobson_eq_maximalIdeal _ bot_ne_top,
    IsLocalRing.maximalIdeal_comap]

/-- The full remaining-image kernel is generated by the original middle
self-product diagonal ideal under its original stalk map. -/
theorem correspondenceRemainingImageStalkKernel_eq_map [IsSeparated h]
    (x : correspondenceLeftImageIncidence f g h i z w v) :
    RingHom.ker ((correspondenceLeftImageIncidenceInclusion f g h i z w v).stalkMap x).hom =
      (IdealSheafData.stalk (pullback.diagonal h).ker
        (correspondenceLeftImageMiddlePair f g h i z w v
          (correspondenceLeftImageIncidenceInclusion f g h i z w v x))).map
            (correspondenceRemainingImageMiddleStalkMap f g h i z w v x) := by
  let H := correspondenceLeftImageMiddlePair_isPullback f g h i z w v
  have hp : pullback.diagonal h
      ((pullback.fst (correspondenceIntermediateImageTarget f g h z w)
        ((integralComponentAt v).subschemeι ≫ pullback.fst h i) ≫
          correspondenceIntermediateImageTarget f g h z w) x) =
      correspondenceLeftImageMiddlePair f g h i z w v
        (correspondenceLeftImageIncidenceInclusion f g h i z w v x) := by
    simpa only [Scheme.Hom.comp_apply] using congrArg (fun m => m x) H.w.symm
  have hk := Stacks.Flatness.ker_stalkMap_of_isPullback H x hp
  rw [ker_stalkMap_eq_idealStalk_ker (pullback.diagonal h)
    ((pullback.fst (correspondenceIntermediateImageTarget f g h z w)
      ((integralComponentAt v).subschemeι ≫ pullback.fst h i) ≫
        correspondenceIntermediateImageTarget f g h z w) x),
    CommRingCat.hom_comp, ← Ideal.map_map] at hk
  have htransport {p q : pullback (C := Scheme) h h} (e : p = q) :
      (IdealSheafData.stalk (pullback.diagonal h).ker p).map
        ((pullback h h).presheaf.stalkCongr (Inseparable.of_eq e)).hom.hom =
          IdealSheafData.stalk (pullback.diagonal h).ker q := by
    subst q
    simp [TopCat.Presheaf.stalkCongr]
  rw [htransport hp] at hk
  exact hk

/-- The actual generic remaining-image intersection proves finite colength
for the literal mapped original middle list, including nilpotents. -/
theorem isIdealOfDefinition_correspondenceRemainingImageMiddleList [IsSeparated h]
    [IsLocallyNoetherian (correspondenceLeftIntermediateImageProduct f g h i z w v)]
    (x : genericPoints (correspondenceLeftImageIncidence f g h i z w v)) {r : ℕ}
    (s : Fin r → (pullback h h).presheaf.stalk
      (correspondenceLeftImageMiddlePair f g h i z w v
        (correspondenceLeftImageIncidenceInclusion f g h i z w v x.1)))
    (hs : IdealSheafData.stalk (pullback.diagonal h).ker
      (correspondenceLeftImageMiddlePair f g h i z w v
        (correspondenceLeftImageIncidenceInclusion f g h i z w v x.1)) =
          Ideal.span (Set.range s)) :
    IsIdealOfDefinition (Ideal.span (Set.range (fun j =>
      correspondenceRemainingImageMiddleStalkMap f g h i z w v x.1 (s j)))) := by
  have hi := isIdealOfDefinition_correspondenceRemainingImageStalkKernel f g h i z w v x
  rw [correspondenceRemainingImageStalkKernel_eq_map, hs,
    Ideal.map_span, ← Set.range_comp'] at hi
  exact hi

end Stacks.Chow
