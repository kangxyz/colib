module

public import StacksFrontier.AlgebraicGeometry.Intersection.AlgebraicMultiplicities.KoszulEuler
public import StacksFrontier.AlgebraicGeometry.Intersection.AlgebraicMultiplicities.PrimeFiltration
public import StacksFrontier.RingTheory.KrullDimension.SystemOfParameters
public import StacksFrontier.RingTheory.Dualizing.Depth
public import Mathlib.RingTheory.Spectrum.Prime.Noetherian

/-!
# Integer Koszul Euler dévissage over the original generic labels

For a finite module over a Noetherian local ring and any list generating an
ideal of definition, the integer Euler characteristic of the native Koszul
complex is the sum of the Euler characteristics of the original prime
quotients, weighted by localized module length. The indexing set is all
minimal primes of the original ring, including lower-dimensional components.
The latter have zero Euler contribution; no equidimensionality or reduction
is imposed. Regularity of the generating sequence is not needed.

The proof combines the pinned native Stacks 0AZZ Koszul Euler formula with
0AZX prime-filtration multiplicity. It does not reproduce the filtration or
replace the native Koszul complex. The rational native equalities are
transported faithfully to integers, preserving all signs. The final finite
signed-family formula is suitable for applying this result separately to
every actual first-stage Tor homology module, rather than replacing that
family by the fundamental cycle of the full incidence ring.

Native sources: Stacks revision 5ed82d14634e8d9576bb844c7bd4e3da66d450e7,
`AlgebraicMultiplicities.KoszulEuler` (0AZZ) and `PrimeFiltration` (0AZX).
This is a local algebra supplier, not yet the geometric finite-image
comparison or associativity theorem.
-/

@[expose] public noncomputable section

open CategoryTheory

universe u v

namespace Koszul

variable {R : Type u} [CommRing R] {r : ℕ}

/-- The signed integer Euler characteristic of the actual native Koszul homology. -/
def seqEuler (f : Fin r → R) (M : Type v) [AddCommGroup M] [Module R M] : ℤ :=
  ∑ n : Fin (r + 1), (-1 : ℤ) ^ (n : ℕ) *
    ((Module.length R ((seqComplexTensor f M).homology (n : ℕ))).toNat : ℤ)

/-- The integer Euler characteristic maps to the native rational multiplicity. -/
theorem cast_seqEuler_eq_hilbertSamuelMultiplicity [IsNoetherianRing R] [IsLocalRing R]
    (f : Fin r → R) (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (hI : IsIdealOfDefinition (Ideal.span (Set.range f))) :
    (seqEuler f M : ℚ) = (Ideal.span (Set.range f)).hilbertSamuelMultiplicity M r := by
  rw [Ideal.hilbertSamuelMultiplicity_eq_alternatingSum_koszulHomology_length
    _ r f M hI rfl]
  simp only [seqEuler, Int.cast_sum, Int.cast_mul, Int.cast_pow, Int.cast_neg,
    Int.cast_one, Int.cast_natCast]

/-- An ideal of definition generated by `r` elements bounds the dimension of
its original ring, without a reducedness or equidimensionality hypothesis. -/
theorem ringKrullDim_le_of_seq_idealOfDefinition [IsNoetherianRing R] [IsLocalRing R]
    (f : Fin r → R) (hI : IsIdealOfDefinition (Ideal.span (Set.range f))) :
    ringKrullDim R ≤ (r : WithBot ℕ∞) := by
  let I := Ideal.span (Set.range f)
  have hrad : I.radical = IsLocalRing.maximalIdeal R := hI
  have hne : I ≠ ⊤ := ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    (Ideal.le_radical.trans hrad.le)
  have hspan : I.spanFinrank ≤ r := by
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range f)).trans ?_
    simpa [← Set.image_univ] using Set.ncard_image_le (f := f) Set.finite_univ
  calc
    ringKrullDim R = ((IsLocalRing.maximalIdeal R).height : WithBot ℕ∞) :=
      IsLocalRing.maximalIdeal_height_eq_ringKrullDim.symm
    _ = ((I.height : ℕ∞) : WithBot ℕ∞) := by
      rw [← hrad, Stacks.KrullDimension.SystemOfParameters.radical_height]
    _ ≤ ((I.spanFinrank : ℕ∞) : WithBot ℕ∞) := by
      exact_mod_cast Ideal.height_le_spanFinrank I hne
    _ ≤ (r : WithBot ℕ∞) := by exact_mod_cast hspan

/-- Native 0AZX and 0AZZ combined, with the signs and coefficients in integers. -/
theorem seqEuler_eq_finsum_dim_eq [IsNoetherianRing R] [IsLocalRing R]
    (f : Fin r → R) (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (hI : IsIdealOfDefinition (Ideal.span (Set.range f))) :
    seqEuler f M =
      ∑ᶠ p : {p : PrimeSpectrum R // ringKrullDim (R ⧸ p.asIdeal) = r},
        ((Module.length (Localization.AtPrime p.1.asIdeal)
          (LocalizedModule p.1.asIdeal.primeCompl M)).toNat : ℤ) *
            seqEuler f (R ⧸ p.1.asIdeal) := by
  apply (Int.cast_injective (α := ℚ))
  change (seqEuler f M : ℚ) = (Int.castAddHom ℚ) _
  rw [(Int.castAddHom ℚ).map_finsum_of_injective Int.cast_injective,
    cast_seqEuler_eq_hilbertSamuelMultiplicity f M hI,
    Ideal.hilbertSamuelMultiplicity_eq_finsum_localizedLength_mul _ hI r
      ((Module.supportDim_le_ringKrullDim R M).trans
        (ringKrullDim_le_of_seq_idealOfDefinition f hI))]
  apply finsum_congr
  intro p
  simp only [Int.coe_castAddHom, Int.cast_mul, Int.cast_natCast,
    cast_seqEuler_eq_hilbertSamuelMultiplicity f (R ⧸ p.1.asIdeal) hI]

/-- Every lower-dimensional coefficient module contributes zero. This follows
from native prime dévissage, not from discarding such modules by convention. -/
theorem seqEuler_eq_zero_of_supportDim_lt [IsNoetherianRing R] [IsLocalRing R]
    (f : Fin r → R) (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (hI : IsIdealOfDefinition (Ideal.span (Set.range f)))
    (hd : Module.supportDim R M < (r : WithBot ℕ∞)) : seqEuler f M = 0 := by
  rw [seqEuler_eq_finsum_dim_eq f M hI]
  apply finsum_eq_zero_of_forall_eq_zero
  intro p
  have hp : p.1 ∉ Module.support R M := by
    intro hp
    have hle := Dualizing.coheight_le_supportDim_of_mem_support hp
    rw [coheight_eq_ringKrullDim_quotient, p.2] at hle
    exact (not_le_of_gt hd) hle
  have hzero : Module.length (Localization.AtPrime p.1.asIdeal)
      (LocalizedModule p.1.asIdeal.primeCompl M) = 0 :=
    Module.length_eq_zero_iff.mpr (Module.notMem_support_iff.mp hp)
  simp only [hzero, ENat.toNat_zero, Nat.cast_zero, zero_mul]

private theorem isMin_of_quotient_dim_eq [IsNoetherianRing R] [IsLocalRing R]
    (f : Fin r → R) (hI : IsIdealOfDefinition (Ideal.span (Set.range f)))
    (p : PrimeSpectrum R) (hp : ringKrullDim (R ⧸ p.asIdeal) = r) : IsMin p := by
  have hd := ringKrullDim_le_of_seq_idealOfDefinition f hI
  have hc : (Order.coheight p : WithBot ℕ∞) = r :=
    (coheight_eq_ringKrullDim_quotient p).trans hp
  have hc' : Order.coheight p = (r : ℕ∞) := WithBot.coe_injective hc
  intro q hqp
  by_contra hpq
  have hlt := Order.coheight_strictAnti
    (lt_of_le_of_ne hqp fun e => hpq e.ge) (by rw [hc']; exact ENat.natCast_lt_top r)
  exact not_lt_of_ge (((Order.coheight_le_krullDim q).trans hd).trans hc.ge)
    (WithBot.coe_lt_coe.mpr hlt)

/-- Integer Euler dévissage over all original minimal primes. Lower-dimensional
components are included with their proved zero contribution; nilpotents remain
in the localized module-length weights. -/
@[stacks 0AZX "integer Koszul Euler formulation using 0AZZ; all original minimal primes"]
theorem seqEuler_eq_finsum_minimalPrimes [IsNoetherianRing R] [IsLocalRing R]
    (f : Fin r → R) (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (hI : IsIdealOfDefinition (Ideal.span (Set.range f))) :
    seqEuler f M = ∑ᶠ p : {p : PrimeSpectrum R // IsMin p},
      ((Module.length (Localization.AtPrime p.1.asIdeal)
        (LocalizedModule p.1.asIdeal.primeCompl M)).toNat : ℤ) *
          seqEuler f (R ⧸ p.1.asIdeal) := by
  classical
  rw [seqEuler_eq_finsum_dim_eq f M hI]
  let a : PrimeSpectrum R → ℤ := fun p =>
    ((Module.length (Localization.AtPrime p.asIdeal)
      (LocalizedModule p.asIdeal.primeCompl M)).toNat : ℤ) * seqEuler f (R ⧸ p.asIdeal)
  change (∑ᶠ p : {p : PrimeSpectrum R // ringKrullDim (R ⧸ p.asIdeal) = r}, a p.1) =
    ∑ᶠ p : {p : PrimeSpectrum R // IsMin p}, a p.1
  rw [finsum_subtype_eq_finsum_cond (f := a),
    finsum_subtype_eq_finsum_cond (f := a)]
  apply finsum_congr
  intro p
  dsimp only [a]
  by_cases hp : ringKrullDim (R ⧸ p.asIdeal) = r
  · simp only [hp, isMin_of_quotient_dim_eq f hI p hp, finsum_true]
  · have hdim : Module.supportDim R (R ⧸ p.asIdeal) < (r : WithBot ℕ∞) := by
      rw [Module.supportDim_quotient_eq_ringKrullDim]
      exact lt_of_le_of_ne
        ((coheight_eq_ringKrullDim_quotient p).symm.trans_le
          ((Order.coheight_le_krullDim p).trans
            (ringKrullDim_le_of_seq_idealOfDefinition f hI))) hp
    have hz := seqEuler_eq_zero_of_supportDim_lt f (R ⧸ p.asIdeal) hI hdim
    simp only [hz, mul_zero, finsum_zero]

/-- Apply generic Euler dévissage degreewise before taking a finite signed sum.
The coefficient is the signed alternating localized length of the supplied
actual modules, not the length of the incidence ring. -/
theorem sum_signed_seqEuler_eq_finsum_minimalPrimes [IsNoetherianRing R] [IsLocalRing R]
    (f : Fin r → R) (M : ℕ → Type v) [∀ j, AddCommGroup (M j)] [∀ j, Module R (M j)]
    [∀ j, Module.Finite R (M j)]
    (hI : IsIdealOfDefinition (Ideal.span (Set.range f))) (s : Finset ℕ) :
    ∑ j ∈ s, (-1 : ℤ) ^ j * seqEuler f (M j) =
      ∑ᶠ p : {p : PrimeSpectrum R // IsMin p},
        (∑ j ∈ s, (-1 : ℤ) ^ j *
          ((Module.length (Localization.AtPrime p.1.asIdeal)
            (LocalizedModule p.1.asIdeal.primeCompl (M j))).toNat : ℤ)) *
              seqEuler f (R ⧸ p.1.asIdeal) := by
  classical
  let P := {p : PrimeSpectrum R // IsMin p}
  let : Fintype P := (PrimeSpectrum.finite_setOfPred_isMin R).fintype
  let w : ℕ → P → ℤ := fun j p =>
    ((Module.length (Localization.AtPrime p.1.asIdeal)
      (LocalizedModule p.1.asIdeal.primeCompl (M j))).toNat : ℤ)
  let e : P → ℤ := fun p => seqEuler f (R ⧸ p.1.asIdeal)
  change (∑ j ∈ s, (-1 : ℤ) ^ j * seqEuler f (M j)) =
    ∑ᶠ p : P, (∑ j ∈ s, (-1 : ℤ) ^ j * w j p) * e p
  calc
    _ = ∑ j ∈ s, ∑ p : P, ((-1 : ℤ) ^ j * w j p) * e p := by
      apply Finset.sum_congr rfl
      intro j _
      have hj : seqEuler f (M j) = ∑ p : P, w j p * e p :=
        (seqEuler_eq_finsum_minimalPrimes f (M j) hI).trans
          (finsum_eq_sum_of_fintype (fun p : P => w j p * e p))
      rw [hj, Finset.mul_sum]
      exact Finset.sum_congr rfl fun p _ => (mul_assoc _ _ _).symm
    _ = ∑ p : P, (∑ j ∈ s, (-1 : ℤ) ^ j * w j p) * e p := by
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun p _ => (Finset.sum_mul _ _ _).symm
    _ = _ := (finsum_eq_sum_of_fintype
      (fun p : P => (∑ j ∈ s, (-1 : ℤ) ^ j * w j p) * e p)).symm

end Koszul
